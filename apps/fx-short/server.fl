;; fx-short: URL 단축기 API (포트 40309)

(load "/home/kimjin/freelang-v11-fx/fx-std.fl")

(define PORT     40309)
(define BASE_URL "http://localhost:40309")
(define DB_PATH  "/home/kimjin/freelang-v11-fx/apps/fx-short/short.db")

(define db (fxb_sqlite_open DB_PATH))

;; ── DB 초기화 ──

(fxb_sqlite_exec db
  "CREATE TABLE IF NOT EXISTS urls (
    id      INTEGER PRIMARY KEY AUTOINCREMENT,
    code    TEXT    UNIQUE NOT NULL,
    url     TEXT    NOT NULL,
    api_key TEXT    NOT NULL,
    clicks  INTEGER DEFAULT 0,
    created TEXT    NOT NULL
  )")

;; ── 코드 생성 ──

(defn gen-code [$url]
  ;; sha256 사용 — URL 앞부분이 같아도 고유 코드 생성
  (let [[$raw  (str $url "|" (now-str))]
        [$hash (sha256 $raw)]]
    (str-slice $hash 0 8)))

;; ── POST /shorten ──

(defn handle-shorten [$req]
  (let [[$url     (get (req-body $req) "url")]
        [$api-key (bearer-token $req)]]
    (if (blank? $url)
      (err "url 필수")
      (if (not (or (str-starts-with $url "http://") (str-starts-with $url "https://")))
        (err (str "유효하지 않은 URL: " $url))
        (if (null? $api-key)
          (err-unauthorized)
          (let [[$code    (gen-code $url)]
                [$created (now-str)]]
            (fxb_sqlite_exec_p db
              "INSERT OR IGNORE INTO urls (code, url, api_key, created) VALUES (?, ?, ?, ?)"
              (list $code $url $api-key $created))
            (ok {"code"    $code
                 "short"   (format "%s/%s" [BASE_URL $code])
                 "url"     $url
                 "created" $created})))))))

;; ── GET /:code (리다이렉트) ──

(defn handle-redirect [$req]
  (let [[$code (req-param $req "code")]
        [$rows (fxb_sqlite_query_p db
                  "SELECT url FROM urls WHERE code=?" (list $code))]]
    (if (= (length $rows) 0)
      (err-not-found)
      (let [[$url (get (get $rows 0) "url")]]
        (fxb_sqlite_exec_p db
          "UPDATE urls SET clicks=clicks+1 WHERE code=?" (list $code))
        (server_html (str "<meta http-equiv='refresh' content='0;url=" $url "'>"))))))

;; ── GET /stats ──

(defn handle-stats [$req]
  (let [[$api-key (bearer-token $req)]]
    (if (null? $api-key)
      (err-unauthorized)
      (let [[$rows   (fxb_sqlite_query_p db
                        "SELECT code, url, clicks, created FROM urls WHERE api_key=? ORDER BY clicks DESC"
                        (list $api-key))]
            [$total  (reduce (fn [$acc $r] (+ $acc (or (get $r "clicks") 0))) 0 $rows)]
            [$public (map (fn [$r] (select-keys $r ["code" "url" "clicks" "created"])) $rows)]]
        (ok-list $public $total)))))

;; ── POST /delete ──

(defn handle-delete [$req]
  (let [[$body    (req-body $req)]
        [$code    (get $body "code")]
        [$api-key (bearer-token $req)]]
    (if (or (blank? $code) (null? $api-key))
      (err "code + Authorization 필수")
      (do
        (fxb_sqlite_exec_p db
          "DELETE FROM urls WHERE code=? AND api_key=?" (list $code $api-key))
        (ok {"deleted" $code})))))

;; ── GET /health ──

(defn handle-health [$req]
  (ok {"status" "ok" "app" "fx-short" "port" PORT}))

;; ── 라우터 ──

(server_get  "/health"  "handle-health")
(server_post "/shorten" "handle-shorten")
(server_get  "/stats"   "handle-stats")
(server_post "/delete"  "handle-delete")
(server_get  "/:code"   "handle-redirect")

(log-info (str "fx-short 시작 — 포트 " PORT))
(server_start PORT)
