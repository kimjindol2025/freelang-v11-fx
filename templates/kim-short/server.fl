;; kim-short — FreeLang 네이티브 URL 단축기
;; SQLite 기반, Node.js 없음, 순수 C 바이너리
;; 빌드: ../../fl-build.sh server.fl kim-short
;; 실행: ./kim-short

(define PORT (num (or (env-get "PORT") "40920")))
(define DB_PATH (or (env-get "DB_PATH") "links.db"))
(define BASE_URL (or (env-get "BASE_URL") (str "http://localhost:" PORT)))

;; ── DB 초기화 ────────────────────────────────────────────────────
(define db (sqlite_open DB_PATH))

(sqlite_exec db
  "CREATE TABLE IF NOT EXISTS links (
    id        INTEGER PRIMARY KEY AUTOINCREMENT,
    code      TEXT UNIQUE NOT NULL,
    url       TEXT NOT NULL,
    title     TEXT DEFAULT '',
    clicks    INTEGER DEFAULT 0,
    created_at TEXT DEFAULT (datetime('now','localtime'))
  )")

(sqlite_exec db
  "CREATE INDEX IF NOT EXISTS idx_code ON links(code)")

;; ── 코드 생성 (6자 영숫자) ────────────────────────────────────────
(define CHARS "abcdefghijklmnopqrstuvwxyz0123456789")

(defn rand-char []
  (let [$idx (math_floor (* (math_random) 36))]
    (str-slice CHARS $idx (+ $idx 1))))

(defn rand-code []
  (str (rand-char) (rand-char) (rand-char)
       (rand-char) (rand-char) (rand-char)))

;; ── HTML 헬퍼 ────────────────────────────────────────────────────
(defn html-page [$title $body]
  (str "<!DOCTYPE html>
<html lang='ko'>
<head>
<meta charset='utf-8'>
<meta name='viewport' content='width=device-width,initial-scale=1'>
<title>" $title " — KimShort</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
     background:#0a0e1a;color:#e2e8f0;min-height:100vh}
.nav{background:#111827;padding:14px 24px;border-bottom:1px solid #1e2d3d;
     display:flex;align-items:center;gap:16px}
.nav h1{font-size:1.15rem;color:#38bdf8;font-weight:800;letter-spacing:-0.5px}
.nav span{font-size:.78rem;color:#374151;margin-left:auto}
.container{max-width:740px;margin:0 auto;padding:32px 20px}
.hero{text-align:center;margin-bottom:36px}
.hero h2{font-size:1.8rem;font-weight:800;color:#f1f5f9;margin-bottom:8px}
.hero p{color:#64748b;font-size:.95rem}
.card{background:#111827;border:1px solid #1e293b;border-radius:12px;padding:24px;margin-bottom:20px}
.card h3{font-size:.95rem;font-weight:600;color:#94a3b8;margin-bottom:14px;text-transform:uppercase;letter-spacing:.05em}
input[type=url],input[type=text]{width:100%;padding:11px 14px;
  background:#0d1117;border:1px solid #1e293b;border-radius:8px;
  color:#e2e8f0;font-size:.95rem;outline:none;transition:border .15s}
input[type=url]:focus,input[type=text]:focus{border-color:#38bdf8}
.row{display:flex;gap:10px;margin-top:14px}
.btn{background:#0ea5e9;color:#fff;border:none;padding:11px 22px;
     border-radius:8px;cursor:pointer;font-size:.9rem;font-weight:600;
     white-space:nowrap;transition:background .15s}
.btn:hover{background:#0284c7}
.btn-ghost{background:transparent;border:1px solid #1e293b;color:#64748b}
.btn-ghost:hover{border-color:#38bdf8;color:#38bdf8}
.result-box{background:#0d1117;border:1px solid #1e293b;border-radius:8px;
  padding:14px 16px;margin-top:16px;display:flex;align-items:center;gap:12px}
.result-box .short-url{color:#38bdf8;font-size:1.05rem;font-weight:600;
  flex:1;word-break:break-all}
.copy-btn{background:#1e293b;color:#94a3b8;border:none;padding:6px 12px;
  border-radius:6px;cursor:pointer;font-size:.8rem}
.copy-btn:hover{background:#38bdf8;color:#fff}
table{width:100%;border-collapse:collapse;font-size:.88rem}
th{text-align:left;padding:8px 12px;color:#475569;border-bottom:1px solid #1e293b;font-weight:500}
td{padding:10px 12px;border-bottom:1px solid #111827;vertical-align:middle}
td a{color:#38bdf8;text-decoration:none}
td a:hover{text-decoration:underline}
.code-badge{background:#0d1117;border:1px solid #1e293b;border-radius:5px;
  padding:3px 8px;font-family:monospace;font-size:.82rem;color:#a3e635}
.clicks{color:#64748b;font-size:.82rem}
.delete-btn{background:transparent;border:none;color:#ef4444;cursor:pointer;
  font-size:.85rem;padding:4px 8px;border-radius:4px}
.delete-btn:hover{background:#7f1d1d}
.empty{text-align:center;padding:32px;color:#374151;font-size:.9rem}
.tag{background:#1e293b;color:#64748b;font-size:.72rem;padding:2px 7px;border-radius:4px}
</style>
</head>
<body>
<nav class='nav'>
  <h1>🔗 KimShort</h1>
  <a href='/' style='color:#64748b;text-decoration:none;font-size:.85rem'>홈</a>
  <a href='/links' style='color:#64748b;text-decoration:none;font-size:.85rem'>목록</a>
  <span>Node.js 없음 · C 런타임 · SQLite</span>
</nav>
<div class='container'>
" $body "
</div>
<script>
function copyText(text) {
  navigator.clipboard.writeText(text).then(function() {
    var el = event.target;
    var orig = el.textContent;
    el.textContent = '복사됨!';
    el.style.background = '#16a34a';
    setTimeout(function() { el.textContent = orig; el.style.background = ''; }, 1500);
  });
}
</script>
</body>
</html>"))

;; ── 핸들러 ──────────────────────────────────────────────────────

;; GET / — 메인 페이지
(defn handle-index [$req]
  (let [$body "<div class='hero'>
  <h2>URL을 짧게</h2>
  <p>긴 URL을 단축 링크로 만들어 공유하세요</p>
</div>
<div class='card'>
  <h3>단축 URL 만들기</h3>
  <form method='POST' action='/shorten'>
    <input type='url' name='url' placeholder='https://example.com/very/long/path/...' required>
    <input type='text' name='title' placeholder='제목 (선택)' style='margin-top:10px'>
    <div class='row'>
      <button class='btn' type='submit'>단축하기</button>
    </div>
  </form>
</div>"]
    (server_html (html-page "URL 단축기" $body))))

;; POST /shorten — URL 단축
(defn handle-shorten [$req]
  (let [$body  (form_parse (server_req_body $req))
        $url   (or (get $body "url") "")
        $title (or (get $body "title") "")
        $code  (rand-code)
        $r     (sqlite_exec_p db
                  "INSERT OR IGNORE INTO links (code, url, title) VALUES (?, ?, ?)"
                  (list $code $url $title))
        $link (str BASE_URL "/" $code)
        $body2 (str "<div class='hero'><h2>✅ 단축 완료</h2></div>
<div class='card'>
  <h3>단축 URL</h3>
  <p style='color:#64748b;font-size:.85rem;margin-bottom:10px'>원본: " $url "</p>
  <div class='result-box'>
    <span class='short-url'>" $link "</span>
    <button class='copy-btn' onclick=\"copyText('" $link "')\">복사</button>
  </div>
  <div class='row' style='margin-top:14px'>
    <a href='/' class='btn btn-ghost' style='text-decoration:none'>새 단축</a>
    <a href='/links' class='btn btn-ghost' style='text-decoration:none'>목록 보기</a>
  </div>
</div>")]
    (server_html (html-page "단축 완료" $body2))))

;; GET /links — 목록
(defn handle-links [$req]
  (let [$rows  (sqlite_query db "SELECT code, url, title, clicks, created_at FROM links ORDER BY id DESC LIMIT 100")
        $count (length $rows)
        $items (if (> $count 0)
          (reduce
            (fn [$acc $r]
              (let [$code  (get $r "code")
                    $url   (get $r "url")
                    $title (get $r "title")
                    $link (str BASE_URL "/" $code)
                    $clicks (get $r "clicks")
                    $dt    (get $r "created_at")]
                (str $acc
                  "<tr>"
                  "<td><span class='code-badge'>" $code "</span></td>"
                  "<td><a href='" $url "' target='_blank'>"
                    (if (> (length $title) 0) $title $url)
                  "</a></td>"
                  "<td><a href='" $link "' style='color:#a3e635;font-size:.82rem'>" $link "</a></td>"
                  "<td class='clicks'>" $clicks "회</td>"
                  "<td>"
                    "<form method='POST' action='/delete/" $code "' style='display:inline'>"
                    "<button class='delete-btn' type='submit'>삭제</button>"
                    "</form>"
                  "</td>"
                  "</tr>")))
            "" $rows)
          "<tr><td colspan='5' class='empty'>아직 단축 URL이 없습니다</td></tr>")
        $body (str
          "<div style='display:flex;align-items:center;justify-content:space-between;margin-bottom:20px'>
            <h2 style='font-size:1.1rem;color:#f1f5f9'>단축 URL 목록 (" $count "개)</h2>
            <a href='/' class='btn' style='text-decoration:none;font-size:.85rem'>+ 새 단축</a>
          </div>
          <div class='card' style='padding:0;overflow:hidden'>
          <table>
            <thead><tr><th>코드</th><th>URL</th><th>단축 링크</th><th>클릭</th><th></th></tr></thead>
            <tbody>" $items "</tbody>
          </table>
          </div>")]
    (server_html (html-page "목록" $body))))

;; GET /:code — 리다이렉트
(defn handle-redirect [$req]
  (let [$code (server_req_param $req "code")
        $row  (sqlite_one_p db
                 "SELECT url FROM links WHERE code=?"
                 (list $code))]
    (if $row
      (let [$url (get $row "url")]
        (sqlite_exec_p db
          "UPDATE links SET clicks=clicks+1 WHERE code=?"
          (list $code))
        (server_redirect $url))
      (server_status 404 "Not Found"))))

;; POST /delete/:code — 삭제
(defn handle-delete [$req]
  (let [$code (server_req_param $req "code")]
    (sqlite_exec_p db
      "DELETE FROM links WHERE code=?"
      (list $code))
    (server_redirect "/links")))

;; GET /api/links — JSON API
(defn handle-api [$req]
  (let [$rows (sqlite_query db "SELECT * FROM links ORDER BY id DESC")]
    (server_json (json_stringify $rows))))

;; GET /health
(defn handle-health [$req]
  (server_json "{\"status\":\"ok\",\"app\":\"kim-short\",\"runtime\":\"native-c\"}"))

;; ── 라우트 ──────────────────────────────────────────────────────
(server_get  "/"           "handle-index")
(server_post "/shorten"    "handle-shorten")
(server_get  "/links"      "handle-links")
(server_get  "/api/links"  "handle-api")
(server_get  "/health"     "handle-health")
(server_post "/delete/:code" "handle-delete")
(server_get  "/:code"     "handle-redirect")

;; ── 시작 ────────────────────────────────────────────────────────
(server_start PORT)
