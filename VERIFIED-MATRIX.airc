;; ============================================================
;; VERIFIED-MATRIX.airc
;; FreeLang stdlib 검증 매트릭스 — 단일 진실 공급원
;;
;; 원칙: claimed ≠ observed.
;;   VERIFIED = 실측 실행 증거 (v11 + cgc ≥ 2개 조건)
;;   PARTIAL  = 1개 조건 또는 일부 기능만
;;   BROKEN   = 실행 시 오류 (문서와 달리 동작 안 함)
;;   CLAIMED  = 코드/문서에 존재하나 실측 증거 없음
;;
;; 상태 전이 규칙:
;;   VERIFIED → CLAIMED 금지 (퇴행 불가)
;;   BROKEN   → VERIFIED 직접 승격 금지 (PARTIAL 경유 권장)
;;   승격 = Evidence 첨부 필수 (실행 로그 / 출력 / 재현 코드)
;; ============================================================

@meta
  version: 1
  created: 2026-06-21
  updated: 2026-06-21
  source_of_truth: true
  canonical_detail: verified-stdlib.md
  trap_ref: FX-TRAPS.airc
  success_criteria:
    - CLAIMED=0
    - VERIFIED >= 80% (현재 29%)
    - Evidence 재현 가능
    - FX-TRAPS 연동 (실패 발견 → 트랩 등록)

;; ─────────────────── STDLIB 검증 현황 ───────────────────

@entry
  id: retry
  file: stdlib/retry.fl
  status: VERIFIED
  v11: VERIFIED
  cgc: VERIFIED
  service: NONE
  verified_at: 2026-06-20/21
  evidence:
    v11: "retry-result max-tries=5 성공·retry-safe fallback·-int-pow 2^3=8 정상"
    cgc: "빌드 성공(hash_map shim fd7a57b) 출력: true/success!/fallback/1/2/8"
  traps:
    - trap-try-map-literal (v11 파싱 오류 → hash-map 대체)
    - trap-nested-defn-skip (cgc 중첩 defn → 최상위 분리)
    - trap-defn-throw-rerun (-retry-core throw-free 설계로 우회)
  runtime_changes:
    - fx-builtin-shim.c: throw shim 추가 (2c98a8a)
    - fx-builtin-shim.c: hash_map shim 추가 (fd7a57b)
    - runtime.h: extern FLValue throw/hash_map 선언

@entry
