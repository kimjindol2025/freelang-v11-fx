  file: stdlib/queue.fl
  status: VERIFIED
  v11: VERIFIED
  cgc: VERIFIED
  service: NONE
  verified_at: 2026-06-20
  evidence:
    v11: "queue/stack 전 함수 실측. push/pop/peek/size/empty?/->list 정상"
    cgc: "빌드 성공. queue FIFO·stack LIFO 정확. 3항목 push→pop 순서 검증"
