(defn jcore-http-release [state]
  (j-host-set! state 0 true)
  (j-host-timer-clear (j-host-at state 1))
  (j-host-timer-clear (j-host-at state 3))
  (j-host-set! state 1 nil)
  (j-host-set! state 2 nil)
  (j-host-set! state 3 nil)
  (j-host-set! state 4 nil))
(defn jcore-cancel [args]
  (if (j-host-not (j-host-eq (j-host-len args) 1))
    (throw "browser-cancel!: one task handle required") nil)
  (let [token (j-host-at args 0)]
    (if (j-host-weak-has jcore-timers token)
      (let [record (j-host-weak-get jcore-timers token)]
        (if (j-host-at record 0)
          (do (j-host-timer-clear (j-host-at record 2))
              (j-host-set! record 0 false)
              (j-host-set! record 1 nil)
              (j-host-set! record 2 nil) true) false))
      (if (j-host-weak-has jcore-requests token)
        (let [state (j-host-weak-get jcore-requests token)]
          (if (j-host-at state 0) false
            (let [controller (j-host-at state 4)]
              (do (jcore-http-release state) (j-host-abort controller) true))))
        (throw "browser-cancel!: one task handle required")))))

(defn jcore-event-name? [name]
  (j-host-or (j-host-eq name "input")
    (j-host-or (j-host-eq name "change")
      (j-host-or (j-host-eq name "click")
        (j-host-or (j-host-eq name "keydown")
          (j-host-or (j-host-eq name "beforeinput")
            (j-host-or (j-host-eq name "compositionstart")
              (j-host-or (j-host-eq name "compositionend")
                (j-host-or (j-host-eq name "paste")
                  (j-host-or (j-host-eq name "focus") (j-host-eq name "blur")))))))))))
(defn jcore-on [args]
  (let [element (j-host-at args 0) name (j-host-at args 1) callback (j-host-at args 2)]
    (if (j-host-and (j-host-eq (j-host-len args) 3)
          (j-host-and (j-host-element? element)
            (j-host-and (jcore-event-name? name) (j-host-eq (j-host-type callback) "function"))))
      (let [token [] listener (fn [event] (callback event))]
        (do (j-host-dom-on! element name listener)
            (j-host-weak-set! jcore-listeners token [element name listener true]) token))
      (throw "browser-on!: element, allowed event name and function required"))))
(defn jcore-off [args]
  (let [token (j-host-at args 0)]
    (if (j-host-and (j-host-eq (j-host-len args) 1) (j-host-weak-has jcore-listeners token))
      (let [record (j-host-weak-get jcore-listeners token)]
        (if (j-host-at record 3)
          (do (j-host-dom-off! (j-host-at record 0) (j-host-at record 1) (j-host-at record 2))
              (j-host-set! record 3 false) nil) nil))
      (throw "browser-off!: one listener token required"))))
(defn jcore-event [args]
  (let [event (j-host-at args 0)]
    (if (j-host-and (j-host-eq (j-host-len args) 1) (j-host-event? event)) event
      (throw "browser event: one Event required"))))
(defn jcore-event-target [args]
  (let [target (j-host-at (jcore-event args) "target")]
    (if (j-host-element? target) target nil)))
(defn jcore-event-key [args]
  (let [event (jcore-event args)]
    (if (j-host-keyboard? event) (j-host-at event "key") nil)))
(defn jcore-prevent-default [args]
  (do (j-host-prevent-default! (jcore-event args)) nil))

(define jcore-tags {"div" true "section" true "article" true "p" true "span" true
  "strong" true "em" true "u" true "s" true "blockquote" true "pre" true "code" true
  "h2" true "h3" true "ul" true "ol" true "li" true "hr" true "br" true "a" true
  "img" true "figure" true "figcaption" true "label" true "button" true "input" true "textarea" true})
(define jcore-attributes {"id" true "class" true "title" true "alt" true "width" true
  "height" true "role" true "aria-label" true "aria-expanded" true "tabindex" true
  "contenteditable" true "type" true "accept" true "data-block-id" true "href" true "src" true})
(defn jcore-attribute-name? [name]
  (j-host-and (j-host-eq (j-host-type name) "string") (j-host-own? jcore-attributes name)))
(defn jcore-element-args? [args count]
  (if (j-host-eq (j-host-len args) count)
    (loop [index 0]
      (if (j-host-lt index count)
        (if (j-host-element? (j-host-at args index)) (recur (j-host-add index 1)) false) true)) false))
(defn jcore-create [args]
  (let [tag (j-host-at args 0)]
    (if (j-host-and (j-host-eq (j-host-len args) 1)
          (j-host-and (j-host-eq (j-host-type tag) "string") (j-host-own? jcore-tags tag)))
      (j-host-dom-create tag) (throw "browser-create: one allowed tag required"))))
(defn jcore-dom-append [args]
  (if (jcore-element-args? args 2)
    (do (j-host-dom-append! (j-host-at args 0) (j-host-at args 1)) nil)
    (throw "browser-append!: two elements required")))
(defn jcore-dom-before [args]
  (let [parent (j-host-at args 0) child (j-host-at args 1) before (j-host-at args 2)]
    (if (j-host-and (j-host-eq (j-host-len args) 3)
          (j-host-and (j-host-and (j-host-element? parent) (j-host-element? child))
            (j-host-or (j-host-nullish? before) (j-host-element? before))))
      (do (j-host-dom-before! parent child before) nil)
      (throw "browser-insert-before!: parent, child and element or nil required"))))
(defn jcore-dom-remove [args]
  (if (jcore-element-args? args 1) (do (j-host-dom-remove! (j-host-at args 0)) nil)
    (throw "browser-remove!: one element required")))
(defn jcore-dom-clear [args]
  (if (jcore-element-args? args 1) (do (j-host-dom-clear! (j-host-at args 0)) nil)
    (throw "browser-clear!: one element required")))
(defn jcore-dom-children [args]
  (if (jcore-element-args? args 1) (j-host-array-from (j-host-at (j-host-at args 0) "children"))
    (throw "browser-children: one element required")))
(defn jcore-dom-attribute [args]
  (let [element (j-host-at args 0) name (j-host-at args 1)]
    (if (j-host-and (j-host-eq (j-host-len args) 2)
          (j-host-and (j-host-element? element)
            (j-host-or (jcore-attribute-name? name) (j-host-eq name "hidden"))))
      (j-host-dom-attribute element name) (throw "browser-attribute: element and allowed attribute required"))))
(defn jcore-dom-url [element name value]
  (if (j-host-or (j-host-eq name "href") (j-host-eq name "src"))
    (if (j-host-eq (j-host-at element "tagName") (if (j-host-eq name "src") "IMG" "A"))
      (let [url (j-host-url value) protocol (j-host-at url "protocol")]
        (if (j-host-and (j-host-or (j-host-eq protocol "http:") (j-host-eq protocol "https:"))
              (j-host-or (j-host-eq name "href") (j-host-eq (j-host-at url "origin") (j-host-origin))))
          (j-host-at url "href") (throw "browser URL: protocol or image origin rejected")))
      (throw "browser URL: attribute requires its link or image element")) value))
(defn jcore-dom-set-attribute [args]
  (let [element (j-host-at args 0) name (j-host-at args 1) value (j-host-at args 2)]
    (if (j-host-and (j-host-eq (j-host-len args) 3)
          (j-host-and (j-host-element? element)
            (j-host-and (jcore-attribute-name? name) (j-host-eq (j-host-type value) "string"))))
      (let [safe-value (jcore-dom-url element name value)]
        (do (j-host-dom-set-attribute! element name safe-value) nil))
      (throw "browser-set-attribute!: element, allowed attribute and string required"))))
(defn jcore-dom-hidden [args]
  (let [element (j-host-at args 0) hidden (j-host-at args 1)]
    (if (j-host-and (j-host-eq (j-host-len args) 2)
          (j-host-and (j-host-element? element) (j-host-eq (j-host-type hidden) "boolean")))
      (do (j-host-set! element "hidden" hidden) nil)
      (throw "browser-set-hidden!: element and boolean required"))))
(defn jcore-dom-focus [args]
  (if (jcore-element-args? args 1) (do (j-host-dom-focus! (j-host-at args 0)) nil)
    (throw "browser-focus!: one element required")))

;; HTTP owns completion until the entire response body has arrived.
(defn jcore-json-parse [args]
  (if (j-host-and (j-host-eq (j-host-len args) 1)
        (j-host-eq (j-host-type (j-host-at args 0)) "string"))
    (j-host-json-parse (j-host-at args 0))
    (throw "browser-json-parse: one string required")))
(defn jcore-http [args]
  (let [url (j-host-at args 0) options (j-host-at args 1) callback (j-host-at args 2)]
    (if (j-host-not (j-host-and (j-host-eq (j-host-len args) 3)
          (j-host-and (j-host-eq (j-host-type url) "string")
            (j-host-and (j-host-not (j-host-nullish? options))
              (j-host-and (j-host-eq (j-host-type options) "object")
                (j-host-and (j-host-plain? options) (j-host-eq (j-host-type callback) "function")))))))
      (throw "browser-http!: URL, options map and callback required") nil)
    (let [method (j-host-at options "method") body (j-host-at options "body")
          delay (j-host-at options "timeout") parsed (j-host-url url)]
      (if (j-host-not (j-host-and
            (j-host-or (j-host-eq (j-host-at parsed "protocol") "http:")
                      (j-host-eq (j-host-at parsed "protocol") "https:"))
            (j-host-and (j-host-eq (j-host-at parsed "username") "")
              (j-host-eq (j-host-at parsed "password") ""))))
        (throw "browser-http!: HTTP(S) URL without credentials required") nil)
      (if (j-host-not (j-host-and
            (j-host-or (j-host-eq method "GET") (j-host-eq method "POST"))
            (j-host-and (j-host-eq (j-host-type body) "string")
              (j-host-and (j-host-or (j-host-eq method "POST") (j-host-eq body ""))
                (j-host-and (j-host-integer? delay)
                  (j-host-and (j-host-gte delay 1) (j-host-lt delay 2147483648)))))))
        (throw "browser-http!: GET/POST, string body and integer timeout 1..2147483647 required") nil)
      (let [token [] state [false nil callback nil (j-host-abort-new)]
            finish (fn [result]
              (if (j-host-at state 0) nil
                (let [deliver (j-host-at state 2)]
                  (do (jcore-http-release state)
                      (j-host-call deliver [result])))))
            failed (fn [error] (finish {"ok" false "status" 0 "body" "" "error" "network"}))]
        (j-host-weak-set! jcore-requests token state)
        (j-host-set! state 1 (j-host-timer-set (fn []
          (if (j-host-at state 0) nil
            (do (j-host-abort (j-host-at state 4))
                (finish {"ok" false "status" 0 "body" "" "error" "timeout"})))) delay))
        (j-host-set! state 3 (j-host-timer-set (fn []
          (if (j-host-at state 0) nil
            (do
              (j-host-set! state 3 nil)
              (try
                (j-host-then
                  (j-host-fetch (j-host-at parsed "href")
                    {"method" method "body" (if (j-host-eq method "GET") nil body)
                     "signal" (j-host-at (j-host-at state 4) "signal")})
                  (fn [response]
                    (j-host-then (j-host-response-text response)
                      (fn [text]
                        (finish {"ok" (j-host-at response "ok") "status" (j-host-at response "status")
                          "body" text "error" (if (j-host-at response "ok") nil "http")})) failed))
                  failed)
                (catch error (failed error)))))) 0))
        token))))

;; Island DOM boundary. The existing restricted browser-* APIs retain their
;; contracts; the frontend's h form has a separate, explicit HTML surface.
(define jcore-island-tags
  {"aside" true "header" true "footer" true "main" true "nav" true "form" true
   "h1" true "h4" true "h5" true "h6" true "style" true "small" true "b" true "i" true
   "table" true "thead" true "tbody" true "tfoot" true "tr" true "td" true "th" true
   "select" true "option" true "fieldset" true "legend" true "details" true "summary" true})
(define jcore-island-attributes
  {"for" true "name" true "value" true "placeholder" true "autocomplete" true "inputmode" true
   "loading" true "maxlength" true "minlength" true "min" true "max" true "step" true
   "pattern" true "required" true "disabled" true "readonly" true "multiple" true "selected" true
   "checked" true "style" true "target" true "rel" true "download" true "method" true
   "action" true "rows" true "cols" true "colspan" true "rowspan" true "scope" true})

(defn jcore-island-attribute? [name]
  (if (j-host-not (j-host-eq (j-host-type name) "string")) false
    (if (j-host-or (j-host-own? jcore-attributes name) (j-host-own? jcore-island-attributes name)) true
      (if (j-host-and
            (j-host-or (j-host-eq (j-host-substring name 0 5) "data-")
                       (j-host-eq (j-host-substring name 0 5) "aria-"))
            (j-host-lt 5 (j-host-len name)))
        (loop [index 5]
          (if (j-host-lt index (j-host-len name))
            (let [char (j-host-at name index)]
              (if (j-host-or
                    (j-host-or (j-host-and (j-host-gte char "a") (j-host-gte "z" char))
                               (j-host-and (j-host-gte char "0") (j-host-gte "9" char)))
                    (j-host-eq char "-"))
                (recur (j-host-add index 1)) false)) true)) false))))

(defn jcore-island-append [parent child]
  (if (j-host-nullish? child) nil
    (if (j-host-array? child)
      (loop [index 0]
        (if (j-host-lt index (j-host-len child))
          (do (jcore-island-append parent (j-host-at child index))
              (recur (j-host-add index 1))) nil))
      (if (j-host-element? child) (do (j-host-dom-append! parent child) nil)
        (let [text (jcore-string child)]
          (if (j-host-eq text "") nil
            (do (j-host-dom-append! parent (j-host-dom-text text)) nil)))))))

(defn jcore-island-h [args]
  (let [tag (j-host-at args 0) attributes (j-host-at args 1) children (j-host-at args 2)]
    (if (j-host-not
          (j-host-and (j-host-eq (j-host-len args) 3)
            (j-host-and (j-host-eq (j-host-type tag) "string")
              (j-host-and (j-host-or (j-host-own? jcore-tags tag) (j-host-own? jcore-island-tags tag))
                (j-host-and
                  (j-host-or (j-host-nullish? attributes)
                    (j-host-and (j-host-eq (j-host-type attributes) "object") (j-host-plain? attributes)))
                  (j-host-array? children))))))
      (throw "island-h: allowed tag, attribute map and child array required") nil)
    (let [element (j-host-dom-create tag)
          names (if (j-host-nullish? attributes) [] (j-host-keys attributes))]
      (loop [index 0]
        (if (j-host-lt index (j-host-len names))
          (let [original (j-host-at names index) key (jcore-key original)
                value (j-host-at attributes original)]
            (do
              (if (j-host-eq key "checked")
                (if (j-host-and value (j-host-not (j-host-eq value "")))
                  (j-host-set! element "checked" true) nil)
                (if (j-host-eq (j-host-substring key 0 3) "on-")
                  (jcore-on [element (j-host-substring key 3 (j-host-len key)) value])
                  (if (jcore-island-attribute? key)
                    (if (j-host-or (j-host-nullish? value) (j-host-eq value "")) nil
                      (j-host-dom-set-attribute! element key
                        (jcore-dom-url element key (jcore-string value))))
                    (throw "island-h: attribute rejected"))))
              (recur (j-host-add index 1)))) nil))
      (jcore-island-append element children)
      element)))

(defn jcore-island-update [root render state]
  (if (j-host-at state 0) (do (j-host-set! state 1 true) nil)
    (do
      (j-host-set! state 0 true)
      (try
        (loop []
          (j-host-set! state 1 false)
          (let [result (render (j-host-at state 2))]
            (j-host-dom-clear! root)
            (jcore-island-append root result)
            (if (j-host-at state 1) (recur) nil)))
        (catch error
          (let [message (if (j-host-and (j-host-not (j-host-nullish? error))
                           (j-host-eq (j-host-type (j-host-at error "message")) "string"))
                          (j-host-at error "message") (j-host-string error))]
            (jcore-island-dev-report {"type" "island" "message" message
                                      "source" (j-host-at root "id") "phase" "render"})
            (j-host-console-error (j-host-add "[Island Error] " message))
            (j-host-dom-set-text! root (j-host-add "[Island Error] " message))
            (j-host-dom-set-attribute! root "data-island-error" "true")))
        (finally (j-host-set! state 0 false))))))

(defn jcore-island-mount [args]
  (let [id (j-host-at args 0) render (j-host-at args 1)]
    (if (j-host-not (j-host-and (j-host-eq (j-host-len args) 2)
          (j-host-and (j-host-eq (j-host-type id) "string")
                      (j-host-eq (j-host-type render) "function"))))
      (throw "island-mount: id and render function required") nil)
    (let [root (j-host-dom-by-id id)]
      (if (j-host-nullish? root) nil
        (let [state [false false nil]
              update (fn [] (jcore-island-update root render state))]
          (do (j-host-set! state 2 update) (update) update))))))

;; Shared island state and subscriptions retain the browser store contract.
;; Replacing the subscriber array keeps in-flight notification order stable.
(define jcore-island-store (j-host-at jcore-shared 5))
(defn jcore-island-get-store [args]
  (if (j-host-lt 1 (j-host-len args))
    (throw "island-get-store: optional key required") nil)
  (let [value (j-host-at jcore-island-store 0) key (j-host-at args 0)]
    (if (j-host-not key) value (jcore-get [value (jcore-key key)]))))
(defn jcore-island-watch-store [args]
  (let [callback (j-host-at args 0)]
    (if (j-host-not (j-host-and (j-host-eq (j-host-len args) 1)
                               (j-host-eq (j-host-type callback) "function")))
      (throw "island-watch-store: one callback required") nil)
    (j-host-set! jcore-island-store 1
      (j-host-concat (j-host-at jcore-island-store 1) [callback]))
    (fn []
      (let [current (j-host-at jcore-island-store 1) remaining []]
        (loop [index 0]
          (if (j-host-lt index (j-host-len current))
            (do (if (j-host-eq (j-host-at current index) callback) nil
                  (j-host-push! remaining (j-host-at current index)))
                (recur (j-host-add index 1))) nil))
        (j-host-set! jcore-island-store 1 remaining)
        nil))))
(defn jcore-island-dispatch [args]
  (if (j-host-not (j-host-or (j-host-eq (j-host-len args) 1)
                            (j-host-eq (j-host-len args) 2)))
    (throw "island-dispatch: map or key/value required") nil)
  (let [previous (j-host-at jcore-island-store 0) key (j-host-at args 0)
        next (if (j-host-eq (j-host-type key) "object")
               (jcore-island-merge [previous key])
               (jcore-island-assoc [previous key (j-host-at args 1)]))
        listeners (j-host-at jcore-island-store 1)]
    (j-host-set! jcore-island-store 0 next)
    (loop [index 0]
      (if (j-host-lt index (j-host-len listeners))
        (do (j-host-call (j-host-at listeners index) [previous next key])
            (recur (j-host-add index 1))) nil))))
(defn jcore-island-mount-reactive [args]
  (let [keys (j-host-at args 2)]
    (if (j-host-not (j-host-and (j-host-eq (j-host-len args) 3)
                   (j-host-or (j-host-nullish? keys) (j-host-array? keys))))
      (throw "island-mount-reactive: id, render function and key array required") nil)
    (let [update (jcore-island-mount [(j-host-at args 0) (j-host-at args 1)])]
      (if (j-host-nullish? update) nil
        (do (jcore-island-watch-store [(fn [previous next changed]
              (if (j-host-or (j-host-nullish? keys) (j-host-includes keys changed))
                (update) nil))]) nil)))))

(defn jcore-island-value [args]
  (let [element (j-host-at args 0)]
    (if (j-host-and (j-host-eq (j-host-len args) 1)
          (j-host-or (j-host-input? element) (j-host-select? element)))
      (j-host-at element "value") (throw "island-value: input, textarea or select required"))))
(defn jcore-island-attribute [args]
  (let [element (j-host-at args 0) name (j-host-at args 1)]
    (if (j-host-and (j-host-eq (j-host-len args) 2)
          (j-host-and (j-host-element? element) (jcore-island-attribute? name)))
      (j-host-dom-attribute element name)
      (throw "island-attribute: element and allowed attribute required"))))
(defn jcore-island-form-reset [args]
  (let [element (j-host-at args 0)]
    (if (j-host-and (j-host-eq (j-host-len args) 1)
          (j-host-and (j-host-element? element) (j-host-eq (j-host-at element "tagName") "FORM")))
      (do (j-host-form-reset element) nil) (throw "island-form-reset!: form required"))))
(defn jcore-island-number [args]
  (let [value (j-host-at args 0) type (j-host-type value)]
    (if (j-host-and (j-host-eq (j-host-len args) 1)
          (j-host-or (j-host-nullish? value)
            (j-host-or (j-host-eq type "string") (j-host-or (j-host-eq type "number") (j-host-eq type "boolean")))))
      (j-host-number value) (throw "island-number: one primitive required"))))
(defn jcore-island-regex-test [args]
  (let [pattern (j-host-at args 0) text (j-host-at args 1)
        flags (if (j-host-eq (j-host-len args) 3) (j-host-at args 2) "")]
    (if (j-host-and
          (j-host-or (j-host-eq (j-host-len args) 2) (j-host-eq (j-host-len args) 3))
          (j-host-and (j-host-eq (j-host-type pattern) "string")
            (j-host-and (j-host-eq (j-host-type text) "string")
              (j-host-and (j-host-eq (j-host-type flags) "string") (j-host-lt (j-host-len pattern) 8193)))))
      (j-host-regex-test pattern text flags)
      (throw "island-regex-test: pattern, text and optional flags required"))))
(defn jcore-island-navigate [args]
  (let [value (j-host-at args 0)]
    (if (j-host-not (j-host-and (j-host-eq (j-host-len args) 1) (j-host-eq (j-host-type value) "string")))
      (throw "island-navigate!: one URL string required") nil)
    (let [url (j-host-url value)]
      (if (j-host-and
            (j-host-or (j-host-eq (j-host-at url "protocol") "http:") (j-host-eq (j-host-at url "protocol") "https:"))
            (j-host-and (j-host-eq (j-host-at url "username") "") (j-host-eq (j-host-at url "password") "")))
        (do (j-host-location-assign (j-host-at url "href")) nil)
        (throw "island-navigate!: HTTP(S) URL without credentials required")))))
(defn jcore-island-confirm [args]
  (if (j-host-and (j-host-eq (j-host-len args) 1) (j-host-eq (j-host-type (j-host-at args 0)) "string"))
    (j-host-confirm (j-host-at args 0)) (throw "island-confirm: one string required")))

(defn jcore-island-flat-parts [value parts]
  (if (j-host-nullish? value) nil
    (if (j-host-array? value)
      (loop [index 0]
        (if (j-host-lt index (j-host-len value))
          (do (jcore-island-flat-parts (j-host-at value index) parts) (recur (j-host-add index 1))) nil))
      (do (j-host-push! parts (if (j-host-element? value) value (jcore-string value))) nil))))
(defn jcore-island-has-node? [values]
  (loop [index 0]
    (if (j-host-lt index (j-host-len values))
      (let [item (j-host-at values index)]
        (if (j-host-or (j-host-element? item)
              (j-host-and (j-host-array? item) (jcore-island-has-node? item)))
          true (recur (j-host-add index 1)))) false)))
(defn jcore-island-str [args]
  (let [parts []]
    (jcore-island-flat-parts args parts)
    (if (jcore-island-has-node? parts) parts
      (loop [index 0 result ""]
        (if (j-host-lt index (j-host-len parts))
          (recur (j-host-add index 1) (j-host-add result (j-host-at parts index))) result)))))
(defn jcore-island-text-value [value]
  (if (j-host-nullish? value) "" (jcore-string value)))
(defn jcore-island-join [args]
  (let [first (j-host-at args 0) second (j-host-at args 1)
        values (if (j-host-array? first) first second)
        separator (jcore-island-text-value (if (j-host-array? first) second first))]
    (if (j-host-not
          (j-host-and (j-host-lt 0 (j-host-len args))
            (j-host-and (j-host-lt (j-host-len args) 3) (j-host-array? values))))
      (throw "island-join: array and optional separator required") nil)
    (if (jcore-island-has-node? values)
      (let [parts []]
        (loop [index 0]
          (if (j-host-lt index (j-host-len values))
            (do (if (j-host-eq index 0) nil (j-host-push! parts separator))
                (jcore-island-flat-parts (j-host-at values index) parts)
                (recur (j-host-add index 1))) parts)))
      (loop [index 0 result ""]
        (if (j-host-lt index (j-host-len values))
          (recur (j-host-add index 1)
            (j-host-add (j-host-add result (if (j-host-eq index 0) "" separator))
              (jcore-island-text-value (j-host-at values index)))) result)))))
(defn jcore-island-trim [args]
  (if (j-host-eq (j-host-len args) 1) (j-host-trim (jcore-island-text-value (j-host-at args 0)))
    (throw "island-trim: one value required")))
(defn jcore-island-contains [args]
  (if (j-host-eq (j-host-len args) 2)
    (j-host-includes (jcore-island-text-value (j-host-at args 0)) (jcore-island-text-value (j-host-at args 1)))
    (throw "island-contains: text and needle required")))
(defn jcore-island-count [args]
  (if (j-host-not (j-host-eq (j-host-len args) 2)) (throw "island-count: text and needle required") nil)
  (let [text (jcore-island-text-value (j-host-at args 0))
        needle (jcore-island-text-value (j-host-at args 1))]
    (if (j-host-eq needle "") 0
      (loop [start 0 count 0]
        (let [next (j-host-index-of text needle start)]
          (if (j-host-lt next 0) count
            (recur (j-host-add next (j-host-len needle)) (j-host-add count 1))))))))
(defn jcore-island-split [args]
  (let [text (jcore-island-text-value (j-host-at args 0)) separator (j-host-at args 1)]
    (if (j-host-eq (j-host-len args) 1) [text]
      (if (j-host-and (j-host-eq (j-host-len args) 2) (j-host-eq (j-host-type separator) "string"))
        (j-host-split text separator) (throw "island-split: text and optional string separator required")))))
(defn jcore-island-regex-split [args]
  (let [text (jcore-island-text-value (j-host-at args 0)) pattern (j-host-at args 1)]
    (if (j-host-and (j-host-eq (j-host-len args) 2)
          (j-host-and (j-host-eq (j-host-type pattern) "string") (j-host-lt (j-host-len pattern) 8193)))
      (j-host-regex-split text pattern) (throw "island-regex-split: text and pattern required"))))

(defn jcore-island-copy [value]
  (if (j-host-nullish? value) {}
    (if (j-host-and (j-host-eq (j-host-type value) "object")
          (j-host-and (j-host-not (jcore-atom? value))
            (j-host-and (j-host-not (jcore-task? value))
              (j-host-or (j-host-array? value) (j-host-plain? value)))))
      (let [result {} names (j-host-keys value)]
        (loop [index 0]
          (if (j-host-lt index (j-host-len names))
            (let [key (j-host-at names index)]
              (do (j-host-own-set! result key (j-host-at value key)) (recur (j-host-add index 1)))) result)))
      (throw "island map: map or array required"))))
(defn jcore-island-assoc [args]
  (if (j-host-eq (j-host-len args) 0) (throw "island-assoc: source required") nil)
  (let [result (jcore-island-copy (j-host-at args 0))]
    (loop [index 1]
      (if (j-host-lt index (j-host-len args))
        (if (j-host-lt (j-host-add index 1) (j-host-len args))
          (do (j-host-own-set! result (jcore-key (j-host-at args index)) (j-host-at args (j-host-add index 1)))
              (recur (j-host-add index 2)))
          (throw "island-assoc: key/value pair required")) result))))
(defn jcore-island-merge [args]
  (let [result {}]
    (loop [index 0]
      (if (j-host-lt index (j-host-len args))
        (let [source (jcore-island-copy (j-host-at args index)) names (j-host-keys source)]
          (loop [at 0]
            (if (j-host-lt at (j-host-len names))
              (let [key (j-host-at names at)]
                (do (j-host-own-set! result key (j-host-at source key)) (recur (j-host-add at 1)))) nil))
          (recur (j-host-add index 1))) result))))
(defn jcore-island-json-merge [args]
  (if (j-host-not (j-host-eq (j-host-len args) 2))
    (throw "island-json-merge: two sources required") nil)
  (jcore-island-merge
    [(if (j-host-eq (j-host-type (j-host-at args 0)) "string")
       (j-host-json-parse (j-host-at args 0)) (j-host-at args 0))
     (if (j-host-eq (j-host-type (j-host-at args 1)) "string")
       (j-host-json-parse (j-host-at args 1)) (j-host-at args 1))]))
(defn jcore-island-dissoc [args]
  (if (j-host-eq (j-host-len args) 0) (throw "island-dissoc: source required") nil)
  (let [result (jcore-island-copy (j-host-at args 0))]
    (loop [index 1]
      (if (j-host-lt index (j-host-len args))
        (do (j-host-delete! result (jcore-key (j-host-at args index))) (recur (j-host-add index 1))) result))))
(defn jcore-island-keys [args]
  (if (j-host-eq (j-host-len args) 1) (j-host-keys (jcore-island-copy (j-host-at args 0)))
    (throw "island-keys: one source required")))

;; JSON requests are distinct from the older raw browser-http! API. No new
;; timeout is imposed. Cancellation shares that API's owned request handles.
(define jcore-island-methods {"GET" true "POST" true "PUT" true "PATCH" true "DELETE" true "HEAD" true "OPTIONS" true})
(defn jcore-island-json-value? [value active depth]
  (if (j-host-lt 512 depth) false
    (let [type (j-host-type value)]
      (if (j-host-or (j-host-nullish? value)
            (j-host-or (j-host-eq type "string") (j-host-or (j-host-eq type "number") (j-host-eq type "boolean"))))
        true
        (if (j-host-and (j-host-eq type "object")
              (j-host-and (j-host-not (jcore-atom? value))
                (j-host-and (j-host-not (jcore-task? value))
                  (j-host-and (j-host-not (j-host-weak-has jcore-listeners value))
                    (j-host-or (j-host-array? value) (j-host-plain? value))))))
          (if (j-host-weak-has active value) false
            (let [names (j-host-keys value)]
              (j-host-weak-add active value)
              (let [valid (loop [index 0]
                             (if (j-host-lt index (j-host-len names))
                               (if (jcore-island-json-value? (j-host-at value (j-host-at names index))
                                                            active (j-host-add depth 1))
                                 (recur (j-host-add index 1)) false) true))]
                (j-host-weak-delete active value)
                valid))) false)))))
(defn jcore-island-request [method url body headers callback result-mode]
  (if (j-host-not
        (j-host-and (j-host-eq (j-host-type method) "string")
          (j-host-and (j-host-own? jcore-island-methods method)
            (j-host-and (j-host-eq (j-host-type url) "string")
              (j-host-and (j-host-eq (j-host-type callback) "function")
                (j-host-or (j-host-nullish? headers)
                  (j-host-and (j-host-eq (j-host-type headers) "object") (j-host-plain? headers))))))))
    (throw "island request: method, URL, headers map and callback required") nil)
  (let [parsed (j-host-url url)
        no-body (j-host-or (j-host-eq method "GET") (j-host-eq method "HEAD"))]
    (if (j-host-or no-body (jcore-island-json-value? body (j-host-weak-new) 0)) nil
      (throw "island request: acyclic JSON data within nesting limit required"))
    (if (j-host-not
          (j-host-and
            (j-host-or (j-host-eq (j-host-at parsed "protocol") "http:") (j-host-eq (j-host-at parsed "protocol") "https:"))
            (j-host-and (j-host-eq (j-host-at parsed "username") "") (j-host-eq (j-host-at parsed "password") ""))))
      (throw "island request: HTTP(S) URL without credentials required") nil)
    (let [request-headers {"Accept" "application/json"}
          supplied (if (j-host-nullish? headers) {} headers)
          names (j-host-keys supplied)
          encoded (if no-body nil (j-host-json-stringify (if (j-host-nullish? body) {} body)))]
      (if no-body nil (j-host-own-set! request-headers "Content-Type" "application/json"))
      (loop [index 0]
        (if (j-host-lt index (j-host-len names))
          (let [key (j-host-at names index) value (j-host-at supplied key)]
            (if (j-host-not (j-host-eq (j-host-type value) "string"))
              (throw "island request: header values must be strings") nil)
            (j-host-own-set! request-headers key value)
            (recur (j-host-add index 1))) nil))
      (let [token [] state [false nil callback nil (j-host-abort-new)]
            finish (fn [result]
              (if (j-host-at state 0) nil
                (let [deliver (j-host-at state 2)]
                  (jcore-http-release state)
                  (if (j-host-or result-mode (j-host-at result "ok"))
                    (try
                      (j-host-call deliver [(if result-mode result (j-host-at result "data"))])
                      (catch error (j-host-console-error "[Island callback] callback threw")))
                    (j-host-console-error "[Island request] request failed")))))
            failed (fn [error]
              (finish {"ok" false "status" 0 "data" {"error" "요청을 완료하지 못했습니다."} "error" "network"}))]
        (j-host-weak-set! jcore-requests token state)
        (j-host-set! state 3 (j-host-timer-set (fn []
          (if (j-host-at state 0) nil
            (do
              (j-host-set! state 3 nil)
              (try
                (j-host-then
                  (j-host-fetch (j-host-at parsed "href")
                    {"method" method "headers" request-headers "body" encoded
                     "signal" (j-host-at (j-host-at state 4) "signal")})
                  (fn [response]
                    (try
                      (j-host-then (j-host-response-text response)
                        (fn [text]
                          (let [decoded
                            (try
                              {"ok" true "data"
                                (if (j-host-and (j-host-eq text "")
                                      (j-host-or (j-host-eq method "HEAD")
                                        (j-host-or (j-host-eq (j-host-at response "status") 204)
                                                   (j-host-eq (j-host-at response "status") 205))))
                                  {} (j-host-json-parse text))}
                              (catch error {"ok" false "data" {"error" "서버 응답을 해석하지 못했습니다."}}))]
                            (finish {"ok" (j-host-and (j-host-at response "ok") (j-host-at decoded "ok"))
                                     "status" (j-host-at response "status") "data" (j-host-at decoded "data")
                                     "error" (if (j-host-at decoded "ok")
                                               (if (j-host-at response "ok") nil "http") "json")}))) failed)
                      (catch error (failed error))))
                  failed)
                (catch error (failed error)))))) 0))
        token))))
(defn jcore-island-fetch [args]
  (if (j-host-eq (j-host-len args) 2)
    (jcore-island-request "GET" (j-host-at args 0) nil {} (j-host-at args 1) false)
    (if (j-host-eq (j-host-len args) 5)
      (jcore-island-request (j-host-at args 0) (j-host-at args 1) (j-host-at args 2)
                            (j-host-at args 3) (j-host-at args 4) true)
      (throw "island-fetch: URL/callback or method/URL/body/headers/callback required"))))
(defn jcore-island-fetch-post [args]
  (if (j-host-eq (j-host-len args) 3)
    (jcore-island-request "POST" (j-host-at args 0) (j-host-at args 1) {} (j-host-at args 2) false)
    (throw "island-fetch-post: URL, body and callback required")))
(defn jcore-island-fetch-delete [args]
  (if (j-host-eq (j-host-len args) 2)
    (jcore-island-request "DELETE" (j-host-at args 0) nil {} (j-host-at args 1) false)
    (throw "island-fetch-delete: URL and callback required")))
(defn jcore-island-fetch-result [args]
  (if (j-host-eq (j-host-len args) 4)
    (jcore-island-request (j-host-at args 0) (j-host-at args 1) (j-host-at args 2) {} (j-host-at args 3) true)
    (throw "island-fetch-result: method, URL, body and callback required")))

;; Development reload snapshots are consumed once, before an island mounts.
(defn jcore-island-hmr-restore [args]
  (if (j-host-not (j-host-eq (j-host-len args) 0))
    (throw "island-hmr-restore!: no arguments required") nil)
  (let [state (j-host-at jcore-shared 7)]
    (if (j-host-at state 0) nil
      (do
        (j-host-set! state 0 true)
        (try
          (let [storage (j-host-session-storage)
                raw (j-host-storage-get storage "__fl_hmr")]
            (if (j-host-nullish? raw) nil
              (do
                (j-host-storage-remove! storage "__fl_hmr")
                (let [snapshot (j-host-json-parse raw)]
                  (if (j-host-and (j-host-not (j-host-nullish? snapshot))
                                 (j-host-eq (j-host-type snapshot) "object"))
                    (let [store (j-host-at snapshot "store") islands (j-host-at snapshot "islands")]
                      (if (j-host-and (j-host-not (j-host-nullish? store))
                                     (j-host-eq (j-host-type store) "object"))
                        (j-host-set! jcore-island-store 0
                          (jcore-island-merge [(j-host-at jcore-island-store 0) store])) nil)
                      (if (j-host-and (j-host-not (j-host-nullish? islands))
                                     (j-host-eq (j-host-type islands) "object"))
                        (j-host-set! state 1 islands) nil)) nil)))))
          (catch error nil))))))
(defn jcore-island-hmr-legacy-key [source]
  (let [parts (j-host-split source "-")
        joined (loop [index 0 value ""]
                 (if (j-host-lt index (j-host-len parts))
                   (recur (j-host-add index 1)
                     (j-host-add (j-host-add value (if (j-host-eq index 0) "" "_"))
                                 (j-host-at parts index))) value))
        size (j-host-len joined) last (j-host-at joined (j-host-sub size 1))]
    (if (j-host-eq last "?") (j-host-add (j-host-substring joined 0 (j-host-sub size 1)) "_q")
      (if (j-host-eq last "!") (j-host-add (j-host-substring joined 0 (j-host-sub size 1)) "_bang") joined))))
(defn jcore-island-hmr-atom [args]
  (let [id (j-host-at args 0) name (j-host-at args 1) initialize (j-host-at args 2)]
    (if (j-host-not (j-host-and (j-host-eq (j-host-len args) 3)
          (j-host-and (j-host-eq (j-host-type id) "string")
            (j-host-and (j-host-eq (j-host-type name) "string")
                        (j-host-eq (j-host-type initialize) "function")))))
      (throw "island-hmr-atom: island id, state name and initializer required") nil)
    (jcore-island-hmr-restore [])
    (let [pending (j-host-at (j-host-at jcore-shared 7) 1)
          row (jcore-get [pending id]) legacy (jcore-island-hmr-legacy-key name)
          saved (j-host-and (j-host-not (j-host-nullish? row))
                   (j-host-and (j-host-eq (j-host-type row) "object")
                     (j-host-or (j-host-own? row name) (j-host-own? row legacy))))
          value (if saved (jcore-atom [(j-host-at row (if (j-host-own? row name) name legacy))])
                    (j-host-call initialize []))]
      (if (jcore-atom? value) value (throw "island-hmr-atom: initializer must return an atom")))))
(defn jcore-island-hmr-register [args]
  (let [id (j-host-at args 0) atoms (j-host-at args 1)]
    (if (j-host-and (j-host-eq (j-host-len args) 2)
          (j-host-and (j-host-eq (j-host-type id) "string")
            (j-host-and (j-host-not (j-host-nullish? atoms))
              (j-host-and (j-host-eq (j-host-type atoms) "object") (j-host-plain? atoms)))))
      (do (j-host-own-set! (j-host-at jcore-shared 6) id atoms) nil)
      (throw "island-hmr-register!: island id and state map required"))))
(defn jcore-island-hmr-snapshot [args]
  (if (j-host-not (j-host-eq (j-host-len args) 0))
    (throw "island-hmr-snapshot: no arguments required") nil)
  (let [registry (j-host-at jcore-shared 6) ids (j-host-keys registry) islands {}]
    (loop [index 0]
      (if (j-host-lt index (j-host-len ids))
        (let [id (j-host-at ids index) atoms (j-host-at registry id)
              names (j-host-keys atoms) row {}]
          (loop [at 0]
            (if (j-host-lt at (j-host-len names))
              (let [name (j-host-at names at) atom (j-host-at atoms name)]
                (j-host-own-set! row name
                  (if (jcore-atom? atom) (jcore-deref [atom])
                    (if (j-host-and (j-host-not (j-host-nullish? atom))
                          (j-host-and (j-host-eq (j-host-type atom) "object") (j-host-own? atom "v")))
                      (j-host-at atom "v") atom)))
                (recur (j-host-add at 1))) nil))
          (j-host-own-set! islands id row)
          (recur (j-host-add index 1))) nil))
    {"store" (jcore-island-copy (j-host-at jcore-island-store 0)) "islands" islands}))
(defn jcore-island-hmr-save [args]
  (if (j-host-not (j-host-eq (j-host-len args) 0))
    (throw "island-hmr-save!: no arguments required") nil)
  (try
    (do (j-host-storage-set! (j-host-session-storage) "__fl_hmr"
          (j-host-json-stringify (jcore-island-hmr-snapshot []))) true)
    (catch error false)))
(defn jcore-island-dev-reload []
  (jcore-island-hmr-save [])
  (j-host-location-reload))
(defn jcore-island-dev-css []
  (let [links (j-host-array-from (j-host-dom-query-all "link[rel=stylesheet]"))
        seen (j-host-at (j-host-at jcore-shared 7) 4) refreshed [0]]
    (loop [index 0]
      (if (j-host-lt index (j-host-len links))
        (let [link (j-host-at links index) url (j-host-url (j-host-at link "href"))]
          (if (j-host-eq (j-host-at url "origin") (j-host-origin))
            (do
              (if (j-host-weak-has seen link) nil
                (do (j-host-weak-add seen link)
                    (j-host-dom-on! link "error" (fn [event] (jcore-island-dev-reload)))))
              (j-host-url-query-set! (j-host-at url "searchParams") "_fl_dev" (j-host-string (j-host-now)))
              (j-host-set! link "href" (j-host-at url "href"))
              (j-host-set! refreshed 0 (j-host-add (j-host-at refreshed 0) 1))) nil)
          (recur (j-host-add index 1))) nil))
    (if (j-host-eq (j-host-at refreshed 0) 0) (jcore-island-dev-reload) nil)))
(defn jcore-island-dev-report [entry]
  (let [base (j-host-at (j-host-at jcore-shared 7) 3)]
    (if (j-host-nullish? base) nil
      (try
        (do (j-host-then
              (j-host-fetch (j-host-add base "/~errors")
                {"method" "POST" "headers" {"Content-Type" "application/json"}
                 "body" (j-host-json-stringify entry)})
              (fn [response] nil) (fn [error] nil)) nil)
        (catch error nil)))))
(defn jcore-island-dev-connect [args]
  (let [port (j-host-at args 0) state (j-host-at jcore-shared 7)]
    (if (j-host-not (j-host-and (j-host-eq (j-host-len args) 1)
          (j-host-and (j-host-integer? port) (j-host-and (j-host-lt 0 port) (j-host-lt port 65536)))))
      (throw "island-dev-connect!: port 1..65535 required") nil)
    (if (j-host-not (j-host-nullish? (j-host-at state 2))) nil
      (let [base (j-host-add (j-host-add (j-host-add (j-host-location-protocol) "//")
                              (j-host-location-hostname)) (j-host-add ":" (j-host-string port)))
            source (j-host-event-source (j-host-add base "/~hmr"))]
        (j-host-set! state 2 source)
        (j-host-set! state 3 base)
        (j-host-dom-on! source "message" (fn [event]
          (let [message (j-host-at event "data")]
            (if (j-host-eq message "css-reload") (jcore-island-dev-css)
              (if (j-host-or (j-host-eq message "soft-reload") (j-host-eq message "reload"))
                (jcore-island-dev-reload) nil)))))
        (j-host-dom-on! (j-host-global) "error" (fn [event]
          (jcore-island-dev-report {"type" "error" "message" (j-host-at event "message")
                                   "source" (j-host-at event "filename") "line" (j-host-at event "lineno")})))
        (j-host-dom-on! (j-host-global) "unhandledrejection" (fn [event]
          (let [reason (j-host-at event "reason")]
            (jcore-island-dev-report {"type" "error" "message"
              (if (j-host-and (j-host-not (j-host-nullish? reason))
                    (j-host-eq (j-host-type (j-host-at reason "message")) "string"))
                (j-host-at reason "message") (j-host-string reason))}))))
        nil))))

;; Preserve the public inspection hooks used by development clients. Every
;; generated module refers to the same document state, even across IIFEs.
(jcore-island-hmr-restore [])
(let [global (j-host-global) previous (j-host-at global "_fl")
      api (if (j-host-nullish? previous) (j-host-at jcore-shared 8) previous)]
  (if (j-host-not (j-host-and (j-host-eq (j-host-type api) "object") (j-host-plain? api)))
    (throw "Native island API namespace conflict") nil)
  (j-host-own-set! api "get_store" (fn [key] (jcore-island-get-store [key])))
  (j-host-own-set! api "dispatch" (fn [key value] (jcore-island-dispatch [key value])))
  (j-host-own-set! api "watch_store" (fn [callback] (jcore-island-watch-store [callback])))
  (j-host-own-set! api "hmr_register" (fn [id atoms] (jcore-island-hmr-register [id atoms])))
  (j-host-own-set! api "hmr_snapshot" (fn [] (jcore-island-hmr-snapshot [])))
  (let [previous-store (j-host-at api "_store")
        store (if (j-host-nullish? previous-store) {} previous-store)]
    (if (j-host-not (j-host-and (j-host-eq (j-host-type store) "object") (j-host-plain? store)))
      (throw "Native island store namespace conflict") nil)
    (j-host-property! store "v"
      {"configurable" true "enumerable" true
       "get" (fn [] (j-host-at jcore-island-store 0))
       "set" (fn [value] (j-host-set! jcore-island-store 0 (jcore-island-copy value)))})
    (j-host-own-set! api "_store" store))
  (j-host-set! jcore-shared 8 api)
  (j-host-set! global "_fl" api))
