;; Browser-target support logic is FreeLang, not a handwritten JS runtime.
;; j-host-* are compiler-only primitive IR operations; user modules cannot call them.
(define jcore-atoms (j-host-weak-new))
(define jcore-listeners (j-host-weak-map-new))
(define jcore-timers (j-host-weak-map-new))
(define jcore-requests (j-host-weak-map-new))
(define jcore-uploads (j-host-weak-map-new))
(define jcore-opaques (j-host-weak-new))
(define jcore-parsed-nodes (j-host-weak-map-new))
(define jcore-parsed-tokens (j-host-weak-map-new))
(define jcore-rich-ranges (j-host-weak-map-new))

(defn jcore-task? [value]
  (or (j-host-weak-has jcore-timers value) (j-host-weak-has jcore-requests value)
      (j-host-weak-has jcore-uploads value)))

(defn jcore-arg [args index] (j-host-at args index))
(defn jcore-atom? [value] (j-host-weak-has jcore-atoms value))
(defn jcore-key [value]
  (if (j-host-eq (j-host-type value) "string")
    (if (j-host-eq (j-host-at value 0) ":") (j-host-slice value 1) value)
    (if (j-host-nullish? value) (j-host-string value)
      (if (j-host-or (j-host-eq (j-host-type value) "number")
                     (j-host-eq (j-host-type value) "boolean"))
        (j-host-string value) "[object Object]"))))

(defn jcore-string [value]
  (if (j-host-nullish? value) (j-host-string value)
    (if (j-host-eq (j-host-type value) "function") "<fn:λ>"
      (if (jcore-atom? value) (throw "browser str: atom rendering not supported")
        (if (j-host-array? value)
          (loop [index 0 result ""]
            (if (j-host-lt index (j-host-len value))
              (let [item (j-host-at value index)
                    part (if (j-host-nullish? item) "" (jcore-string item))]
                (recur (j-host-add index 1)
                  (j-host-add (j-host-add result (if (j-host-eq index 0) "" ",")) part))) result))
          (if (j-host-eq (j-host-type value) "object") "[object Object]" (j-host-string value)))))))

(defn jcore-str [args]
  (loop [index 0 result ""]
    (if (j-host-lt index (j-host-len args))
      (recur (j-host-add index 1) (j-host-add result (jcore-string (j-host-at args index)))) result)))

(defn jcore-html-escape [args]
  (let [value (j-host-at args 0)
        text (if (j-host-nullish? value) "" (jcore-string value))
        replacements {"&" "&amp;" "<" "&lt;" ">" "&gt;" "\"" "&quot;" "'" "&#x27;"}]
    (loop [index 0 start 0 result ""]
      (if (j-host-lt index (j-host-len text))
        (let [char (j-host-at text index)]
          (if (j-host-own? replacements char)
            (recur (j-host-add index 1) (j-host-add index 1)
              (j-host-add (j-host-add result (j-host-substring text start index)) (j-host-at replacements char)))
            (recur (j-host-add index 1) start result)))
        (j-host-add result (j-host-substring text start (j-host-len text)))))))

(defn jcore-get [args]
  (let [value (j-host-at args 0) key (j-host-at args 1)
        fallback (if (j-host-lt 2 (j-host-len args)) (j-host-at args 2) nil)]
    (if (j-host-nullish? value) fallback
      (if (j-host-or (j-host-array? value) (j-host-eq (j-host-type value) "string"))
        (if (j-host-and (j-host-integer? key) (j-host-and (j-host-gte key 0) (j-host-lt key (j-host-len value))))
          (let [found (j-host-at value key)] (if (j-host-nullish? found) fallback found)) fallback)
        (if (j-host-and (j-host-eq (j-host-type value) "object") (j-host-not (jcore-atom? value)))
          (let [normalized (jcore-key key)]
            (if (j-host-own? value normalized) (j-host-at value normalized)
              (if (j-host-and (j-host-eq (j-host-type key) "string") (j-host-own? value key))
                (j-host-at value key) fallback))) fallback)))))

(defn jcore-same [left right]
  (if (j-host-eq left right) true
    (if (j-host-or (j-host-nullish? left) (j-host-nullish? right)) false
      (if (j-host-not (j-host-eq (j-host-type left) (j-host-type right))) false
        (if (j-host-or (or (jcore-atom? left) (jcore-atom? right)
                          (j-host-weak-has jcore-opaques left) (j-host-weak-has jcore-opaques right))
                      (j-host-or
                        (j-host-or (j-host-weak-has jcore-listeners left) (j-host-weak-has jcore-listeners right))
                        (j-host-or (jcore-task? left) (jcore-task? right)))) false
          (if (j-host-array? left)
            (if (j-host-and (j-host-array? right) (j-host-eq (j-host-len left) (j-host-len right)))
              (loop [index 0]
                (if (j-host-lt index (j-host-len left))
                  (if (jcore-same (j-host-at left index) (j-host-at right index))
                    (recur (j-host-add index 1)) false) true)) false)
            (if (j-host-and (j-host-eq (j-host-type left) "object")
                           (j-host-and (j-host-plain? left) (j-host-plain? right)))
              (let [keys (j-host-keys left)]
                (if (j-host-eq (j-host-len keys) (j-host-len (j-host-keys right)))
                  (loop [index 0]
                    (if (j-host-lt index (j-host-len keys))
                      (let [key (j-host-at keys index)]
                        (if (j-host-and (j-host-own? right key) (jcore-same (j-host-at left key) (j-host-at right key)))
                          (recur (j-host-add index 1)) false)) true)) false)) false)))))))

(defn jcore-equal [args]
  (loop [index 1]
    (if (j-host-lt index (j-host-len args))
      (if (jcore-same (j-host-at args 0) (j-host-at args index))
        (recur (j-host-add index 1)) false) true)))

(defn jcore-number [value]
  (if (j-host-eq (j-host-type value) "number") value
    (throw "browser numeric operator: number required")))

(defn jcore-add [args]
  (loop [index 0 total 0]
    (if (j-host-lt index (j-host-len args))
      (recur (j-host-add index 1) (j-host-add total (jcore-number (j-host-at args index)))) total)))
(defn jcore-sub [args]
  (if (j-host-eq (j-host-len args) 0) (throw "browser -: nonempty arguments required")
    (if (j-host-eq (j-host-len args) 1) (j-host-neg (jcore-number (j-host-at args 0)))
      (loop [index 1 total (jcore-number (j-host-at args 0))]
        (if (j-host-lt index (j-host-len args))
          (recur (j-host-add index 1) (j-host-sub total (jcore-number (j-host-at args index)))) total)))))
(defn jcore-mul [args]
  (loop [index 0 total 1]
    (if (j-host-lt index (j-host-len args))
      (recur (j-host-add index 1) (j-host-mul total (jcore-number (j-host-at args index)))) total)))
(defn jcore-div [args]
  (if (j-host-eq (j-host-len args) 0) (throw "browser /: nonempty arguments required")
    (if (j-host-eq (j-host-len args) 1) (j-host-div 1 (jcore-number (j-host-at args 0)))
      (loop [index 1 total (jcore-number (j-host-at args 0))]
        (if (j-host-lt index (j-host-len args))
          (recur (j-host-add index 1) (j-host-div total (jcore-number (j-host-at args index)))) total)))))
(defn jcore-less [args]
  (loop [index 1]
    (if (j-host-lt index (j-host-len args))
      (if (j-host-lt (j-host-at args (j-host-sub index 1)) (j-host-at args index))
        (recur (j-host-add index 1)) false) true)))

(defn jcore-length [args]
  (let [value (j-host-at args 0)]
    (if (j-host-nullish? value) 0
      (if (j-host-or (j-host-array? value) (j-host-eq (j-host-type value) "string"))
        (j-host-len value)
        (if (j-host-and (j-host-eq (j-host-type value) "object") (j-host-not (jcore-atom? value)))
          (j-host-len (j-host-keys value)) 0)))))
(defn jcore-substring [args]
  (let [value (jcore-string (j-host-at args 0))]
    (j-host-substring value (j-host-at args 1)
      (if (j-host-lt 2 (j-host-len args)) (j-host-at args 2) (j-host-len value)))))
(defn jcore-nil [args] (j-host-nullish? (j-host-at args 0)))
(defn jcore-string? [args] (j-host-eq (j-host-type (j-host-at args 0)) "string"))

(defn jcore-atom [args]
  (let [value [(if (j-host-eq (j-host-len args) 0) nil (j-host-at args 0))]]
    (do (j-host-weak-add jcore-atoms value) value)))
(defn jcore-deref [args]
  (let [value (j-host-at args 0)]
    (if (jcore-atom? value) (j-host-at value 0) (throw "browser deref: atom required"))))
(defn jcore-reset [args]
  (let [value (j-host-at args 0) next (j-host-at args 1)]
    (if (jcore-atom? value) (do (j-host-set! value 0 next) next) (throw "browser reset!: atom required"))))
(defn jcore-swap [args]
  (let [value (j-host-at args 0) callback (j-host-at args 1)]
    (if (j-host-and (jcore-atom? value) (j-host-eq (j-host-type callback) "function"))
      (let [parameters (j-host-concat [(j-host-at value 0)] (j-host-slice args 2))
            next (j-host-call callback parameters)]
        (do (j-host-set! value 0 next) next)) (throw "browser swap!: atom and function required"))))
(defn jcore-append [args]
  (let [source (j-host-at args 0)]
    (if (j-host-or (j-host-nullish? source) (j-host-array? source))
      (if (j-host-and (j-host-array? source)
                     (j-host-and (j-host-eq (j-host-len args) 2) (j-host-array? (j-host-at args 1))))
        (j-host-concat source (j-host-at args 1))
      (let [result (if (j-host-nullish? source) [] (j-host-copy source))]
        (loop [index 1]
          (if (j-host-lt index (j-host-len args))
            (do (j-host-push! result (j-host-at args index)) (recur (j-host-add index 1))) result))))
      (throw "browser append: this target currently requires an array"))))
(defn jcore-map [args]
  (let [callback (j-host-at args 0) source (j-host-at args 1)]
    (if (j-host-and (j-host-eq (j-host-type callback) "function") (j-host-array? source))
      (let [result []]
        (loop [index 0]
          (if (j-host-lt index (j-host-len source))
            (do (j-host-push! result (j-host-call callback [(j-host-at source index)]))
                (recur (j-host-add index 1))) result)))
      (throw "browser map: function and array required"))))

(defn jcore-by-id [args]
  (if (j-host-and (j-host-eq (j-host-len args) 1) (j-host-eq (j-host-type (j-host-at args 0)) "string"))
    (j-host-dom-by-id (j-host-at args 0)) (throw "browser-by-id: one string required")))
(defn jcore-set-text [args]
  (let [element (j-host-at args 0) value (j-host-at args 1)]
    (if (j-host-and (j-host-eq (j-host-len args) 2)
                   (j-host-and (j-host-element? element) (j-host-eq (j-host-type value) "string")))
      (do (j-host-dom-set-text! element value) nil) (throw "browser-set-text!: element and string required"))))

(defn jcore-text [args]
  (let [element (j-host-at args 0)]
    (if (j-host-and (j-host-eq (j-host-len args) 1) (j-host-element? element))
      (j-host-at element "textContent") (throw "browser-text: one element required"))))
(defn jcore-value [args]
  (let [element (j-host-at args 0)]
    (if (j-host-and (j-host-eq (j-host-len args) 1) (j-host-input? element))
      (j-host-at element "value") (throw "browser-value: one input or textarea required"))))
(defn jcore-set-value [args]
  (let [element (j-host-at args 0) value (j-host-at args 1)]
    (if (j-host-and (j-host-eq (j-host-len args) 2)
                   (j-host-and (j-host-input? element) (j-host-eq (j-host-type value) "string")))
      (do (j-host-set! element "value" value) nil)
      (throw "browser-set-value!: input or textarea and string required"))))
(defn jcore-after [args]
  (let [delay (j-host-at args 0) callback (j-host-at args 1)]
    (if (j-host-and (j-host-eq (j-host-len args) 2)
          (j-host-and (j-host-integer? delay)
            (j-host-and (j-host-gte delay 0)
              (j-host-and (j-host-lt delay 2147483648) (j-host-eq (j-host-type callback) "function")))))
      (let [token [] record [true callback nil]]
        (do
          (j-host-weak-set! jcore-timers token record)
          (j-host-set! record 2
            (j-host-timer-set (fn []
              (if (j-host-at record 0)
                (let [run (j-host-at record 1)]
                  (do (j-host-set! record 0 false)
                      (j-host-set! record 1 nil)
                      (j-host-set! record 2 nil)
                      (j-host-call run []))) nil)) delay))
          token))
      (throw "browser-after!: integer delay 0..2147483647 and function required"))))
(defn jcore-http-release [state]
  (j-host-set! state 0 true)
  (j-host-timer-clear (j-host-at state 1))
  (j-host-timer-clear (j-host-at state 3))
  (j-host-set! state 1 nil)
  (j-host-set! state 2 nil)
  (j-host-set! state 3 nil)
  (j-host-set! state 4 nil))
(defn jcore-cancel [args]
  (if (j-host-not (j-host-eq (j-host-len args) 1))
    (throw "browser-cancel!: one task handle required") nil)
  (let [token (j-host-at args 0)]
    (if (j-host-weak-has jcore-timers token)
      (let [record (j-host-weak-get jcore-timers token)]
        (if (j-host-at record 0)
          (do (j-host-timer-clear (j-host-at record 2))
              (j-host-set! record 0 false)
              (j-host-set! record 1 nil)
              (j-host-set! record 2 nil) true) false))
      (if (j-host-weak-has jcore-requests token)
        (let [state (j-host-weak-get jcore-requests token)]
          (if (j-host-at state 0) false
            (let [controller (j-host-at state 4)]
              (do (jcore-http-release state) (j-host-abort controller) true))))
        (if (j-host-weak-has jcore-uploads token)
          (let [state (j-host-weak-get jcore-uploads token)]
            (if (j-host-at state 0) false
              (let [xhr (j-host-at state 3)]
                (do (jcore-upload-release state) (j-host-abort xhr) true))))
          (throw "browser-cancel!: one task handle required"))))))

(defn jcore-event-name? [name]
  (or (j-host-own? {"submit" true "drop" true "mousedown" true "mouseup" true} name)
  (j-host-or (j-host-eq name "input")
    (j-host-or (j-host-eq name "change")
      (j-host-or (j-host-eq name "click")
        (j-host-or (j-host-eq name "keydown")
          (j-host-or (j-host-eq name "beforeinput")
            (j-host-or (j-host-eq name "compositionstart")
              (j-host-or (j-host-eq name "compositionend")
                (j-host-or (j-host-eq name "paste")
                  (j-host-or (j-host-eq name "focus") (j-host-eq name "blur"))))))))))))
(defn jcore-on [args]
  (let [element (j-host-at args 0) name (j-host-at args 1) callback (j-host-at args 2)]
    (if (j-host-and (j-host-eq (j-host-len args) 3)
          (j-host-and (j-host-element? element)
            (j-host-and (jcore-event-name? name) (j-host-eq (j-host-type callback) "function"))))
      (let [token [] listener (fn [event] (callback event))]
        (do (j-host-dom-on! element name listener)
            (j-host-weak-set! jcore-listeners token [element name listener true]) token))
      (throw "browser-on!: element, allowed event name and function required"))))
(defn jcore-off [args]
  (let [token (j-host-at args 0)]
    (if (j-host-and (j-host-eq (j-host-len args) 1) (j-host-weak-has jcore-listeners token))
      (let [record (j-host-weak-get jcore-listeners token)]
        (if (j-host-at record 3)
          (do (j-host-dom-off! (j-host-at record 0) (j-host-at record 1) (j-host-at record 2))
              (j-host-set! record 3 false) nil) nil))
      (throw "browser-off!: one listener token required"))))
(defn jcore-event [args]
  (let [event (j-host-at args 0)]
    (if (and (j-host-eq (j-host-len args) 1)
             (try (do (j-host-event-type event) true) (catch error false))) event
      (throw "browser event: one Event required"))))
(defn jcore-event-target [args]
  (let [target (j-host-at (jcore-event args) "target")]
    (if (j-host-element? target) target nil)))
(defn jcore-event-key [args]
  (let [event (jcore-event args)]
    (try (j-host-keyboard-key event) (catch error nil))))
(defn jcore-prevent-default [args]
  (do (j-host-prevent-default! (jcore-event args)) nil))

(define jcore-tags {"div" true "section" true "article" true "p" true "span" true
  "strong" true "em" true "u" true "s" true "blockquote" true "pre" true "code" true
  "h2" true "h3" true "ul" true "ol" true "li" true "hr" true "br" true "a" true
  "img" true "figure" true "figcaption" true "label" true "button" true "input" true "textarea" true
  "select" true "option" true "progress" true})
(define jcore-attributes {"id" true "class" true "title" true "alt" true "width" true
  "height" true "role" true "aria-label" true "aria-expanded" true "tabindex" true
  "contenteditable" true "type" true "accept" true "data-block-id" true "href" true "src" true
  "name" true "value" true "checked" true "disabled" true "open" true "srcset" true "sizes" true "max" true})
(defn jcore-attribute-name? [name]
  (and (j-host-eq (j-host-type name) "string")
       (or (j-host-own? jcore-attributes name) (jcore-data-attribute? name))))
(defn jcore-element-args? [args count]
  (if (j-host-eq (j-host-len args) count)
    (loop [index 0]
      (if (j-host-lt index count)
        (if (j-host-element? (j-host-at args index)) (recur (j-host-add index 1)) false) true)) false))
(defn jcore-create [args]
  (let [tag (j-host-at args 0)]
    (if (j-host-and (j-host-eq (j-host-len args) 1)
          (j-host-and (j-host-eq (j-host-type tag) "string") (j-host-own? jcore-tags tag)))
      (j-host-dom-create tag) (throw "browser-create: one allowed tag required"))))
(defn jcore-dom-append [args]
  (if (jcore-element-args? args 2)
    (do (j-host-dom-append! (j-host-at args 0) (j-host-at args 1)) nil)
    (throw "browser-append!: two elements required")))
(defn jcore-dom-before [args]
  (let [parent (j-host-at args 0) child (j-host-at args 1) before (j-host-at args 2)]
    (if (j-host-and (j-host-eq (j-host-len args) 3)
          (j-host-and (j-host-and (j-host-element? parent) (j-host-element? child))
            (j-host-or (j-host-nullish? before) (j-host-element? before))))
      (do (j-host-dom-before! parent child before) nil)
      (throw "browser-insert-before!: parent, child and element or nil required"))))
(defn jcore-dom-remove [args]
  (if (jcore-element-args? args 1) (do (j-host-dom-remove! (j-host-at args 0)) nil)
    (throw "browser-remove!: one element required")))
(defn jcore-dom-clear [args]
  (if (jcore-element-args? args 1) (do (j-host-dom-clear! (j-host-at args 0)) nil)
    (throw "browser-clear!: one element required")))
(defn jcore-dom-children [args]
  (if (jcore-element-args? args 1) (j-host-array-from (j-host-at (j-host-at args 0) "children"))
    (throw "browser-children: one element required")))
(defn jcore-dom-attribute [args]
  (let [element (jcore-inspect-node (j-host-at args 0)) name (j-host-at args 1)]
    (if (j-host-and (j-host-eq (j-host-len args) 2)
          (j-host-and (j-host-element? element)
            (j-host-or (jcore-attribute-name? name) (j-host-eq name "hidden"))))
      (j-host-dom-attribute element name) (throw "browser-attribute: element and allowed attribute required"))))
(defn jcore-dom-url [element name value]
  (if (j-host-eq name "srcset")
    (if (and (j-host-eq (j-host-at element "tagName") "IMG") (jcore-srcset-safe? value)) value
      (throw "browser URL: protocol or image origin rejected"))
  (if (j-host-or (j-host-eq name "href") (j-host-eq name "src"))
    (if (j-host-eq (j-host-at element "tagName") (if (j-host-eq name "src") "IMG" "A"))
      (let [url (j-host-url value) protocol (j-host-at url "protocol")]
        (if (j-host-and (j-host-or (j-host-eq protocol "http:") (j-host-eq protocol "https:"))
              (j-host-or (j-host-eq name "href") (j-host-eq (j-host-at url "origin") (j-host-origin))))
          (j-host-at url "href") (throw "browser URL: protocol or image origin rejected")))
      (throw "browser URL: attribute requires its link or image element")) value)))
(defn jcore-dom-set-attribute [args]
  (let [element (j-host-at args 0) name (j-host-at args 1) value (j-host-at args 2)]
    (if (j-host-and (j-host-eq (j-host-len args) 3)
          (j-host-and (j-host-element? element)
            (j-host-and (jcore-attribute-name? name) (j-host-eq (j-host-type value) "string"))))
      (let [safe-value (jcore-dom-url element name value)]
        (do (j-host-dom-set-attribute! element name safe-value) nil))
      (throw "browser-set-attribute!: element, allowed attribute and string required"))))
(defn jcore-dom-hidden [args]
  (let [element (j-host-at args 0) hidden (j-host-at args 1)]
    (if (j-host-and (j-host-eq (j-host-len args) 2)
          (j-host-and (j-host-element? element) (j-host-eq (j-host-type hidden) "boolean")))
      (do (j-host-set! element "hidden" hidden) nil)
      (throw "browser-set-hidden!: element and boolean required"))))
(defn jcore-dom-focus [args]
  (if (jcore-element-args? args 1) (do (j-host-dom-focus! (j-host-at args 0)) nil)
    (throw "browser-focus!: one element required")))

;; Storage errors are observable without disclosing keys, values or host messages.
(defn jcore-storage-key [args size arity-error]
  (if (j-host-eq (j-host-len args) size)
    (let [key (j-host-at args 0)]
      (if (j-host-and (j-host-eq (j-host-type key) "string")
                     (j-host-lt 0 (j-host-len key))) key
        (throw "browser-storage: non-empty string key required")))
    (throw arity-error)))
(defn jcore-storage-error [error]
  (let [name (try
               (if (j-host-nullish? error) nil (j-host-at error "name"))
               (catch ignored nil))]
    (throw (if (j-host-eq name "SecurityError") "browser-storage: access denied"
      (if (j-host-eq name "QuotaExceededError") "browser-storage: quota exceeded"
        "browser-storage: operation failed")))))
(defn jcore-storage-read [args]
  (let [key (jcore-storage-key args 1 "browser-storage-read: one key required")]
    (try
      (let [value (j-host-storage-read (j-host-storage) key)]
        (if (j-host-nullish? value) nil value))
      (catch error (jcore-storage-error error)))))
(defn jcore-storage-write [args]
  (let [key (jcore-storage-key args 2 "browser-storage-write!: key and value required")
        value (j-host-at args 1)]
    (if (j-host-eq (j-host-type value) "string")
      (try (do (j-host-storage-write! (j-host-storage) key value) nil)
        (catch error (jcore-storage-error error)))
      (throw "browser-storage: string value required"))))
(defn jcore-storage-remove [args]
  (let [key (jcore-storage-key args 1 "browser-storage-remove!: one key required")]
    (try (do (j-host-storage-remove! (j-host-storage) key) nil)
      (catch error (jcore-storage-error error)))))

;; HTTP owns completion until the entire response body has arrived.
(defn jcore-json-parse [args]
  (if (j-host-and (j-host-eq (j-host-len args) 1)
        (j-host-eq (j-host-type (j-host-at args 0)) "string"))
    (j-host-json-parse (j-host-at args 0))
    (throw "browser-json-parse: one string required")))
(defn jcore-http [args]
  (let [url (j-host-at args 0) options (j-host-at args 1) callback (j-host-at args 2)]
    (if (j-host-not (j-host-and (j-host-eq (j-host-len args) 3)
          (j-host-and (j-host-eq (j-host-type url) "string")
            (j-host-and (j-host-not (j-host-nullish? options))
              (j-host-and (j-host-eq (j-host-type options) "object")
                (j-host-and (j-host-plain? options) (j-host-eq (j-host-type callback) "function")))))))
      (throw "browser-http!: URL, options map and callback required") nil)
    (let [method (j-host-at options "method") body (j-host-at options "body")
          delay (j-host-at options "timeout") parsed (j-host-url url)]
      (if (j-host-not (j-host-and
            (j-host-or (j-host-eq (j-host-at parsed "protocol") "http:")
                      (j-host-eq (j-host-at parsed "protocol") "https:"))
            (j-host-and (j-host-eq (j-host-at parsed "username") "")
              (j-host-eq (j-host-at parsed "password") ""))))
        (throw "browser-http!: HTTP(S) URL without credentials required") nil)
      (if (j-host-not (j-host-and
            (j-host-or (j-host-eq method "GET") (j-host-eq method "POST"))
            (j-host-and (j-host-eq (j-host-type body) "string")
              (j-host-and (j-host-or (j-host-eq method "POST") (j-host-eq body ""))
                (j-host-and (j-host-integer? delay)
                  (j-host-and (j-host-gte delay 1) (j-host-lt delay 2147483648)))))))
        (throw "browser-http!: GET/POST, string body and integer timeout 1..2147483647 required") nil)
      (let [token [] state [false nil callback nil (j-host-abort-new)]
            finish (fn [result]
              (if (j-host-at state 0) nil
                (let [deliver (j-host-at state 2)]
                  (do (jcore-http-release state)
                      (j-host-call deliver [result])))))
            failed (fn [error] (finish {"ok" false "status" 0 "body" "" "error" "network"}))]
        (j-host-weak-set! jcore-requests token state)
        (j-host-set! state 1 (j-host-timer-set (fn []
          (if (j-host-at state 0) nil
            (do (j-host-abort (j-host-at state 4))
                (finish {"ok" false "status" 0 "body" "" "error" "timeout"})))) delay))
        (j-host-set! state 3 (j-host-timer-set (fn []
          (if (j-host-at state 0) nil
            (do
              (j-host-set! state 3 nil)
              (try
                (j-host-then
                  (j-host-fetch (j-host-at parsed "href")
                    {"method" method "body" (if (j-host-eq method "GET") nil body)
                     "signal" (j-host-at (j-host-at state 4) "signal")})
                  (fn [response]
                    (j-host-then (j-host-response-text response)
                      (fn [text]
                        (finish {"ok" (j-host-at response "ok") "status" (j-host-at response "status")
                          "body" text "error" (if (j-host-at response "ok") nil "http")})) failed))
                  failed)
                (catch error (failed error)))))) 0))
        token))))

;; Selection offsets are UTF-16 positions in value/textContent. No markup is read.
(defn jcore-selection-element [args minimum maximum]
  (let [element (j-host-at args 0) size (j-host-len args)]
    (if (j-host-and (j-host-and (j-host-gte size minimum) (j-host-gte maximum size))
          (j-host-element? element))
      (if (j-host-eq (j-host-at element "isConnected") true) element
        (throw "browser-selection: connected element required"))
      (throw "browser-selection: element and required arguments expected"))))
(defn jcore-selection-input-check [element]
  (if (j-host-and (j-host-integer? (j-host-at element "selectionStart"))
                 (j-host-integer? (j-host-at element "selectionEnd"))) element
    (throw "browser-selection: selectable input required")))
(defn jcore-selection-prefix [element container offset]
  (let [range (j-host-range)]
    (do (j-host-range-select! range element)
        (j-host-range-end! range container offset)
        (j-host-len (j-host-range-text range)))))
(defn jcore-selection-read [args]
  (let [element (jcore-selection-element args 1 1)]
    (if (j-host-input? element)
      (let [input (jcore-selection-input-check element)
            start (j-host-at input "selectionStart") end (j-host-at input "selectionEnd")]
        {"start" start "end" end
         "text" (j-host-substring (j-host-at input "value") start end)
         "direction" (if (j-host-eq start end) "none"
           (if (j-host-eq (j-host-at input "selectionDirection") "backward") "backward" "forward"))})
      (let [selection (j-host-selection)]
        (if (j-host-or (j-host-nullish? selection) (j-host-eq (j-host-at selection "rangeCount") 0)) nil
          (if (j-host-and (j-host-dom-contains element (j-host-at selection "anchorNode"))
                         (j-host-dom-contains element (j-host-at selection "focusNode")))
            (let [range (j-host-selection-range selection 0)]
              (if (j-host-and (j-host-dom-contains element (j-host-at range "startContainer"))
                             (j-host-dom-contains element (j-host-at range "endContainer")))
              (let [start (jcore-selection-prefix element (j-host-at range "startContainer") (j-host-at range "startOffset"))
                    end (jcore-selection-prefix element (j-host-at range "endContainer") (j-host-at range "endOffset"))]
              {"start" start "end" end "text" (j-host-range-text range)
               "direction" (if (j-host-eq start end) "none"
                 (if (j-host-eq start (jcore-selection-prefix element
                       (j-host-at selection "anchorNode") (j-host-at selection "anchorOffset")))
                   "forward" "backward"))}) nil)) nil))))))
(defn jcore-selection-point [element offset]
  (let [walker (j-host-text-walker element)]
    (loop [remaining offset]
      (let [node (j-host-walker-next walker)]
        (if (j-host-nullish? node) [element 0]
          (let [size (j-host-len (j-host-at node "data"))]
            (if (j-host-gte size remaining) [node remaining]
              (recur (j-host-sub remaining size)))))))))
(defn jcore-selection-set [args]
  (let [element (jcore-selection-element args 3 4)
        start (j-host-at args 1) end (j-host-at args 2)
        direction (if (j-host-eq (j-host-len args) 4) (j-host-at args 3) "forward")
        input (j-host-input? element)
        target (if input (jcore-selection-input-check element) element)
        text (j-host-at target (if input "value" "textContent"))]
    (if (j-host-not (j-host-and (j-host-integer? start)
          (j-host-and (j-host-integer? end)
            (j-host-and (j-host-gte start 0)
              (j-host-and (j-host-gte end start) (j-host-gte (j-host-len text) end))))))
      (throw "browser-selection: UTF-16 offsets out of range") nil)
    (if (j-host-not (j-host-or (j-host-eq direction "forward") (j-host-eq direction "backward")))
      (throw "browser-selection: forward or backward direction required") nil)
    (if input (j-host-select-range! target start end direction)
      (let [selection (j-host-selection)
            first (jcore-selection-point element start) last (jcore-selection-point element end)
            anchor (if (j-host-eq direction "backward") last first)
            focus (if (j-host-eq direction "backward") first last)]
        (if (j-host-nullish? selection) (throw "browser-selection: selection unavailable")
          (j-host-selection-set! selection (j-host-at anchor 0) (j-host-at anchor 1)
                                         (j-host-at focus 0) (j-host-at focus 1)))))
    (let [applied (jcore-selection-read [element])]
      (if (j-host-and (j-host-not (j-host-nullish? applied))
            (j-host-and (j-host-eq (j-host-at applied "start") start)
              (j-host-and (j-host-eq (j-host-at applied "end") end)
                (j-host-or (j-host-eq start end)
                           (j-host-eq (j-host-at applied "direction") direction))))) nil
        (throw "browser-selection: selection not applied")))))

;; Inert HTML is inspected through unforgeable references, never live elements.
(defn jcore-inspect-node [value]
  (if (j-host-weak-has jcore-parsed-nodes value) (j-host-weak-get jcore-parsed-nodes value) value))
(defn jcore-wrap-node [node]
  (if (j-host-nullish? node) nil
    (if (j-host-weak-has jcore-parsed-tokens node) (j-host-weak-get jcore-parsed-tokens node)
      (let [token []]
        (do (j-host-weak-add jcore-opaques token)
            (j-host-weak-set! jcore-parsed-nodes token node)
            (j-host-weak-set! jcore-parsed-tokens node token) token)))))
(defn jcore-data-attribute? [name]
  (and (j-host-eq (j-host-type name) "string")
    (or (j-host-eq (j-host-substring name 0 5) "data-")
        (j-host-eq (j-host-substring name 0 5) "aria-"))
    (j-host-lt 5 (j-host-len name))
    (loop [index 5]
      (if (j-host-lt index (j-host-len name))
        (if (j-host-includes "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-" (j-host-at name index))
          (recur (j-host-add index 1)) false) true))))
(defn jcore-query-scope [value]
  (if (j-host-nullish? value) (j-host-document)
    (let [node (jcore-inspect-node value)]
      (if (or (j-host-element? node) (and (j-host-weak-has jcore-parsed-nodes value) (j-host-fragment? node))) node
        (throw "browser-query: element or inert scope required")))))
(defn jcore-query-run [args many]
  (if (j-host-not (and (j-host-eq (j-host-len args) 2) (j-host-eq (j-host-type (j-host-at args 1)) "string")))
    (throw "browser-query: scope and selector required") nil)
  (let [value (j-host-at args 0) scope (jcore-query-scope value) selector (j-host-at args 1)
        parsed (j-host-weak-has jcore-parsed-nodes value)]
    (try
      (if many
        (let [nodes (j-host-array-from (j-host-query-all scope selector)) result []]
          (loop [index 0]
            (if (j-host-lt index (j-host-len nodes))
              (do (j-host-push! result (if parsed (jcore-wrap-node (j-host-at nodes index)) (j-host-at nodes index)))
                  (recur (j-host-add index 1))) result)))
        (let [node (j-host-query scope selector)] (if parsed (jcore-wrap-node node) node)))
      (catch error (throw "browser-query: invalid selector")))))
(defn jcore-query [args] (jcore-query-run args false))
(defn jcore-query-all [args] (jcore-query-run args true))
(defn jcore-node-arg [args]
  (let [node (jcore-inspect-node (j-host-at args 0))]
    (if (and (j-host-eq (j-host-len args) 1) (j-host-node? node)) node
      (throw "browser-node: one node or inert reference required"))))
(defn jcore-child-nodes [args]
  (let [value (j-host-at args 0) node (jcore-node-arg args)
        nodes (j-host-array-from (j-host-at node "childNodes")) result []]
    (loop [index 0]
      (if (j-host-lt index (j-host-len nodes))
        (do (j-host-push! result (if (j-host-weak-has jcore-parsed-nodes value)
              (jcore-wrap-node (j-host-at nodes index)) (j-host-at nodes index)))
            (recur (j-host-add index 1))) result))))
(defn jcore-node-info [args]
  (let [node (jcore-node-arg args) kind (j-host-at node "nodeType") element (j-host-element? node)]
    {"kind" (if (j-host-eq kind 3) "text" (if element "element" (if (j-host-eq kind 11) "fragment" "other")))
     "tag" (if element (j-host-lower (j-host-at node "localName")) nil)
     "text" (if (j-host-nullish? (j-host-at node "textContent")) "" (j-host-at node "textContent"))
     "attributes" (if element (j-host-len (j-host-at node "attributes")) 0)}))
(defn jcore-has-attribute [args]
  (let [node (jcore-inspect-node (j-host-at args 0)) name (j-host-at args 1)]
    (if (and (j-host-eq (j-host-len args) 2) (j-host-element? node)
             (or (jcore-attribute-name? name) (j-host-eq name "hidden")))
      (j-host-has-attribute node name) (throw "browser-has-attribute?: element and allowed attribute required"))))
(defn jcore-remove-attribute [args]
  (let [node (j-host-at args 0) name (j-host-at args 1)]
    (if (and (j-host-eq (j-host-len args) 2) (j-host-element? node)
             (or (jcore-attribute-name? name) (j-host-eq name "hidden")))
      (do (j-host-remove-attribute! node name) nil) (throw "browser-remove-attribute!: element and allowed attribute required"))))
(define jcore-layout-properties {"width" "width" "maxWidth" "max-width" "height" "height"
  "marginLeft" "margin-left" "marginRight" "margin-right" "display" "display"
  "gridTemplateColumns" "grid-template-columns" "gap" "gap" "outline" "outline"})
(defn jcore-set-style [args]
  (let [node (j-host-at args 0) property (j-host-at args 1) value (j-host-at args 2)]
    (if (and (j-host-eq (j-host-len args) 3) (j-host-element? node)
             (j-host-eq (j-host-type property) "string") (j-host-own? jcore-layout-properties property)
             (j-host-eq (j-host-type value) "string")
             (or (j-host-eq value "") (j-host-css-supports (j-host-at jcore-layout-properties property) value)))
      (do (j-host-set! (j-host-at node "style") property value) nil)
      (throw "browser-set-style!: layout property and valid value required"))))
(defn jcore-set-disabled [args]
  (let [node (j-host-at args 0) value (j-host-at args 1)]
    (if (and (j-host-eq (j-host-len args) 2) (j-host-element? node)
             (j-host-own? {"BUTTON" true "INPUT" true "TEXTAREA" true "SELECT" true "OPTION" true} (j-host-at node "tagName"))
             (j-host-eq (j-host-type value) "boolean"))
      (do (j-host-set! node "disabled" value) nil) (throw "browser-set-disabled!: control and boolean required"))))
(defn jcore-checked [args]
  (let [node (j-host-at args 0)]
    (if (and (j-host-eq (j-host-len args) 1) (j-host-element? node) (j-host-eq (j-host-at node "tagName") "INPUT")
             (or (j-host-eq (j-host-at node "type") "checkbox") (j-host-eq (j-host-at node "type") "radio")))
      (j-host-eq (j-host-at node "checked") true) (throw "browser-checked?: checkbox or radio required"))))
(defn jcore-match-run [args closest]
  (let [node (jcore-inspect-node (j-host-at args 0)) selector (j-host-at args 1)]
    (if (j-host-not (and (j-host-eq (j-host-len args) 2) (j-host-element? node) (j-host-eq (j-host-type selector) "string")))
      (throw "browser-match: element and selector required") nil)
    (try
      (if closest
        (let [found (j-host-closest node selector)]
          (if (j-host-weak-has jcore-parsed-nodes (j-host-at args 0)) (jcore-wrap-node found) found))
        (j-host-matches node selector))
      (catch error (throw "browser-match: invalid selector")))))
(defn jcore-matches [args] (jcore-match-run args false))
(defn jcore-closest [args] (jcore-match-run args true))
(defn jcore-contains [args]
  (let [parent (jcore-inspect-node (j-host-at args 0)) child (jcore-inspect-node (j-host-at args 1))]
    (if (and (j-host-eq (j-host-len args) 2) (j-host-node? parent) (j-host-node? child))
      (j-host-dom-contains parent child) (throw "browser-contains?: two nodes required"))))
(defn jcore-outer-html [args]
  (let [node (jcore-node-arg args)]
    (if (j-host-element? node) (j-host-at node "outerHTML") (throw "browser-outer-html: element required"))))
(defn jcore-html-fragment [text]
  (let [template (j-host-dom-create "template")]
    (do (j-host-set! template "innerHTML" text) (j-host-at template "content"))))
(defn jcore-parse-html [args]
  (if (and (j-host-eq (j-host-len args) 1) (j-host-eq (j-host-type (j-host-at args 0)) "string"))
    (jcore-wrap-node (jcore-html-fragment (j-host-at args 0))) (throw "browser-parse-html: one string required")))
(defn jcore-http-url? [value own]
  (try
    (let [url (j-host-url value) protocol (j-host-at url "protocol")]
      (and (or (j-host-eq protocol "http:") (j-host-eq protocol "https:"))
           (or (j-host-not own) (j-host-eq (j-host-at url "origin") (j-host-origin)))))
    (catch error false)))
(defn jcore-srcset-safe? [value]
  (let [candidates (j-host-split value ",")]
    (loop [index 0]
      (if (j-host-lt index (j-host-len candidates))
        (let [part (j-host-trim (j-host-at candidates index))
              pieces (j-host-split part " ") first (j-host-at pieces 0)]
          (if (and (j-host-lt 0 (j-host-len first)) (jcore-http-url? first true))
            (recur (j-host-add index 1)) false)) true))))
(define jcore-html-forbidden {"SCRIPT" true "STYLE" true "IFRAME" true "OBJECT" true "EMBED" true
  "LINK" true "META" true "BASE" true "FRAME" true "FRAMESET" true "APPLET" true "TEMPLATE" true})
(define jcore-html-style-properties {"width" true "max-width" true "height" true "margin-left" true "margin-right" true
  "display" true "grid-template-columns" true "gap" true "outline" true "text-align" true "color" true
  "font-size" true "font-weight" true "font-style" true "text-decoration" true "white-space" true
  "object-fit" true "vertical-align" true})
(defn jcore-html-style-safe? [node]
  (let [style (j-host-at node "style")]
    (loop [index 0]
      (if (j-host-lt index (j-host-len style))
        (let [property (j-host-at style index)]
          (if (and (j-host-own? jcore-html-style-properties property)
                   (j-host-css-supports property (j-host-style-value style property)))
            (recur (j-host-add index 1)) false)) true))))
(defn jcore-html-safe? [node]
  (let [kind (j-host-at node "nodeType") element (j-host-element? node)]
    (and
      (or (j-host-eq kind 3) (j-host-eq kind 8) (j-host-eq kind 11)
        (and element (j-host-eq (j-host-at node "namespaceURI") "http://www.w3.org/1999/xhtml")
          (j-host-not (j-host-own? jcore-html-forbidden (j-host-at node "tagName")))
          (let [attributes (j-host-array-from (j-host-at node "attributes"))]
            (loop [index 0]
              (if (j-host-lt index (j-host-len attributes))
                (let [attribute (j-host-at attributes index) name (j-host-lower (j-host-at attribute "name"))
                      value (j-host-at attribute "value")]
                  (if (and (j-host-not (j-host-eq (j-host-substring name 0 2) "on"))
                           (j-host-not (j-host-eq name "srcdoc"))
                           (if (j-host-own? {"href" true "src" true "poster" true "action" true "formaction" true "background" true "xlink:href" true} name)
                             (jcore-http-url? value (j-host-not (j-host-eq name "href")))
                             (if (j-host-eq name "srcset") (jcore-srcset-safe? value)
                               (if (j-host-eq name "style") (jcore-html-style-safe? node) true))))
                    (recur (j-host-add index 1)) false)) true)))))
      (let [children (j-host-array-from (j-host-at node "childNodes"))]
        (loop [index 0]
          (if (j-host-lt index (j-host-len children))
            (if (jcore-html-safe? (j-host-at children index)) (recur (j-host-add index 1)) false) true))))))
(defn jcore-replace-html [args]
  (let [node (j-host-at args 0) text (j-host-at args 1)]
    (if (j-host-not (and (j-host-eq (j-host-len args) 2) (j-host-element? node)
                  (j-host-eq (j-host-at node "namespaceURI") "http://www.w3.org/1999/xhtml")
                  (j-host-not (j-host-own? jcore-html-forbidden (j-host-at node "tagName")))
                  (j-host-eq (j-host-type text) "string")))
      (throw "browser-replace-html!: element and string required") nil)
    (let [fragment (jcore-html-fragment text)]
      (if (jcore-html-safe? fragment)
        (do (j-host-dom-clear! node) (j-host-dom-append! node fragment) nil)
        (throw "browser HTML: executable markup rejected")))))

;; Rich selection retains DOM ranges; plain selection keeps UTF-16 offsets.
(defn jcore-dispatch-input [args]
  (if (jcore-element-args? args 1)
    (do (j-host-dispatch! (j-host-at args 0) (j-host-event-new "input" {"bubbles" true})) nil)
    (throw "browser-dispatch-input!: one element required")))
(defn jcore-set-range-text [args]
  (let [element (jcore-selection-element args 2 2) value (j-host-at args 1)]
    (if (j-host-not (and (j-host-input? element) (j-host-eq (j-host-type value) "string")))
      (throw "browser-set-range-text!: selectable input and string required") nil)
    (jcore-selection-input-check element)
    (j-host-replace-text! element value (j-host-at element "selectionStart") (j-host-at element "selectionEnd") "end") nil))
(defn jcore-selection-save [args]
  (let [root (jcore-selection-element args 1 1) selection (j-host-selection)]
    (if (and (j-host-not (j-host-nullish? selection)) (j-host-lt 0 (j-host-at selection "rangeCount"))
             (j-host-dom-contains root (j-host-at selection "anchorNode"))
             (j-host-dom-contains root (j-host-at selection "focusNode")))
      (let [range (j-host-range-clone (j-host-selection-range selection 0)) token []]
        (j-host-weak-add jcore-opaques token)
        (j-host-weak-set! jcore-rich-ranges token [root range (j-host-at range "startContainer") (j-host-at range "endContainer")]) token) nil)))
(defn jcore-selection-apply [range]
  (let [selection (j-host-selection)]
    (if (j-host-nullish? selection) (throw "browser-selection: selection unavailable")
      (do (j-host-selection-clear! selection) (j-host-selection-add! selection range) nil))))
(defn jcore-selection-restore [args]
  (let [root (jcore-selection-element args 2 2) token (j-host-at args 1)]
    (if (and (j-host-not (j-host-nullish? token))
             (or (j-host-not (j-host-weak-has jcore-rich-ranges token))
                 (j-host-not (j-host-eq root (j-host-at (j-host-weak-get jcore-rich-ranges token) 0)))))
      (throw "browser-selection: range token belongs to another root") nil)
    (j-host-dom-focus! root)
    (let [record (if (j-host-nullish? token) nil (j-host-weak-get jcore-rich-ranges token))
          saved (if (j-host-nullish? record) nil (j-host-at record 1))
          retained (and (j-host-not (j-host-nullish? saved))
                        (j-host-dom-contains root (j-host-at record 2))
                        (j-host-dom-contains root (j-host-at record 3))
                        (j-host-dom-contains root (j-host-at saved "startContainer"))
                        (j-host-dom-contains root (j-host-at saved "endContainer")))
          range (if retained saved (j-host-range))]
      (if retained nil (do (j-host-range-select! range root) (j-host-range-collapse! range false)))
      (jcore-selection-apply range))))
(defn jcore-selection-node [args]
  (let [root (jcore-selection-element args 2 2) node (j-host-at args 1)]
    (if (j-host-not (and (j-host-node? node) (j-host-not (j-host-eq root node)) (j-host-dom-contains root node)))
      (throw "browser-selection-node!: child of connected root required") nil)
    (let [range (j-host-range)]
      (j-host-dom-focus! root) (j-host-range-node! range node) (jcore-selection-apply range))))
(defn jcore-selection-state [args]
  (let [root (jcore-selection-element args 1 1)]
    (if (j-host-input? root)
      (let [selected (jcore-selection-read args)]
        {"collapsed" (j-host-eq (j-host-at selected "start") (j-host-at selected "end"))
         "text" (j-host-at selected "text")})
      (let [selection (j-host-selection)]
        (if (and (j-host-not (j-host-nullish? selection)) (j-host-lt 0 (j-host-at selection "rangeCount"))
                 (j-host-dom-contains root (j-host-at selection "anchorNode"))
                 (j-host-dom-contains root (j-host-at selection "focusNode")))
          {"collapsed" (j-host-eq (j-host-at selection "isCollapsed") true)
           "text" (j-host-range-text (j-host-selection-range selection 0))} nil)))))
(define jcore-commands {"bold" true "italic" true "undo" true "redo" true
  "insertUnorderedList" true "insertOrderedList" true "insertText" true "insertHTML" true "createLink" true "formatBlock" true})
(defn jcore-exec [args]
  (let [root (jcore-selection-element args 3 3) command (j-host-at args 1) value (j-host-at args 2)]
    (if (j-host-not (and (j-host-eq (j-host-at root "isContentEditable") true)
             (j-host-eq (j-host-type command) "string") (j-host-own? jcore-commands command)
             (or (j-host-nullish? value) (j-host-eq (j-host-type value) "string"))))
      (throw "browser-exec!: editable root, allowed command and string or nil required") nil)
    (if (j-host-own? {"insertText" true "insertHTML" true "createLink" true "formatBlock" true} command)
      (if (j-host-not (j-host-eq (j-host-type value) "string")) (throw "browser-exec!: command requires a string") nil) nil)
    (if (j-host-eq command "insertHTML")
      (if (jcore-html-safe? (jcore-html-fragment value)) nil (throw "browser HTML: executable markup rejected")) nil)
    (if (and (j-host-eq command "createLink") (j-host-not (jcore-http-url? value false)))
      (throw "browser URL: protocol or image origin rejected") nil)
    (if (and (j-host-eq command "formatBlock")
             (j-host-not (j-host-own? {"p" true "h2" true "h3" true "blockquote" true "pre" true} value)))
      (throw "browser-exec!: unsupported block") nil)
    (let [selection (j-host-selection)]
      (if (and (j-host-not (j-host-nullish? selection))
               (j-host-dom-contains root (j-host-at selection "anchorNode"))
               (j-host-dom-contains root (j-host-at selection "focusNode")))
        (j-host-command command false value) false))))
(defn jcore-document-on [args]
  (let [name (j-host-at args 0) callback (j-host-at args 1)]
    (if (and (j-host-eq (j-host-len args) 2) (j-host-eq name "selectionchange") (j-host-eq (j-host-type callback) "function"))
      (let [target (j-host-document) token [] listener (fn [event] (callback event))]
        (j-host-dom-on! target name listener)
        (j-host-weak-set! jcore-listeners token [target name listener true]) token)
      (throw "browser-document-on!: selectionchange and function required"))))
(defn jcore-event-modifiers [args]
  (let [event (jcore-event args)]
    {"ctrl" (j-host-eq (j-host-at event "ctrlKey") true) "meta" (j-host-eq (j-host-at event "metaKey") true)}))
(defn jcore-event-clipboard-text [args]
  (if (j-host-not (j-host-eq (j-host-len args) 1)) (throw "browser clipboard: ClipboardEvent required") nil)
  (try
    (let [data (j-host-clipboard-data (j-host-at args 0))]
      (if (j-host-nullish? data) (throw "browser clipboard: ClipboardEvent required") (j-host-clipboard-text data "text/plain")))
    (catch error (throw "browser clipboard: ClipboardEvent required"))))
(defn jcore-before-unload [args]
  (let [callback (j-host-at args 0)]
    (if (j-host-not (and (j-host-eq (j-host-len args) 1) (j-host-eq (j-host-type callback) "function")))
      (throw "browser-before-unload!: predicate function required") nil)
    (let [target (j-host-window) token [] listener (fn [event]
          (let [dirty (callback)]
            (if (j-host-not (j-host-eq (j-host-type dirty) "boolean"))
              (throw "browser-before-unload!: predicate must return boolean") nil)
            (if dirty (do (j-host-prevent-default! event) (j-host-set! event "returnValue" "")) nil)))]
      (j-host-dom-on! target "beforeunload" listener)
      (j-host-weak-set! jcore-listeners token [target "beforeunload" listener true]) token)))
(defn jcore-prompt [args]
  (if (and (j-host-eq (j-host-len args) 2) (j-host-eq (j-host-type (j-host-at args 0)) "string")
           (j-host-eq (j-host-type (j-host-at args 1)) "string"))
    (j-host-prompt (j-host-at args 0) (j-host-at args 1)) (throw "browser-prompt: message and initial string required")))
(defn jcore-url-info [args]
  (let [size (j-host-len args) value (j-host-at args 0) relative (if (j-host-eq size 2) (j-host-at args 1) false)]
    (if (j-host-not (and (or (j-host-eq size 1) (j-host-eq size 2))
             (j-host-eq (j-host-type value) "string") (j-host-eq (j-host-type relative) "boolean")))
      (throw "browser URL: absolute http/https URL required") nil)
    (try
      (let [url (if relative (j-host-url value) (j-host-url-absolute value)) protocol (j-host-at url "protocol")]
        (if (or (j-host-eq protocol "http:") (j-host-eq protocol "https:"))
          {"href" (j-host-at url "href") "protocol" protocol "pathname" (j-host-at url "pathname") "origin" (j-host-at url "origin")}
          (throw "browser URL: absolute http/https URL required")))
      (catch error (throw "browser URL: absolute http/https URL required")))))
(defn jcore-uri-run [args link]
  (if (j-host-not (and (j-host-eq (j-host-len args) 1) (j-host-eq (j-host-type (j-host-at args 0)) "string")))
    (throw "browser URI: valid string required") nil)
  (try (if link (j-host-uri-link (j-host-at args 0)) (j-host-uri-component (j-host-at args 0)))
    (catch error (throw "browser URI: valid string required"))))
(defn jcore-uri-encode [args] (jcore-uri-run args false))
(defn jcore-uri-link-encode [args] (jcore-uri-run args true))
(defn jcore-real-file? [value]
  (try (do (j-host-file-name value) true) (catch error false)))
(defn jcore-file [args]
  (let [input (j-host-at args 0)]
    (if (and (j-host-eq (j-host-len args) 1) (j-host-element? input)
             (j-host-eq (j-host-at input "tagName") "INPUT") (j-host-eq (j-host-at input "type") "file"))
      (let [file (j-host-at (j-host-at input "files") 0)] (if (j-host-nullish? file) nil file))
      (throw "browser-file: file input required"))))
(defn jcore-file-info [args]
  (let [file (j-host-at args 0)]
    (if (and (j-host-eq (j-host-len args) 1) (jcore-real-file? file))
      {"name" (j-host-file-name file) "type" (j-host-at file "type") "size" (j-host-at file "size")}
      (throw "browser-file-info: File required"))))

;; Upload shares task cancellation, but clears XHR closures before abort/delivery.
(defn jcore-upload-release [state]
  (j-host-set! state 0 true)
  (j-host-timer-clear (j-host-at state 4))
  (let [xhr (j-host-at state 3)]
    (if (j-host-nullish? xhr) nil
      (do (j-host-set! xhr "onload" nil) (j-host-set! xhr "onerror" nil)
          (j-host-set! xhr "ontimeout" nil) (j-host-set! xhr "onabort" nil)
          (j-host-set! (j-host-at xhr "upload") "onprogress" nil))))
  (j-host-set! state 1 nil) (j-host-set! state 2 nil) (j-host-set! state 3 nil) (j-host-set! state 4 nil))
(defn jcore-upload [args]
  (let [url (j-host-at args 0) options (j-host-at args 1) fields (j-host-at args 2)
        file (j-host-at args 3) callback (j-host-at args 4) progress (j-host-at args 5)]
    (if (j-host-not (and (j-host-eq (j-host-len args) 6) (j-host-eq (j-host-type url) "string")
             (j-host-not (j-host-nullish? options)) (j-host-plain? options)
             (j-host-not (j-host-nullish? fields)) (j-host-plain? fields)
             (jcore-real-file? file) (j-host-eq (j-host-type callback) "function") (j-host-eq (j-host-type progress) "function")))
      (throw "browser-upload!: invalid arguments") nil)
    (let [delay (if (j-host-own? options "timeout") (j-host-at options "timeout") 0)
          file-field (j-host-at options "file-field") keys (j-host-keys fields) option-keys (j-host-keys options)]
      (if (j-host-not (and (j-host-integer? delay) (j-host-gte delay 0) (j-host-lt delay 2147483648)
               (j-host-eq (j-host-type file-field) "string") (j-host-lt 0 (j-host-len file-field))
               (j-host-not (j-host-own? fields file-field))
               (loop [index 0]
                 (if (j-host-lt index (j-host-len option-keys))
                   (if (j-host-own? {"file-field" true "timeout" true} (j-host-at option-keys index)) (recur (j-host-add index 1)) false) true))
               (loop [index 0]
                 (if (j-host-lt index (j-host-len keys))
                   (if (j-host-eq (j-host-type (j-host-at fields (j-host-at keys index))) "string") (recur (j-host-add index 1)) false) true))))
        (throw "browser-upload!: invalid arguments") nil)
      (let [parsed (try (j-host-url url) (catch error (throw "browser-upload!: same-origin URL required")))]
        (if (j-host-not (and (or (j-host-eq (j-host-at parsed "protocol") "http:") (j-host-eq (j-host-at parsed "protocol") "https:"))
                 (j-host-eq (j-host-at parsed "origin") (j-host-origin))
                 (j-host-eq (j-host-at parsed "username") "") (j-host-eq (j-host-at parsed "password") "")))
          (throw "browser-upload!: same-origin URL required") nil)
        (let [xhr (j-host-xhr-new) token [] state [false callback progress xhr nil]
              finish (fn [result]
                (if (j-host-at state 0) nil
                  (let [deliver (j-host-at state 1)] (jcore-upload-release state) (j-host-call deliver [result]))))]
          (j-host-weak-set! jcore-uploads token state)
          (j-host-set! state 4 (j-host-timer-set (fn []
            (if (j-host-at state 0) nil
              (do
                (j-host-set! state 4 nil)
                (try
                  (let [data (j-host-form-new)]
                    (loop [index 0]
                      (if (j-host-lt index (j-host-len keys))
                        (let [key (j-host-at keys index)]
                          (j-host-form-set! data key (j-host-at fields key)) (recur (j-host-add index 1))) nil))
                    (j-host-form-set! data file-field file)
                    (j-host-xhr-open! xhr "POST" (j-host-at parsed "href") true)
                    (j-host-set! xhr "timeout" delay)
                    (j-host-set! xhr "onload" (fn []
                      (let [status (j-host-at xhr "status") ok (and (j-host-gte status 200) (j-host-lt status 300))]
                        (finish {"ok" ok "status" status "body" (j-host-at xhr "responseText") "error" (if ok nil "http")}))))
                    (j-host-set! xhr "onerror" (fn [] (finish {"ok" false "status" 0 "body" "" "error" "network"})))
                    (j-host-set! xhr "onabort" (fn [] (finish {"ok" false "status" 0 "body" "" "error" "network"})))
                    (j-host-set! xhr "ontimeout" (fn [] (finish {"ok" false "status" 0 "body" "" "error" "timeout"})))
                    (j-host-set! (j-host-at xhr "upload") "onprogress" (fn [event]
                      (if (j-host-at state 0) nil
                        (try (j-host-call (j-host-at state 2)
                          [{"loaded" (j-host-at event "loaded") "total" (j-host-at event "total")
                            "length-computable" (j-host-eq (j-host-at event "lengthComputable") true)}])
                          (catch error (do (jcore-upload-release state) (j-host-abort xhr) (throw error)))))))
                    (j-host-xhr-send! xhr data))
                  (catch error (finish {"ok" false "status" 0 "body" "" "error" "network"})))))) 0))
          token)))))
