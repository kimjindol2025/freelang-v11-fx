;; ============================================================
;; P0 PATCH TEST CASES
;; FreeLang v11 & cgc 모두에서 실행 검증 필수
;; ============================================================

;; TEST 1: P0-3 — docstring 인식 + 다중 표현식
;; ============================================================
(comment "
테스트 목적: defn 본문의 모든 표현식이 실행되는가?
            첫 줄이 문자열이면 docstring으로 인식되는가?

예상 결과:
- \"단계 1\" → 출력
- \"단계 2\" → 출력
- \"단계 3\" → 출력
- 반환값 → 6
")

(define test-counter (atom 0))

(defn test-p0-3-docstring []
  "multi-statement function with docstring"
  (do
    (println "단계 1: docstring 검증")
    (swap! test-counter inc)
    (println "단계 2: 중간 로직 실행")
    (swap! test-counter inc)
    (println "단계 3: 마지막 로직")
    (swap! test-counter inc)
    @test-counter))

;; 테스트 실행
(defn run-p0-3 []
  (do
    (println "[P0-3] docstring + multi-statement test")
    (reset! test-counter 0)
    (let [[$result (test-p0-3-docstring)]]
      (if (= $result 3)
        (println "✅ P0-3 PASS: 모든 표현식 실행, counter=3")
        (println (str "❌ P0-3 FAIL: counter=" $result " (기대값: 3)"))))))

;; ============================================================
;; TEST 2: P0-2 — try-map 패턴
;; ============================================================
(comment "
테스트 목적: try 본문에 맵 리터럴을 직접 사용할 수 있는가?

예상 결과 (cgc 패치 후):
- {:ok true :result 42} → 직접 사용 가능
- catch 블록도 맵 리터럴 직접 사용 가능

v11에서는 이미 작동하지만, cgc는 파싱 오류 발생
")

(defn test-p0-2-try-map []
  (try
    (do
      (println "[P0-2] try-map literal test")
      {:ok true :value 42 :msg "success"})
    (catch $e
      (do
        (println (str "caught: " $e))
        {:ok false :error (str $e)}))))

;; 테스트 실행
(defn run-p0-2 []
  (let [[$result (test-p0-2-try-map)]]
    (if (and (not (nil? $result))
             (= (get $result "ok") true)
             (= (get $result "value") 42))
      (println "✅ P0-2 PASS: try-map literal works")
      (println (str "❌ P0-2 FAIL: result=" $result)))))

;; ============================================================
;; TEST 3: P0-1 — defn multiple expressions (재검증)
;; ============================================================
(comment "
테스트 목적: defn 본문의 순서대로 모든 표현식이 실행되는가?

현재 cgc 상태:
- P0-3 패치 전: defn 첫 줄만 실행 (나머지 무시)
- P0-3 패치 후: do로 감싸지면서 자동 해결

재검증: defn-do 함정 재현
")

(define exec-log (atom []))

(defn step-1 []
  (do
    (println "step-1 실행")
    (swap! exec-log (fn [l] (append l "step-1")))))

(defn step-2 []
  (do
    (println "step-2 실행")
    (swap! exec-log (fn [l] (append l "step-2")))))

(defn step-3 []
  (do
    (println "step-3 실행")
    (swap! exec-log (fn [l] (append l "step-3")))
    "result"))

(defn process-with-steps []
  ;; ❌ cgc without P0-3 patch: only step-1 runs
  ;; ✅ cgc with P0-3 patch: all steps run (wrapped in do)
  (do
    (step-1)
    (step-2)
    (step-3)))

;; 테스트 실행
(defn run-p0-1 []
  (do
    (println "[P0-1] defn multiple expressions test")
    (reset! exec-log [])
    (process-with-steps)
    (let [[$log @exec-log]]
      (if (= (length $log) 3)
        (println (str "✅ P0-1 PASS: all 3 steps executed, log=" $log))
        (println (str "❌ P0-1 FAIL: only " (length $log) " steps executed, log=" $log))))))

;; ============================================================
;; MAIN TEST RUNNER
;; ============================================================

(defn run-all-tests []
  (do
    (println "")
    (println "════════════════════════════════════════════")
    (println "P0 PATCH TEST SUITE (2026-06-26)")
    (println "════════════════════════════════════════════")
    (println "")
    (run-p0-1)
    (println "")
    (run-p0-2)
    (println "")
    (run-p0-3)
    (println "")
    (println "════════════════════════════════════════════")
    (println "테스트 완료")))

;; v11에서 실행:
;;   node bootstrap.js run P0-PATCH-TESTS.fl
;;
;; cgc에서 실행 (패치 적용 후 253 노드):
;;   bash fl-build.sh P0-PATCH-TESTS.fl test-p0
;;   ./test-p0
