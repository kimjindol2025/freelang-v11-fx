;; ============================================================
;; FX-TRAPS.airc  v1
;; FreeLang fx 함정(trap) 명세 — 기계 판독 가능 단일 진실 공급원
;;
;; 용도:
;;   - AIRC Single Source of Truth (함정 진실)
;;   - fl-lint.sh 검사 기준 (lint_detectable: true 인 것)
;;   - 런타임 수정 우선순위 기준 (trap > lock > decision > fact)
;;   - 미래 워커 handoff 자동 로드 기준
;;
;; 원칙: 모든 trap 은 claimed(믿은 것) vs observed(본 것) 를 분리한다.
;;       claimed ≠ observed. 추측을 명세로 굳히지 않는다.
;; ============================================================

@meta
  version: 2
  created: 2026-06-16
  updated: 2026-06-20
  source_of_truth: true
  node_priority: [trap, lock, decision, fact]
  consumers: [fl-lint.sh, runtime-fix-priority, worker-handoff]
  required_fields_trap: [id, type, claimed, observed, risk, rule, lint_detectable, reproduction]
  trap_count: 27
  updated: 2026-06-21
  verified_stdlib: verified-stdlib.md
  maturation_phase: phase1_complete
  next_phases: [phase2=stdlib-fixes, phase3=cgc-http-remap, phase4=cache-cgc-port]

;; ─────────────────────── TRAPS ───────────────────────
;; 우선순위 최상위. "이렇게 하면 조용히 깨진다"의 목록.

@trap
  id: trap-defn-do
  type: trap
  claimed: defn 본문은 Clojure식 implicit-do (다중 표현식 순차 실행)
  observed: cgc는 본문을 단일 표현식으로 컴파일 — 첫 줄만 실행되고 나머지는 침묵 소멸 (exit 0, 에러 없음)
  risk: 함수 중간 로직이 통째로 누락. 빌트인 버그로 오인하기 쉬움
  rule: defn 본문에 표현식이 둘 이상이면 반드시 (do ...) 또는 let 본문으로 감싼다
  safe_pattern: (defn f [] (do (a) (b) (c)))
  lint_detectable: true

@trap
  id: trap-count-type
  type: trap
  claimed: count 는 fx 빌트인이라 native 호출된다
  observed: 설치본 cgc 가 count 를 모름 → fl_fn_call(count) 생성 → C 함수 타입 불일치로 gcc 에러
  risk: 빌드 실패. map 은 fl_map_fn 으로 정상이라 더 헷갈림
  rule: 길이는 SQL COUNT 또는 length 로. count 직접 사용 금지(설치본 cgc 기준)
  safe_pattern: (get (sqlite_one db "SELECT COUNT(*) AS c FROM t") "c")
  lint_detectable: true

@trap
  id: trap-kebab-symbol
  type: trap
  claimed: server-get / json-stringify 등 kebab-case 가 fx 에서도 동작한다 (v11 습관)
  observed: fx 는 underscore. kebab 심볼은 파서/코드젠에서 미정의 처리 또는 라우트 fn 인라인 거부
  risk: 컴파일 오류 또는 미정의 이름. v11 코드 복붙 시 빈번
  rule: fx API 는 underscore (server_get) + 핸들러는 문자열 이름. 인라인 fn 핸들러 금지
  safe_pattern: (server_get "/" "handle-index")
  lint_detectable: true

@trap
  id: trap-str-includes-int
  type: trap
  claimed: str_includes 는 boolean 을 반환한다
  observed: str_includes 는 C int (0/1) 를 반환한다
  risk: (if (str_includes ...)) 가 타입/진리값 불일치로 오작동
  rule: if 에 직접 쓰지 말고 명시적으로 1 과 비교한다
  safe_pattern: (if (= (str_includes x y) 1) ...)
  lint_detectable: true

@trap
  id: trap-throw-invalid-initializer
  type: trap
  claimed: throw 는 정상 제어 흐름으로 컴파일된다
  observed: throw 가 invalid C initializer 를 생성할 수 있다 (코드젠 깨짐)
  risk: 빌드 실패 또는 정의되지 않은 동작
  rule: throw 대신 nil/false 반환으로 오류 신호. (lock-no-throw 참조)
  safe_pattern: (if 오류조건 nil 정상값)
  lint_detectable: true

@trap
  id: trap-free-locale
  type: trap
  claimed: free 명령 출력은 고정 포맷이라 파싱 가능하다
  observed: free 출력은 locale 에 의존한다 (헤더/단위가 환경마다 다름)
  risk: 메모리 수치 파싱이 노드/locale 따라 깨짐
  rule: free 출력 파싱 금지. /proc/meminfo 를 직접 읽는다 (MemTotal/MemAvailable)
  safe_pattern: awk '/MemTotal/{t=$2}/MemAvailable/{a=$2}END{print (1-a/t)*100}' /proc/meminfo
  lint_detectable: false

@trap
  id: trap-runtime-header
  type: trap
  claimed: shell_run 같은 빌트인이 환경에 없다 (조사 시 안 보임)
  observed: shell_run/future/sleep_ms 는 aliases.c 에 실재 — process.c 만 보고 결론낸 조사범위 한계였음
  risk: 있는 기능을 "없다"로 단정 → 불필요한 우회 설계. (실제 2026-06-15 사례)
  rule: 빌트인 부재를 단정하기 전 aliases.c(897줄) 전수 확인. 새 runtime 함수 추가 시 체크리스트 강제(lock-runtime-checklist)
  safe_pattern: grep -rn 'FLValue <name>' runtime/*.c  ;; 결론 전 전수 확인
  lint_detectable: false

@trap
  id: trap-extern-flvalue-defn
  type: trap
  claimed: sqlite_* / server_req_body 를 defn 내부에서 직접 호출하면 native call 된다
  observed: 이들은 extern FLValue. 설치본 cgc 는 fl_fn_call 로 생성 → 함수 포인터 타입 불일치
  risk: 빌드 실패. 신 cgc 노드는 fxb_ native, 구 cgc 노드(이 aarch64)는 shim 필요 = 노드별 분기
  rule: 신 cgc 노드는 fxb_sqlite_* 직접. 구 cgc 노드는 sqlite_* + fx-builtin-shim.c. 어느 노드인지 먼저 확인
  safe_pattern: (sqlite_query_p db "..." (list $id))  ;; + 빌드에 fx-builtin-shim.c
  lint_detectable: false

@trap
  id: trap-server-json-string
  type: trap
  claimed: server_json 에 맵/벡터를 직접 줄 수 있다 (v11 습관)
  observed: server_json 은 이미 직렬화된 문자열만 받는다. 맵 직접 전달 시 Content-Length 0 빈 응답
  risk: 조용한 빈 응답 (false-200)
  rule: 반드시 json_stringify 로 감싼다
  safe_pattern: (server_json (json_stringify {"ok" true}))
  lint_detectable: true

@trap
  id: trap-server-html-quote
  type: trap
  claimed: server_html 문자열 안에 \" 더블쿼트를 자유롭게 쓸 수 있다
  observed: FL 문자열 파서가 HTML 안의 " 를 문자열 끝으로 인식 → 파싱 깨짐
  risk: 컴파일/파싱 오류
  rule: HTML 속성은 single-quote, JS 는 백틱/single-quote. FL 문자열 안엔 " 를 두지 않는다
  safe_pattern: (server_html "<div onclick='f(p.id)'>...")
  lint_detectable: true

@trap
  id: trap-lambda-capture
  type: trap
  claimed: defn 파라미터를 람다 본문에서 그대로 참조할 수 있다
  observed: defn 파라미터가 C 클로저 env 에 추가되지 않는 캡처 버그 (일부 cgc)
  risk: 컴파일 에러(미등록 변수) 또는 잘못된 값
  rule: 파라미터를 atom 에 저장 후 deref, 또는 fxb_ 패턴 회피. (BUG-04 로 cgc 수정 진행 중)
  safe_pattern: (define $a (atom v)) ... (let [$m @$a] ...)
  lint_detectable: false

@trap
  id: trap-mariadb-count-float
  type: trap
  claimed: COUNT(*) 반환은 정수다
  observed: MariaDB COUNT 반환 타입이 float 일 수 있다
  risk: (= $cnt 0) 비교 실패
  rule: 문자열 변환 후 비교 또는 nil 체크
  safe_pattern: (if (or (nil? $cnt) (= (str $cnt) "0")) ...)
  lint_detectable: false

@trap
  id: trap-replace-all-rename
  type: trap
  claimed: replace_all 로 테이블명/문자열만 치환된다
  observed: 함수명도 함께 치환됨 (plans → fx_plans 시 defn plans-all 오염)
  risk: 함수명 오염으로 미정의 호출
  rule: 치환 후 grep 으로 함수명 오염 확인. 패턴을 구체적으로 지정
  safe_pattern: grep -n "defn fx_" *.fl  ;; 치환 후 확인
  lint_detectable: false

@trap
  id: trap-string-literal-1024
  type: trap
  claimed: 임의 길이 문자열 리터럴을 한 토큰으로 쓸 수 있다
  observed: 단일 문자열 리터럴 >1024B → cgc tmpfile() 폴백 → PRoot 에서 'cannot write temp file'
  risk: 빌드 실패. 큰 HTML/JS 블록에서 발생
  rule: 큰 문자열은 (str "조각1" "조각2" ...) 로 분할 (각 조각 <1024B)
  safe_pattern: (server_html (str "<html>...\n" "...\n" "..."))
  lint_detectable: true

@trap
  id: trap-cgc-stale-node
  type: trap
  claimed: 함정의 원인이 언어 설계 결함이다
  observed: 대부분 이 aarch64 노드의 cgc-bin 이 구버전이라 발생 (소스 cgc-main.fl 엔 수리 존재) = 전파 지연
  risk: 언어 탓으로 결론내고 우회 설계. 실제론 컴파일러 날짜 문제
  rule: 함정을 언어 탓 하기 전 cgc-bin 날짜 + cgc-main.fl 소스 대조. runtime/*.c 는 노드에서 즉시 컴파일되니 런타임 레벨은 바로 고침
  safe_pattern: ls -la /root/freelang-v11/bin/cgc-bin  ;; 날짜 먼저 확인
  lint_detectable: false

;; ─────────── TRAPS 추가 (2026-06-20 성숙화 실측) ───────────

@trap
  id: trap-set-interval-swallow
  type: trap
  claimed: set_interval 콜백에서 throw 하면 인터벌이 중단된다
  observed: throw 발생 시 "set_interval callback error" stderr 출력 후 다음 틱 계속 실행 — 인터벌 절대 중단 안 됨
  risk: 데몬 로직에서 throw로 중단 시도 시 조용히 무시됨. 보안 탐지 코드에서 치명적 — crash 아닌 silentskipped-cycle 상태로 영구 계속됨
  rule: set_interval 콜백 안에서 throw 금지. 중단 신호는 atom 플래그로 전달하고 콜백 첫 줄에서 확인
  safe_pattern: (define *stop* (atom false)) (set_interval (fn [] (if @*stop* nil (do ...))) ms)
  reproduction: 2026-06-20 실측 — tick 3에서 throw, stderr에 오류 출력, tick 4 계속 실행 확인
  lint_detectable: true

@trap
  id: trap-nth-out-of-bounds
  type: trap
  claimed: nth 로 범위 밖 인덱스 접근 시 오류가 발생한다
  observed: nil 을 반환한다 (에러 없음). (nil? (nth v 999)) → true
  risk: 배열 경계 검사를 오류 catch 로 구현 시 항상 통과. 잘못된 인덱스가 nil 로 조용히 전파됨
  rule: nth 사용 전 (< idx (length v)) 로 경계 검사. 반환값 nil 가능성 항상 가정
  safe_pattern: (if (< $i (length $v)) (nth $v $i) default-val)
  reproduction: 2026-06-20 실측 — (nth [10 20 30] 5) → null, (nil? ...) → true
  lint_detectable: false

@trap
  id: trap-try-map-literal
  type: trap
  claimed: try 본문에 맵 리터럴 {..} 을 직접 쓸 수 있다
  observed: v11 파서가 try 본문 위치에서 LBrace 를 예상치 못해 E_PARSE_UNEXPECTED_TOKEN 발생
  risk: try 안에서 맵 반환 패턴(ok/error 래핑) 전체 사용 불가
  rule: try 본문에 {..} 직접 금지. (hash-map "k" v) 또는 변수를 앞에서 바인딩 후 사용
  safe_pattern: (try (hash-map "ok" true "val" (fn-to-call)) (catch err (hash-map "ok" false "err" err)))
  reproduction: 2026-06-20 실측 — (try {:ok true} (catch err ...)) → 파싱 오류
  lint_detectable: true

@trap
  id: trap-nested-defn-skip
  type: trap
  claimed: defn 내부에 defn 을 중첩하면 로컬 함수처럼 동작한다
  observed: cgc 가 "/* defn inside expr — skip */fl_nil()" 을 생성. 외부 defn 이 nil 반환
  risk: retry, recursive helper 같은 중첩 함수 패턴 전체 silent-fail
  rule: 모든 defn 은 최상위 레벨에 정의. 내부 함수가 필요하면 prefix 로 구분
  safe_pattern: (defn retry-inner [attempt] ...) (defn retry [fn opts] (retry-inner 1))
  reproduction: 2026-06-20 실측 — cgc 생성 C 코드에서 확인
  lint_detectable: true

@trap
  id: trap-inc-dec-missing
  type: trap
  claimed: inc / dec 는 FreeLang 기본 빌트인이다 (Clojure 스타일)
  observed: v11 인터프리터와 cgc 양쪽에서 'inc' 함수 없음 오류 발생
  risk: queue/stack 구현, 카운터 증감 로직 전체가 런타임 오류
  rule: (inc x) → (+ x 1) 로, (dec x) → (- x 1) 로 모두 대체
  safe_pattern: (defn inc [n] (+ n 1))  ;; 또는 (+ $cnt 1) 직접 사용
  reproduction: 2026-06-20 실측 — queue.fl 로드 시 [queue-push] [inc] 없음 오류
  lint_detectable: true

@trap
  id: trap-cache-cgc-missing
  type: trap
  claimed: cache-create / cache-set / cache-get 등은 cgc 에서도 동작한다
  observed: 이 함수들은 v11 인터프리터 전용 빌트인. cgc 런타임(runtime.h/aliases.c)에 없음 → 링크 실패 또는 fl_fn_call 타입 오류
  risk: cache.fl 전체가 cgc 에서 dead code
  rule: cgc 앱에서 캐시가 필요하면 SQLite 기반 또는 맵+atom 직접 구현
  safe_pattern: (define *cache* (atom {})) (defn cache-get! [k] (get (deref *cache*) k))
  reproduction: 2026-06-20 실측 — cgc 빌드 시 fl_fn_call(cache_create,...) 링크 오류
  lint_detectable: false

@trap
  id: trap-http-get-cgc-mapping
  type: trap
  claimed: (http_get url) 는 cgc 에서 {status body headers} 맵을 반환한다
  observed: cgc-main.fl:992 가 http-get/http_get 을 fl_http_get (http.c) 으로 변환 — 이 함수는 문자열 body 만 반환 (맵 아님). (get result "status") → nil
  risk: http 응답 상태코드 확인 불가. 정상 응답도 nil 처리됨
  rule: cgc 에서 http 결과를 맵으로 쓰지 말 것. 현재 cgc http_get 은 body string 전용으로만 사용. 맵이 필요하면 http_client.c 의 http_get 을 직접 노출하는 패치 필요
  safe_pattern: (define $body (http_get "http://..."))  ;; string 반환, nil 체크 후 사용
  reproduction: 2026-06-20 실측 — cgc 생성 C에 fl_http_get 호출 확인, (get result "status") → nil
  lint_detectable: false

@trap
  id: trap-parallel-run-missing
  type: trap
  claimed: (parallel-run [fn1 fn2]) 로 병렬 실행이 가능하다 (stdlib/parallel.fl)
  observed: parallel.fl 내부가 run-parallel 빌트인을 래핑하는데, run-parallel 자체가 존재하지 않음
  risk: parallel.fl 전체 dead code. 로드는 성공하지만 호출 즉시 런타임 오류
  rule: parallel.fl 사용 금지. 진짜 병렬 실행이 필요하면 shell_run 다중 호출 또는 다른 패턴
  safe_pattern: ;; 현재 fx 에서 진짜 병렬 실행 방법 없음 — 순차 처리 또는 백그라운드 shell_run
  reproduction: 2026-06-20 실측 — [run-parallel] 'run-parallel' 함수 없음 오류
  lint_detectable: true

@trap
  id: trap-atom-deref-gc
  type: trap
  claimed: (reset! ch new-val) 후에도 deref 전에 캡처한 let 바인딩으로 atom 내용을 안전하게 읽을 수 있다
  observed: fl_atom_deref 는 RC 증가 없이 raw pointer를 반환. fl_atom_reset 은 old값 RC-- → 0이면 재귀 free. 따라서 reset! 직후 old 값을 가리키던 C 로컬 변수(st/entries/entry)는 dangling pointer가 됨 → nil/쓰레기 반환
  risk: cache-get/cache-set-or-get 같이 "읽고 → atom 갱신 → 읽은 값 반환" 패턴에서 조용히 nil 반환. 실측: cache-get이 모든 키에 nil 반환
  rule: reset! 호출 후 old atom 내용이 필요하면 반드시 @ch 로 re-deref(새 heap-safe 포인터). reset! 이전에 read할 값을 추출해도 동일 문제(string/map도 heap-copy 트리에 있어 같이 해제됨)
  safe_pattern: (let [new-st (assoc st "hits" n)] (reset! ch new-st) (get (get (get @ch "entries") key) "val"))
  reproduction: 2026-06-21 실측 — cache-get 전 항목 nil 반환. fl_atom_reset 소스(math.c:215) fl_heap_release(old) 확인
  lint_detectable: false
  scope: cgc-only  ;; v11은 GC 방식이 달라 동일 문제 없음

@trap
  id: trap-defn-throw-rerun
  type: trap
  claimed: v11에서 defn 내부 throw 는 호출 스택 상단으로 전파될 뿐 함수가 재실행되지 않는다
  observed: v11에서 defn 본문 내부에서 throw 가 발생하면 함수 전체가 재실행된다. top-level 직접 호출이든 다른 defn에서 호출이든 무관. max-tries=3 설정 시 fn이 6회(3+3) 호출됨
  risk: 재시도 로직의 호출 횟수 2배. 부작용 있는 함수(DB write, HTTP call, 카운터 증가)가 예상치 못한 횟수만큼 실행됨
  rule: v11에서 부작용 있는 함수에 throw 를 제어 흐름으로 쓰지 말 것. 오류 신호는 {ok false error e} 맵 반환으로 (retry-result / retry-safe 패턴)
  safe_pattern: (defn -retry-core [fn opts] (loop [i 1] (let [r (try (hash-map "ok" true "v" (fn)) (catch e (hash-map "ok" false "e" e)))] (if (get r "ok") r (recur (+ i 1))))))
  reproduction: 2026-06-21 실측 — max-tries=3 시 fn 6회 호출. (atom cnt) + 확인 → cnt=6. 단일 throw defn → fn 2회 실행 확인
  lint_detectable: false
  scope: v11-interpreter-only  ;; cgc 는 미검증 (cgc에서는 throw shim이 다르게 작동할 수 있음)

@trap
  id: trap-defn-docstring-cgc
  type: trap
  claimed: defn 본문에 문서 목적 docstring을 첫 번째 표현식으로 넣어도 실제 구현이 실행된다
  observed: old cgc-bin(cgc-bin.bak)은 defn 내 첫 번째 문자열 리터럴을 함수 본문으로 컴파일. 두 번째 이후 표현식(실제 구현)은 무시됨. 결과: 함수가 docstring 문자열을 반환하며 아무 동작도 안 함
  risk: 모든 함수가 무출력 무동작. 증상=함수 호출 후 아무 출력 없음. 에러 메시지 없음
  rule: cgc 대상 코드에서 defn 내 docstring 완전 제거. 주석(//)으로 대체
  lint_detectable: true
  reproduction: 2026-06-21 실측 — debug-tools.fl 7개 함수 전부 docstring을 body로 취급. inspect/assert 등 전부 docstring 반환하며 무동작 확인
  scope: cgc-only  ;; v11은 docstring 이후 표현식도 실행

@trap
  id: trap-v11-hof-closure-bug
  type: trap
  claimed: v11에서 고차함수(HOF)의 function 파라미터를 클로저로 캡처하면 중첩 호출에서도 올바르게 사용할 수 있다
  observed: v11에서 defn A가 function 파라미터 body-fn을 받아 호출하고, body-fn 내부에서 다시 A를 같은 방식으로 호출할 때 inner A의 body-fn 파라미터가 클로저에서 누락됨. "Function not found: body-fn" 오류 또는 global atom이 심볼명 문자열로 반환됨
  risk: debug-trace 패턴(재귀적 HOF 호출) v11에서 전면 불가. 인덱스 함수 파라미터가 무작위로 소실됨
  rule: v11에서 재귀적 HOF 패턴(body-fn을 받아 같은 함수를 다시 호출하는) 사용 금지. 대안: 인라인 (fn [] ...) 람다 사용(단일 레벨), 또는 global atom 대신 파라미터로 상태 전달
  lint_detectable: false
  reproduction: 2026-06-21 실측 — debug-trace/use-atom 패턴: 3단계 중첩 시 inner body-fn="Function not found", global atom deref → 심볼명 문자열 반환 확인
  scope: v11-interpreter-only  ;; cgc는 top-level defn 방식으로 정상 동작

;; ─────────────────────── LOCKS ───────────────────────
;; 금지/필수 규칙. trap 보다 강하게, "하지 마라/반드시 하라".

@lock
  id: lock-no-throw
  type: lock
  forbid: (throw ...)
  reason: trap-throw-invalid-initializer — invalid C initializer 생성 위험
  instead: nil/false 반환으로 오류 신호
  lint_detectable: true

@lock
  id: lock-no-free-memory
  type: lock
  forbid: free 출력 파싱
  reason: trap-free-locale — locale 의존
  instead: /proc/meminfo 직접 읽기
  lint_detectable: false

@lock
  id: lock-runtime-checklist
  type: lock
  required: [runtime/<name>.c, runtime/runtime.h, runtime/aliases.c, fl-build.sh, verify-fixpoint.sh]
  reason: trap-runtime-header — runtime 함수 추가 시 5곳 동기화 누락하면 빌드/고정점 깨짐
  rule: 새 runtime 빌트인 추가 시 위 5개 파일 모두 갱신했는지 확인
  lint_detectable: false

@lock
  id: lock-str-includes
  type: lock
  forbid: (if (str_includes ...))
  reason: trap-str-includes-int — C int 반환을 진리값으로 직접 쓰면 오작동
  instead: (if (= (str_includes x y) 1) ...)
  lint_detectable: true

;; ─────────────────────── FACTS ───────────────────────
;; 참조 사실 (함정도 규칙도 아니나 handoff 에 필요).

@fact
  id: fact-node-cgc
  type: fact
  statement: 이 노드(/root, aarch64, PRoot)의 설치본 cgc 는 구버전 — sqlite_*/http_get 일부 미지원, fxb_ 패턴 불가
  consequence: 빌드는 .fl-build-root.sh (CGC=/root/...), sqlite 는 fx-builtin-shim.c 필요
  source: 2026-06-15 실측

@fact
  id: fact-trap-source
  type: fact
  statement: 이 명세의 출처는 CLAUDE.md 산문 함정 + 2026-06-14~16 실측 회고(#1076·1077·1081·1082·1107)
  consequence: v2 에서 CLAUDE.md 잔여 함정 + 신규 발견 흡수 예정
  source: fl-cycle handoff
