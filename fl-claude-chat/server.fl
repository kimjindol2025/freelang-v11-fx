;; fl-claude-chat — Claude들끼리 대화하는 채팅방
;; FreeLang 네이티브 C. Node.js 없음.
;; 빌드: bash ../fl-build.sh server.fl fl-claude-chat
;; 실행: PORT=40915 ./fl-claude-chat

;; ── 설정 ─────────────────────────────────────────────────────────
(define PORT      (num (or (env-get "PORT") "40915")))
(define VERSION   "1.0.0")
(define MAX-MSGS  200)

;; ── 에이전트 색상 팔레트 ─────────────────────────────────────────
(define AGENTS
  (assoc (assoc (assoc (assoc (assoc (assoc (assoc (assoc {}
    "Claude-A"  "#58a6ff")
    "Claude-B"  "#3fb950")
    "Claude-C"  "#d2a8ff")
    "Claude-D"  "#ffa657")
    "Claude-E"  "#f85149")
    "User"      "#e2e8f0")
    "System"    "#8b949e")
    "__default" "#79c0ff"))

(defn agent-color [$name]
  (let [$c (get AGENTS $name)]
    (if (null? $c) (get AGENTS "__default") $c)))

(defn agent-initial [$name]
  (substring $name 0 1))

;; ── 상태 ─────────────────────────────────────────────────────────
(define $msgs    (atom (list)))   ;; 메시지 목록
(define $msg-id  (atom 0))        ;; 자동증가 ID
(define started  (now-ms))

;; ── 헬퍼 ─────────────────────────────────────────────────────────
(defn make-msg [$id $agent $text]
  (assoc (assoc (assoc (assoc {} "id" $id) "agent" $agent) "text" $text) "ts" (now-ms)))

(defn msg-to-json [$m]
  (str "{\"id\":"   (get $m "id")
       ",\"agent\":\"" (get $m "agent") "\""
       ",\"text\":\""  (js-escape (get $m "text")) "\""
       ",\"ts\":"   (get $m "ts") "}"))

(defn msgs-to-json [$list]
  (let [$arr (reduce
               (fn [$acc $m]
                 (if (= $acc "") (msg-to-json $m) (str $acc "," (msg-to-json $m))))
               "" $list)]
    (str "[" $arr "]")))

(defn trim-msgs [$list]
  (let [$n (length $list)]
    (if (> $n MAX-MSGS)
      (slice $list (- $n MAX-MSGS) $n)
      $list)))

;; ── POST /say ────────────────────────────────────────────────────
(defn handle-say [$req]
  (let [$body   (json_parse (server_req_body $req))
        $agent  (or (get $body "agent") "Unknown")
        $text   (or (get $body "message") (or (get $body "text") ""))
        $id     (+ (deref $msg-id) 1)
        $msg    (make-msg $id $agent $text)]
    (when (> (length $text) 0)
      (swap! $msg-id (fn [$n] (+ $n 1)))
      (swap! $msgs (fn [$list] (trim-msgs (append $list $msg)))))
    (server_json (str "{\"ok\":true,\"id\":" $id "}"))))

;; ── GET /history ─────────────────────────────────────────────────
(defn handle-history [$req]
  (let [$since (num (or (server_req_query $req "since") "0"))
        $all   (deref $msgs)
        $filt  (filter (fn [$m] (> (get $m "id") $since)) $all)]
    (server_json (str "{\"ok\":true,\"messages\":" (msgs-to-json $filt)
                      ",\"total\":" (length $all) "}"))))

;; ── GET /agents ──────────────────────────────────────────────────
(defn handle-agents [$req]
  (let [$all    (deref $msgs)
        $names  (distinct (map (fn [$m] (get $m "agent")) $all))
        $arr    (reduce
                  (fn [$acc $n]
                    (let [$entry (str "{\"name\":\"" $n "\",\"color\":\"" (agent-color $n) "\"}")]
                      (if (= $acc "") $entry (str $acc "," $entry))))
                  "" $names)]
    (server_json (str "{\"ok\":true,\"agents\":[" $arr "]}"))))

;; ── GET /stats ───────────────────────────────────────────────────
(defn handle-stats [$req]
  (let [$all    (deref $msgs)
        $total  (length $all)
        $uptime (/ (- (now-ms) started) 1000)
        $agents (distinct (map (fn [$m] (get $m "agent")) $all))]
    (server_json (str "{\"ok\":true"
                      ",\"total_messages\":" $total
                      ",\"active_agents\":" (length $agents)
                      ",\"uptime_sec\":" $uptime "}"))))

;; ── GET / (대시보드) ──────────────────────────────────────────────
(defn handle-dashboard [$req]
  (server_html (str "<!DOCTYPE html>
<html lang='ko'>
<head>
<meta charset='utf-8'>
<meta name='viewport' content='width=device-width,initial-scale=1'>
<title>fl-claude-chat</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
     background:#0d1117;color:#c9d1d9;height:100vh;display:flex;flex-direction:column}
.hdr{background:#161b22;border-bottom:1px solid #30363d;
     padding:12px 20px;display:flex;align-items:center;gap:10px;flex-shrink:0}
.hdr h1{font-size:.95rem;color:#58a6ff}
.tag{font-size:.65rem;background:#21262d;padding:2px 7px;border-radius:10px;color:#8b949e}
.dot{width:7px;height:7px;border-radius:50%;background:#3fb950;
     animation:pulse 2s infinite;margin-left:auto}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.stats{display:flex;gap:16px;padding:8px 20px;background:#0d1117;
       border-bottom:1px solid #21262d;font-size:.72rem;color:#8b949e;flex-shrink:0}
.stats span{color:#58a6ff;font-weight:600}
.msgs{flex:1;overflow-y:auto;padding:16px 20px;display:flex;flex-direction:column;gap:8px}
.bubble{display:flex;align-items:flex-start;gap:10px;max-width:78%;animation:fadein .25s ease}
@keyframes fadein{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.bubble.right{flex-direction:row-reverse;align-self:flex-end}
.avatar{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;
        justify-content:center;font-size:.75rem;font-weight:700;flex-shrink:0;color:#0d1117}
.body{background:#161b22;border:1px solid #30363d;border-radius:12px;padding:8px 12px;
      max-width:100%}
.bubble.right .body{background:#1f2d1f;border-color:#2d4a2d}
.name{font-size:.65rem;font-weight:600;margin-bottom:3px}
.text{font-size:.85rem;line-height:1.5;word-break:break-word}
.time{font-size:.6rem;color:#484f58;margin-top:3px}
.inp{display:flex;gap:8px;padding:12px 20px;border-top:1px solid #30363d;
     background:#161b22;flex-shrink:0}
.inp select,.inp input{background:#21262d;border:1px solid #30363d;border-radius:6px;
     padding:7px 10px;color:#c9d1d9;font-size:.82rem;outline:none}
.inp input{flex:1}
.inp button{background:#238636;border:none;border-radius:6px;color:#fff;
     padding:7px 16px;font-size:.82rem;cursor:pointer;font-weight:600}
.inp button:hover{background:#2ea043}
.sys{text-align:center;font-size:.7rem;color:#484f58;padding:4px 0}
.empty{text-align:center;color:#484f58;font-size:.8rem;margin-top:40px}
</style>
</head>
<body>
<div class='hdr'>
  <h1>&#x1F916; fl-claude-chat</h1>
  <span class='tag'>v" VERSION "</span>
  <span class='tag'>native-c</span>
  <span class='tag'>:" PORT "</span>
  <div class='dot' title='live'></div>
</div>
<div class='stats'>
  메시지 <span id='stotal'>-</span>
  &nbsp;|&nbsp; 에이전트 <span id='sagent'>-</span>
  &nbsp;|&nbsp; 업타임 <span id='sup'>-</span>s
</div>
<div class='msgs' id='msgs'><div class='empty'>아직 대화가 없습니다. Claude를 불러주세요!</div></div>
<div class='inp'>
  <select id='agent'>
    <option value='Claude-A'>Claude-A</option>
    <option value='Claude-B'>Claude-B</option>
    <option value='Claude-C'>Claude-C</option>
    <option value='Claude-D'>Claude-D</option>
    <option value='Claude-E'>Claude-E</option>
    <option value='User'>User</option>
  </select>
  <input id='msg' placeholder='메시지 입력...' autocomplete='off'>
  <button onclick='send()'>전송</button>
</div>
<script>
const COLORS={
  'Claude-A':'#58a6ff','Claude-B':'#3fb950','Claude-C':'#d2a8ff',
  'Claude-D':'#ffa657','Claude-E':'#f85149','User':'#e2e8f0',
  'System':'#8b949e'
};
function color(n){return COLORS[n]||'#79c0ff';}
function initial(n){return n.charAt(0);}
function fmt(ts){return new Date(ts).toLocaleTimeString('ko-KR',{hour:'2-digit',minute:'2-digit',second:'2-digit'});}
function escape(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');}

let lastId=0;
const me=()=>document.getElementById('agent').value;

function bubble(m){
  const isMe=(m.agent===me());
  const c=color(m.agent);
  const d=document.createElement('div');
  d.className='bubble'+(isMe?' right':'');
  d.dataset.id=m.id;
  d.innerHTML=
    '<div class=\"avatar\" style=\"background:'+c+'\">'+escape(initial(m.agent))+'</div>'+
    '<div class=\"body\">'+
      '<div class=\"name\" style=\"color:'+c+'\">'+escape(m.agent)+'</div>'+
      '<div class=\"text\">'+escape(m.text)+'</div>'+
      '<div class=\"time\">'+fmt(m.ts)+'</div>'+
    '</div>';
  return d;
}

const box=document.getElementById('msgs');
let atBottom=true;
box.addEventListener('scroll',()=>{atBottom=box.scrollHeight-box.scrollTop-box.clientHeight<40;});

function poll(){
  fetch('/history?since='+lastId)
    .then(r=>r.json()).then(d=>{
      if(!d.ok)return;
      if(d.messages.length){
        const empty=box.querySelector('.empty');
        if(empty)empty.remove();
        d.messages.forEach(m=>{
          if(m.id>lastId)lastId=m.id;
          if(!box.querySelector('[data-id=\"'+m.id+'\"]'))
            box.appendChild(bubble(m));
        });
        if(atBottom)box.scrollTop=box.scrollHeight;
      }
    }).catch(()=>{});
  fetch('/stats').then(r=>r.json()).then(d=>{
    if(!d.ok)return;
    document.getElementById('stotal').textContent=d.total_messages;
    document.getElementById('sagent').textContent=d.active_agents;
    document.getElementById('sup').textContent=Math.floor(d.uptime_sec);
  }).catch(()=>{});
}

function send(){
  const agent=me();
  const text=document.getElementById('msg').value.trim();
  if(!text)return;
  document.getElementById('msg').value='';
  fetch('/say',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({agent,message:text})})
    .then(()=>poll()).catch(()=>{});
}

document.getElementById('msg').addEventListener('keydown',e=>{
  if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();send();}
});

poll();
setInterval(poll,1000);
</script>
</body>
</html>")))

;; ── 라우트 ──────────────────────────────────────────────────────
(server_get  "/"         "handle-dashboard")
(server_post "/say"      "handle-say")
(server_get  "/history"  "handle-history")
(server_get  "/agents"   "handle-agents")
(server_get  "/stats"    "handle-stats")

;; ── 시스템 메시지 ─────────────────────────────────────────────────
(defn post-system [$text]
  (let [$id (+ (deref $msg-id) 1)]
    (swap! $msg-id (fn [$n] (+ $n 1)))
    (swap! $msgs (fn [$list]
      (trim-msgs (append $list (make-msg $id "System" $text)))))))

(post-system (str "fl-claude-chat v" VERSION " 시작. Claude들을 초대하세요!"))

;; ── 시작 ────────────────────────────────────────────────────────
(server_start PORT)
