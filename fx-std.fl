;; ── fx-std.fl — FreeLang fx 표준 라이브러리 ──────────────────────────────
;; 사용법: (load "/home/kimjin/freelang-v11-fx/fx-std.fl")
;;
;; fx 런타임 내장 (여기서 재정의 금지):
;;   take, drop, flatten, zip, concat, merge, first, rest, nth
;;   str-starts-with/ends-with/str-includes/str-lower/str-upper/str-trim
;;   str-replace/str-slice/str-split/str-to-num/str-join/index-of
;;   assoc, dissoc, merge, select-keys, keys, vals, update, assoc-in, update-in
;;   filter, map, reduce, every, some, reverse, sort
;;   format, base64-encode, base64-decode, inspect, pp
;;   clamp, includes-item, append

;; ─── 1. 문자열 유틸 ─────────────────────────────────────────────────────

(defn blank? [$s]
  (or (null? $s) (= (str-trim $s) "")))

(defn str-coerce [$v]
  (if (null? $v) "" (str $v)))

;; str-join → 런타임 내장 (io.c str_join)

(defn url-encode-simple [$s]
  (str-replace (str-coerce $s) " " "+"))

;; ─── 2. 숫자 유틸 ───────────────────────────────────────────────────────

(defn safe-int [$v $default]
  (let [[$n (str-to-num (str-coerce $v))]]
    (if (null? $n) $default (to-int $n))))

(defn safe-float [$v $default]
  (let [[$n (str-to-num (str-coerce $v))]]
    (if (null? $n) $default $n)))

;; clamp → 런타임 내장 (aliases.c)

;; ─── 3. 컬렉션 유틸 ─────────────────────────────────────────────────────

(defn first-or [$col $default]
  (if (or (null? $col) (= (length $col) 0))
    $default
    (get $col 0)))

(defn last-item [$col]
  (get $col (- (length $col) 1)))

(defn unique [$col]
  (reduce
    (fn [$acc $x]
      (if (includes-item $acc $x) $acc (append $acc $x)))
    (list) $col))

(defn zip-map [$ks $vs]
  ;; range는 단일 인자만: (range n) → [0..n-1]
  (reduce
    (fn [$acc $i]
      (assoc $acc (get $ks $i) (get $vs $i)))
    {}
    (range (length $ks))))

;; index-of → 런타임 내장 (math.c)

;; ─── 4. 맵 유틸 ─────────────────────────────────────────────────────────

(defn get-or [$m $k $default]
  (let [[$v (get $m $k)]]
    (if (null? $v) $default $v)))

(defn omit-keys [$m $ks]
  (reduce (fn [$acc $k] (dissoc $acc $k)) $m $ks))

(defn rename-keys [$m $remap]
  (reduce
    (fn [$acc $k]
      (let [[$new-k (get $remap $k)]
            [$val   (get $m $k)]]
        (if (null? $new-k) $acc (assoc $acc $new-k $val))))
    {}
    (keys $remap)))

;; ─── 5. HTTP 응답 헬퍼 ──────────────────────────────────────────────────

(defn ok [$data]
  (server_json (json_stringify {"ok" true "data" $data})))

(defn ok-list [$data $total]
  (server_json (json_stringify {"ok" true "data" $data "total" $total})))

(defn err [$msg]
  (server_status 400 (json_stringify {"ok" false "error" $msg})))

(defn err-not-found []
  (server_status 404 (json_stringify {"ok" false "error" "Not found"})))

(defn err-unauthorized []
  (server_status 401 (json_stringify {"ok" false "error" "Unauthorized"})))

(defn err-server [$msg]
  (server_status 500 (json_stringify {"ok" false "error" $msg})))

;; ─── 6. 요청 헬퍼 ───────────────────────────────────────────────────────

(defn get-header [$req $name]
  ;; 런타임은 헤더 원본 케이스 유지 → 소문자 비교로 스캔
  (let [[$hdrs  (get $req "headers")]
        [$lower (str-lower $name)]
        [$exact (get $hdrs $name)]]
    (if (not (null? $exact)) $exact
      (reduce
        (fn [$acc $k]
          (if (not (null? $acc)) $acc
            (if (= (str-lower $k) $lower) (get $hdrs $k) nil)))
        nil
        (keys $hdrs)))))

(defn bearer-token [$req]
  (let [[$auth (get-header $req "authorization")]]
    (if (null? $auth) nil
      (if (str-starts-with $auth "Bearer ")
        (str-slice $auth 7 (length $auth))
        nil))))

(defn req-param [$req $name]
  (get (get $req "params") $name))

(defn req-query [$req $name]
  (get (get $req "query") $name))

(defn req-body [$req]
  (get $req "body"))

(defn query-int [$req $name $default]
  (safe-int (req-query $req $name) $default))

;; ─── 7. SQLite 헬퍼 ─────────────────────────────────────────────────────

(defn db-one [$db $sql $params]
  (let [[$rows (fxb_sqlite_query_p $db $sql $params)]]
    (if (= (length $rows) 0) nil (get $rows 0))))

(defn sqlite-count [$db $table]
  (let [[$row (db-one $db
                 (str "SELECT COUNT(*) as n FROM " $table) (list))]]
    (if (null? $row) 0 (or (get $row "n") 0))))

(defn sqlite-paginate [$db $sql $params $page $limit]
  (let [[$offset (* (- $page 1) $limit)]
        [$paged  (str $sql " LIMIT ? OFFSET ?")]
        [$rows   (fxb_sqlite_query_p $db $paged
                   (append (append $params $limit) $offset))]]
    {"rows" $rows "page" $page "limit" $limit}))

;; ─── 8. 타임스탬프 ──────────────────────────────────────────────────────

(defn now-ms [] (fl_now_ms))

(defn now-str []
  (str-trim (shell_run "date -u +%Y-%m-%dT%H:%M:%SZ")))

;; ─── 9. 로깅 ────────────────────────────────────────────────────────────

(defn log-info [$msg]
  (println (str "[INFO] " $msg)))

(defn log-error [$msg]
  (println (str "[ERROR] " $msg)))

(defn log-req [$req]
  (println (str "[" (now-str) "] "
                (get $req "method") " "
                (get $req "path"))))
