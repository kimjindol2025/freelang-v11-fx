;; ── fx-std.fl — FreeLang fx 표준 라이브러리 ──────────────────────────────
;; 사용법: (load "/home/kimjin/freelang-v11-fx/fx-std.fl")
;;
;; fx 런타임 내장 (여기서 재정의 금지):
;;   take, drop, flatten, zip, concat, merge, first, rest, nth
;;   str-starts-with/ends-with/str-includes/str-lower/str-upper/str-trim
;;   str-replace/str-slice/str-split/str-to-num/str-join/index-of
;;   assoc, dissoc, merge, select-keys, keys, vals, update, assoc-in, update-in
;;   filter, map, reduce, every, some, reverse, sort
;;   format, base64-encode, base64-decode, inspect, pp
;;   clamp, includes-item, append

;; ─── 1. 문자열 유틸 ─────────────────────────────────────────────────────

(defn blank? [$s]
  (or (null? $s) (= (str-trim $s) "")))

(defn str-coerce [$v]
  (if (null? $v) "" (str $v)))

;; str-join → 런타임 내장 (io.c str_join)

(defn url-encode-simple [$s]
  (str-replace (str-coerce $s) " " "+"))

;; ─── 2. 숫자 유틸 ───────────────────────────────────────────────────────

(defn safe-int [$v $default]
  (let [[$n (str-to-num (str-coerce $v))]]
    (if (null? $n) $default (to-int $n))))

(defn safe-float [$v $default]
  (let [[$n (str-to-num (str-coerce $v))]]
    (if (null? $n) $default $n)))

;; clamp → 런타임 내장 (aliases.c)

;; ─── 3. 컬렉션 유틸 ─────────────────────────────────────────────────────

(defn first-or [$col $default]
  (if (or (null? $col) (= (length $col) 0))
    $default
    (get $col 0)))

(defn last-item [$col]
  (get $col (- (length $col) 1)))

(defn unique [$col]
  (reduce
    (fn [$acc $x]
      (if (includes-item $acc $x) $acc (append $acc $x)))
    (list) $col))

(defn zip-map [$ks $vs]
  ;; range는 단일 인자만: (range n) → [0..n-1]
  (reduce
    (fn [$acc $i]
      (assoc $acc (get $ks $i) (get $vs $i)))
    {}
    (range (length $ks))))

;; index-of → 런타임 내장 (math.c)

;; ─── 4. 맵 유틸 ─────────────────────────────────────────────────────────

(defn get-or [$m $k $default]
  (let [[$v (get $m $k)]]
    (if (null? $v) $default $v)))

(defn omit-keys [$m $ks]
  (reduce (fn [$acc $k] (dissoc $acc $k)) $m $ks))

(defn rename-keys [$m $remap]
  (reduce
    (fn [$acc $k]
      (let [[$new-k (get $remap $k)]
            [$val   (get $m $k)]]
        (if (null? $new-k) $acc (assoc $acc $new-k $val))))
    {}
    (keys $remap)))

;; ─── 5. HTTP 응답 헬퍼 ──────────────────────────────────────────────────

(defn ok [$data]
  (server_json (json_stringify {"ok" true "data" $data})))

(defn ok-list [$data $total]
  (server_json (json_stringify {"ok" true "data" $data "total" $total})))

(defn err [$msg]
  (server_status 400 (json_stringify {"ok" false "error" $msg})))

(defn err-not-found []
  (server_status 404 (json_stringify {"ok" false "error" "Not found"})))

(defn err-unauthorized []
  (server_status 401 (json_stringify {"ok" false "error" "Unauthorized"})))

(defn err-server [$msg]
  (server_status 500 (json_stringify {"ok" false "error" $msg})))

;; ─── 6. 요청 헬퍼 ───────────────────────────────────────────────────────

(defn get-header [$req $name]
  ;; 런타임은 헤더 원본 케이스 유지 → 소문자 비교로 스캔
  (let [[$hdrs  (get $req "headers")]
        [$lower (str-lower $name)]
        [$exact (get $hdrs $name)]]
    (if (not (null? $exact)) $exact
      (reduce
        (fn [$acc $k]
          (if (not (null? $acc)) $acc
            (if (= (str-lower $k) $lower) (get $hdrs $k) nil)))
        nil
        (keys $hdrs)))))

(defn bearer-token [$req]
  (let [[$auth (get-header $req "authorization")]]
    (if (null? $auth) nil
      (if (str-starts-with $auth "Bearer ")
        (str-slice $auth 7 (length $auth))
        nil))))

(defn req-param [$req $name]
  (get (get $req "params") $name))

(defn req-query [$req $name]
  (get (get $req "query") $name))

(defn req-body [$req]
  (get $req "body"))

(defn query-int [$req $name $default]
  (safe-int (req-query $req $name) $default))

;; ─── 7. SQLite 헬퍼 ─────────────────────────────────────────────────────

(defn db-one [$db $sql $params]
  (let [[$rows (fxb_sqlite_query_p $db $sql $params)]]
    (if (= (length $rows) 0) nil (get $rows 0))))

(defn sqlite-count [$db $table]
  (let [[$row (db-one $db
                 (str "SELECT COUNT(*) as n FROM " $table) (list))]]
    (if (null? $row) 0 (or (get $row "n") 0))))

(defn sqlite-paginate [$db $sql $params $page $limit]
  (let [[$offset (* (- $page 1) $limit)]
        [$paged  (str $sql " LIMIT ? OFFSET ?")]
        [$rows   (fxb_sqlite_query_p $db $paged
                   (append (append $params $limit) $offset))]]
    {"rows" $rows "page" $page "limit" $limit}))

;; ─── 8. 타임스탬프 ──────────────────────────────────────────────────────

(defn now-ms [] (fl_now_ms))

(defn now-str []
  (str-trim (shell_run "date -u +%Y-%m-%dT%H:%M:%SZ")))

;; ─── 9. 로깅 ────────────────────────────────────────────────────────────

(defn log-info [$msg]
  (println (str "[INFO] " $msg)))

(defn log-error [$msg]
  (println (str "[ERROR] " $msg)))

(defn log-req [$req]
  (println (str "[" (now-str) "] "
                (get $req "method") " "
                (get $req "path"))))

;; ─── 10. 안전한 맵 접근 (Phase 3, 2026-06-20, cgc VERIFIED) ────────────

;; json_safe_get: 맵에서 키 추출, nil이면 기본값 반환
;; 용도: (get (get $req "params") "id") 패턴에서 nil 방어
;; 검증: cgc 컴파일 + 실행 확인 (2026-06-20)
(defn json_safe_get [$m $k $default]
  (let [[$v (if (nil? $m) nil (get $m $k))]]
    (if (nil? $v) $default $v)))

;; get-in-2: 2단계 중첩 맵 접근 (fx 앱에서 가장 흔한 패턴)
;; 대체: (get (get $req "params") "id") → (get-in-2 $req "params" "id")
;; 검증: cgc 컴파일 + 실행 확인 (2026-06-20)
(defn get-in-2 [$m $k1 $k2]
  (json_safe_get (json_safe_get $m $k1 nil) $k2 nil))

;; ─── 6. Result 타입 — Go 스타일 에러 처리 ──────────────────────────────────
;;
;; 컨벤션: [값 nil] = 성공 / [nil "에러메시지"] = 실패
;;
;; 패턴:
;;   (let [[$v $e] (db-query-safe $db $sql $params)]
;;     (if $e (handle-err $e) (use $v)))
;;
;; 함수 목록:
;;   (ok $v)             → [v nil]         성공 Result 생성
;;   (fail $msg)         → [nil msg]       실패 Result 생성
;;   (ok? $r)            → bool            성공 여부
;;   (err? $r)           → bool            실패 여부
;;   (unwrap $r)         → 값              성공값 추출 (실패면 nil)
;;   (unwrap-err $r)     → 문자열          에러 추출 (성공이면 nil)
;;   (unwrap-or $r $def) → 값              성공값 or 기본값
;;   (and-then $r $fn)   → Result          ok면 fn($v) 적용, 에러면 그대로
;;   (result-map $r $fn) → Result          ok면 값 변환, 에러면 그대로
;;
;; safe 래퍼:
;;   (db-query-safe $db $sql $params) → Result
;;   (db-exec-safe $db $sql $params)  → Result
;;   (db-one-safe $db $sql $params)   → Result
;;   (http-get-safe $url)             → Result (body 문자열)
;;   (json-parse-safe $s)             → Result

;; Result 생성자
(defn result-ok [$v]    [$v nil])
(defn result-fail [$e]  [nil $e])

;; 검사
(defn result-ok? [$r]
  (and (not (null? $r)) (null? (get $r 1))))

(defn result-err? [$r]
  (or (null? $r) (not (null? (get $r 1)))))

;; 추출
(defn result-val [$r]
  (if (result-ok? $r) (get $r 0) nil))

(defn result-msg [$r]
  (if (result-err? $r) (get $r 1) nil))

(defn result-val-or [$r $default]
  (if (result-ok? $r) (get $r 0) $default))

;; 체이닝: ok면 fn($v) 적용, 에러면 그대로 전파
(defn result-then [$r $fn]
  (if (result-ok? $r) ($fn (get $r 0)) $r))

;; 값 변환 (에러면 그대로)
(defn result-map [$r $fn]
  (if (result-ok? $r) (result-ok ($fn (get $r 0))) $r))

;; Safe DB 래퍼 — sqlite는 에러 시 문자열 반환 (throw 아님)
;; 반환값이 문자열이면 에러, 벡터/맵이면 성공
(defn db-query-safe [$db $sql $params]
  (let [$r (fxb_sqlite_query_p $db $sql $params)]
    (if (string? $r)
      (result-fail $r)
      (result-ok $r))))

(defn db-exec-safe [$db $sql $params]
  (let [$r (fxb_sqlite_exec_p $db $sql $params)]
    (if (string? $r)
      (result-fail $r)
      (result-ok $r))))

(defn db-one-safe [$db $sql $params]
  (let [$rows (fxb_sqlite_query_p $db $sql $params)]
    (if (string? $rows)
      (result-fail $rows)
      (if (= (length $rows) 0)
        (result-ok nil)
        (result-ok (get $rows 0))))))

;; Safe HTTP GET — status=0(연결실패) / status>=400(HTTP에러) 감지
(defn http-get-safe [$url]
  (let [$r (http_get $url)]
    (if (= (get $r "status") 0)
      (result-fail (str "연결 실패: " (get $r "error")))
      (if (>= (get $r "status") 400)
        (result-fail (str "HTTP " (get $r "status")))
        (result-ok (get $r "body"))))))

;; Safe JSON parse — json_try_parse가 C 레벨에서 try-catch 처리
;; (FL try-catch는 setjmp를 statement expression 안에 넣어 GCC 에러 발생)
(defn json-parse-safe [$s]
  (json_try_parse $s))

;; Safe file_read — 파일 없으면 nil 반환 (throw 없음)
;; null? 체크: let 단일 바인딩으로 fl_str_n GCC 충돌 우회
(defn file-read-safe [$path]
  (let [$r (file-read $path)]
    (if (null? $r)
      (result-fail "파일 없음")
      (result-ok $r))))

;; Safe shell_run — popen 실패시 nil 반환
(defn shell-run-safe [$cmd]
  (let [$r (shell_run $cmd)]
    (if (null? $r)
      (result-fail "명령 실패")
      (result-ok $r))))

;; Safe MariaDB — 에러시 "[mariadb] ..." 문자열 반환 (sqlite와 동일 패턴)
(defn mariadb-query-safe [$conn $sql]
  (let [$r (mariadb_query $conn $sql)]
    (if (string? $r)
      (result-fail $r)
      (result-ok $r))))

(defn mariadb-exec-safe [$conn $sql]
  (let [$r (mariadb_exec $conn $sql)]
    (if (string? $r)
      (result-fail $r)
      (result-ok $r))))

(defn mariadb-connect-safe [$host $port $user $pw $db]
  (let [$r (mariadb_connect $host $port $user $pw $db)]
    (if (string? $r)
      (result-fail $r)
      (result-ok $r))))

;; upsert: SQLite INSERT OR REPLACE 래퍼
;; 검증: cgc 컴파일 VERIFIED (fxb_sqlite_exec_p 의존)
;; 사용: (upsert $db "users" ["id" "name"] (list $id $name))
(defn upsert [$db $table $cols $vals]
  (do
    (let [[$n (length $cols)]
          [$col-list (str-join $cols ",")]
          [$placeholders (str-join (map (fn [$_] "?") $cols) ",")]
          [$sql (str "INSERT OR REPLACE INTO " $table "(" $col-list ") VALUES (" $placeholders ")")]]
      (fxb_sqlite_exec_p $db $sql $vals))))

;; ─── 11. 고차 함수 유틸 ──────────────────────────────────────────────────

;; identity: 입력 그대로 반환
(defn identity [$x] $x)

;; constantly: 항상 같은 값을 반환하는 함수
(defn constantly [$v] (fn [$_] $v))

;; partial: 부분 적용 (1~3개 인자 고정)
;;   (partial + 1)      → (fn [$x] (+ 1 $x))
;;   (partial str "A" "B") → (fn [$x] (str "A" "B" $x))
(defn partial [$f $a1]
  (fn [$x] ($f $a1 $x)))

(defn partial2 [$f $a1 $a2]
  (fn [$x] ($f $a1 $a2 $x)))

(defn partial3 [$f $a1 $a2 $a3]
  (fn [$x] ($f $a1 $a2 $a3 $x)))

;; complement: 함수의 논리 반전
(defn complement [$f]
  (fn [$x] (not ($f $x))))

;; juxt: 여러 함수를 같은 인자에 적용해 벡터로 반환
;;   ((juxt first last) [1 2 3]) → [1 3]
(defn juxt [$f $g]
  (fn [$x] [($f $x) ($g $x)]))

(defn juxt3 [$f $g $h]
  (fn [$x] [($f $x) ($g $x) ($h $x)]))

;; flip: 두 인자 순서 뒤집기
(defn flip [$f]
  (fn [$a $b] ($f $b $a)))

;; memoize: 결과 캐시 (atom 기반)
;;   (define fib-m (memoize fib))
(defn memoize [$f]
  (let [$cache (atom {})]
    (fn [$x]
      (let [$k (str $x)
            $v (get (deref $cache) $k)]
        (if (not (null? $v)) $v
          (let [$result ($f $x)]
            (swap! $cache assoc $k $result)
            $result))))))

;; pipe2/pipe3: 값을 N개 함수에 순차 적용 (가변인자 미지원으로 고정 arity)
;;   (pipe2 5 (partial * 2) (partial + 1)) → 11
(defn pipe2 [$v $f1 $f2]   ($f2 ($f1 $v)))
(defn pipe3 [$v $f1 $f2 $f3] ($f3 ($f2 ($f1 $v))))
