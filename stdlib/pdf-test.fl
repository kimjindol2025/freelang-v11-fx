;; pdf-test.fl — pdf.fl 라이브러리 테스트

(load "/home/kim/freelang-v11-fx/stdlib/pdf.fl")

(defn make_catalog []
  (let [[$d0 (pdf_new "제품 카탈로그 2026")]
        [$d1 (pdf_bold $d0 "제품 카탈로그 2026" 72 780 22)]
        [$d2 (pdf_line $d1 72 768 522 768)]
        [$d3 (pdf_text $d2 "PRODUCT CATALOG 2026" 72 748 11)]
        [$d4 (pdf_text $d3 "1. 차량용 진공청소기 ROBO-1" 72 710 14)]
        [$d5 (pdf_text $d4 "   360도 붐 회전 / 진공모터 2개 / 반영구 필터 / 저소음" 72 692 11)]
        [$d6 (pdf_text $d5 "2. 밸트식 에어콤프레서 4.5HP 120L" 72 668 14)]
        [$d7 (pdf_text $d6 "   콤프월드 / 국내산 / 저전압 구동 / 밸트 방식" 72 650 11)]
        [$d8 (pdf_text $d7 "3. 스텐레스 싱크대 SIN-600-1" 72 626 14)]
        [$d9 (pdf_text $d8 "   W600 x D600 x H800 / SUS201 / 두께 상0.7T 하0.5T" 72 608 11)]
        [$d10 (pdf_text $d9 "4. 메가썬 전기온수기 100L (MSW-100BU)" 72 584 14)]
        [$d11 (pdf_text $d10 "   상향식 바닥형 / MEGA SUN코리아" 72 566 11)]
        [$d12 (pdf_text $d11 "5. 쏠레몬 Self 연막항균탈취기" 72 542 14)]
        [$d13 (pdf_text $d12 "   연막 방식 항균탈취 / 자가 운용형" 72 524 11)]
        [$d14 (pdf_line $d13 72 508 522 508)]
        [$d15 (pdf_text $d14 "본 카탈로그는 내부 참고용입니다." 72 490 10)]]
    $d15))

(do
  (let [[$doc (make_catalog)]]
    (do
      (pdf_save $doc "/home/kim/catalog.pdf")
      (println "PDF 생성 완료: /home/kim/catalog.pdf"))))
