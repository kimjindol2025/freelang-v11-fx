;; SQL Transaction Rollback 검증 (MariaDB)
;; BEGIN → INSERT A → throw → ROLLBACK
;; 기대: A 없음

(define $db (mariadb-connect "localhost" "akl" "akl_pass_2026" "akl"))

;; 임시 테이블 초기화
(mariadb-exec $db "DROP TABLE IF EXISTS _fl_txn_test")
(mariadb-exec $db "CREATE TABLE _fl_txn_test (id INT AUTO_INCREMENT PRIMARY KEY, val VARCHAR(100))")

;; 케이스 1: throw → ROLLBACK
(println "=== 케이스 1: throw 중 롤백 ===")
(try
  (begin
    (mariadb-exec $db "BEGIN")
    (mariadb-exec $db "INSERT INTO _fl_txn_test (val) VALUES ('A')")
    (throw "intentional-error")
    (mariadb-exec $db "COMMIT"))
  (catch $e
    (begin
      (mariadb-exec $db "ROLLBACK")
      (println (str "롤백 완료: " $e)))))

(define $rows1 (mariadb-query $db "SELECT val FROM _fl_txn_test"))
(println (str "케이스1 rows=" (length $rows1)))
(if (= (length $rows1) 0)
  (println "✅ PASS: 롤백 정상 — A 없음")
  (println "❌ FAIL: 롤백 실패 — 데이터 남음"))

;; 케이스 2: 정상 COMMIT
(println "")
(println "=== 케이스 2: 정상 COMMIT ===")
(mariadb-exec $db "BEGIN")
(mariadb-exec $db "INSERT INTO _fl_txn_test (val) VALUES ('C')")
(mariadb-exec $db "INSERT INTO _fl_txn_test (val) VALUES ('D')")
(mariadb-exec $db "COMMIT")

(define $rows2 (mariadb-query $db "SELECT val FROM _fl_txn_test"))
(println (str "케이스2 rows=" (length $rows2)))
(if (= (length $rows2) 2)
  (println "✅ PASS: C, D 존재")
  (println (str "❌ FAIL: rows=" (length $rows2))))

;; 케이스 3: 중첩 throw → 외부 ROLLBACK
(println "")
(println "=== 케이스 3: 중첩 throw → ROLLBACK ===")
(try
  (begin
    (mariadb-exec $db "BEGIN")
    (mariadb-exec $db "INSERT INTO _fl_txn_test (val) VALUES ('E')")
    (try
      (throw "inner")
      (catch $inner (throw (str "rethrow:" $inner))))
    (mariadb-exec $db "COMMIT"))
  (catch $outer
    (begin
      (mariadb-exec $db "ROLLBACK")
      (println (str "외부 rollback: " $outer)))))

(define $rows3 (mariadb-query $db "SELECT val FROM _fl_txn_test"))
(println (str "케이스3 total rows=" (length $rows3)))
(if (= (length $rows3) 2)
  (println "✅ PASS: E 롤백됨, C+D만 남음")
  (println (str "❌ FAIL: rows=" (length $rows3))))

;; 정리
(mariadb-exec $db "DROP TABLE _fl_txn_test")
(println "")
(println "=== 완료 ===")
