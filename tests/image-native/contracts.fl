;; Frozen before implementation. Fixtures are generated locally by C codecs.
(defn check [id yes]
  (if yes (println (str id "=PASS")) (throw (str id "=FAIL"))))
(define options {"max_pixels" 20000000 "max_bytes" 5242880
  "memory_bytes" 536870912 "timeout_ms" 5000 "jpeg_quality" 85})
(defn info [path] (image-info-result path options))
(defn data [result] (get result "data"))
(defn output [path edge] {"path" path "long_edge" edge})
(defn process [path outputs] (image-process-result path outputs options))
(defn failed [result code] (and (= (get result "ok") false) (= (get result "error") code)))
(define jpeg (info "baseline.jpg"))
(check "IMG01" (and (get jpeg "ok") (= (get (data jpeg) "width") 1600) (= (get (data jpeg) "height") 800) (= (get (data jpeg) "mime") "image/jpeg")))
(check "IMG02" (get (info "progressive.jpg") "ok"))
(define png (info "alpha.png"))
(check "IMG03" (and (get png "ok") (= (get (data png) "width") 1600) (get (data png) "alpha")))
(define gif (process "animated.gif" [(output "gif-first.png" 320)]))
(check "IMG04" (and (get gif "ok") (= (get (data (info "gif-first.png")) "mime") "image/png") (= (get (data (info "animated.gif")) "frames") 2)))
(define scaled (process "baseline.jpg" [(output "small.jpg" 320) (output "large.jpg" 1280)]))
(check "IMG05" (and (get scaled "ok") (= (get (data (info "small.jpg")) "width") 320) (= (get (data (info "small.jpg")) "height") 160)))
(check "IMG06" (and (= (get (data (info "large.jpg")) "width") 1280) (= (get (data (info "large.jpg")) "height") 640)))
(define tiny (process "tiny.png" [(output "tiny-copy.png" 320)]))
(check "IMG07" (and (get tiny "ok") (= (get (data (info "tiny-copy.png")) "width") 20) (= (get (data (info "tiny-copy.png")) "height") 10)))
(check "IMG08" (and (= (get (data scaled) "jpeg_quality") 85) (get (info "small.jpg") "ok")))
(define alpha (process "alpha.png" [(output "alpha-small.png" 320)]))
(check "IMG09" (and (get alpha "ok") (get (data (info "alpha-small.png")) "alpha")))
(define original (get (file-sha256-result "baseline.jpg") "data"))
(define copied (process "baseline.jpg" [(output "sha-copy.jpg" 320)]))
(check "IMG10" (and (get copied "ok") (= original (get (file-sha256-result "baseline.jpg") "data"))))
(check "IMG11" (and (failed (info "truncated.png") "INVALID_IMAGE") (failed (info "truncated.jpg") "INVALID_IMAGE") (failed (info "truncated.gif") "INVALID_IMAGE")))
(check "IMG12" (and (failed (info "fake.gif") "INVALID_IMAGE") (failed (image-info-result "baseline.jpg" (assoc options "expected_mime" "image/png")) "TYPE_MISMATCH")))
(check "IMG13" (failed (image-info-result "alpha.png" (assoc options "max_pixels" 100)) "PIXEL_LIMIT"))
(check "IMG14" (failed (image-info-result "alpha.png" (assoc options "max_bytes" 10)) "SOURCE_LIMIT"))
(check "IMG15" (and (failed (info "../escape.png") "PATH_DENIED") (failed (process "alpha.png" [(output "../escape.png" 320)]) "PATH_DENIED")))
(check "IMG16" (and (failed (info "link.png") "PATH_DENIED") (failed (process "alpha.png" [(output "link-output.png" 320)]) "PATH_DENIED")))
(define protected (get (file-sha256-result "protected.png") "data"))
(check "IMG17" (and (failed (process "alpha.png" [(output "protected.png" 320)]) "OUTPUT_EXISTS") (= protected (get (file-sha256-result "protected.png") "data"))))
(check "IMG18" (and (failed (image-info-result 1 options) "INVALID_ARGUMENT") (failed (image-info-result "alpha.png" {}) "INVALID_ARGUMENT") (failed (image-process-result "alpha.png" [] options) "INVALID_ARGUMENT")))
(define limited (image-process-result "alpha.png" [(output "limited.png" 320)] (assoc options "memory_bytes" 1048576)))
(check "IMG19" (and (= (get limited "ok") false) (!= (get limited "error") "") (not (file_exists "limited.png"))))
(define repeated (map (fn [n] (get (info "tiny.png") "ok")) (range 0 100)))
(check "IMG20" (every? (fn [ok] ok) repeated))
(println "IMAGE_NATIVE_PASS=20 FAIL=0")
