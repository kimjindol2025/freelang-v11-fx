(defn check [a b label] (if (= a b) (println label) (throw (str "TAIL_EXTRA_ASSERT " label " expected=" b " actual=" a))))
(defn leaf [] (throw "boom"))
(defn mix [n] (if (= n 0) (leaf) (recur (- n 1))))
(check (try (mix 5000) (catch [error] (error_message error))) "boom" "RECUR_TO_NAMED_TAIL=PASS")
(define handler (fn [] (if true (leaf) nil)))
(check (try (handler) (catch [error] (error_message error))) "[leaf] boom" "TOP_LEVEL_LAMBDA_MODE=PASS")
(defn invoke-handler [] (handler))
(check (try (invoke-handler) (catch [error] (error_message error))) "[handler] boom" "INHERITED_LAMBDA_MODE=PASS")
(check (try (leaf) (catch [error] (error_message error))) "boom" "MODE_AFTER_ERROR=PASS")
