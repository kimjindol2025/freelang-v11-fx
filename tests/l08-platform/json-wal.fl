(defn check [a b] (if (= a b) true (throw (str "expected=" b " actual=" a))))
(define text (file_read (get (cli-args) 0)))
(define records (map json_parse (filter (fn [line] (not (= line ""))) (str_split text "\n"))))
(check (length records) 2)
(define prepare (get records 0))
(define commit (get records 1))
(define encoded (json_str (get prepare "body")))
(check (auth_sha256 encoded) (get prepare "checksum"))
(check (auth-sha256 encoded) (get commit "checksum"))
(check (count encoded) (get prepare "length"))
(check (count encoded) (get commit "length"))
(check (json_str (json_parse encoded)) encoded)
(check (auth_sha256 "abc") "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
(println "JSON_WAL_CHECKSUM_PASS")
