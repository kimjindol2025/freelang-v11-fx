(defn check [a b] (if (= a b) true (throw (str "expected=" b " actual=" a))))
(define root (get (cli-args) 0))
(define path (str root "/synthetic.wal"))
(define added "{\"op\":\"image-add\",\"id\":\"img-한\"}\n")
(define deleted "{\"op\":\"image-delete\",\"id\":\"img-한\"}\n")
(println (check (file_write path "obsolete") true))
(define first-fd (fd_open path "w"))
(println (check (>= first-fd 1000) true))
(println (check (fd_write first-fd added) true))
(println (check (fd_fsync first-fd) true))
(println (check (fd_close first-fd) true))
(define second-fd (fd-open path "a"))
(println (check (> second-fd first-fd) true))
(println (check (fd-write second-fd deleted) true))
(println (check (fd_flush) true))
(println (check (fd-close second-fd) true))
(println (check (file_read path) (str added deleted)))
