(load "../app/store.fl")
(load "../app/images.fl")
(load "../app/image-admin.fl")
(load "../app/blog-backup.fl")
(store-fault-arm (env-get "L08_RESTORE_FAULT"))
(define error (try (do (blog-backup-import 1 "b4-legacy") "NO_ERROR") (catch [e] (error_message e))))
(define restart (str-includes error "BLOG_BACKUP_RESTORE_RESTART_REQUIRED"))
(define retained (file_exists (image-disk-path "55555555555555555555555555555555" "image/gif")))
(define closed (and (= (store-fault-count) 1) (= (store-fault-open-count) 0)))
(println (str "BACKUP_RESTORE_RESTART_MESSAGE=" (if restart "PASS" "FAIL")))
(println (str "BACKUP_RESTORE_IMAGE_RETAINED=" (if retained "PASS" "FAIL")))
(println (str "BACKUP_RESTORE_WAL_FD_CLOSED=" (if closed "PASS" "FAIL")))
(if (and restart retained closed) nil (throw "uncertain restore lost image or misreported outcome"))
