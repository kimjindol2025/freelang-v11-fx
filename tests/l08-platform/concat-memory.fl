(define left (range 0 2048))
(define right (range 2048 4096))
(compiler-lex-meter-start)
(define joined (concat left right))
(define live (compiler-lex-meter-live))
(define peak (compiler-lex-meter-peak))
(println (str "CONCAT_LIVE_BYTES=" live))
(println (str "CONCAT_PEAK_BYTES=" peak))
(if (= (count joined) 4096) (println "CONCAT_COUNT=PASS") (throw "concat count mismatch"))
(doseq [i (range 0 4096)] (if (= (get joined i) i) nil (throw "concat order mismatch")))
(println "CONCAT_ORDER=PASS")
(if (and (= (count left) 2048) (= (count right) 2048) (= (get left 2047) 2047) (= (get right 0) 2048)) (println "CONCAT_INPUTS=PASS") (throw "concat changed input"))
(if (and (<= live 8388608) (<= peak 8388608)) (println "CONCAT_BOUNDED_HEAP=PASS") (throw "concat heap budget exceeded"))
