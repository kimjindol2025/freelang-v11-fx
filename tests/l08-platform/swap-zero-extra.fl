(defn check [a b label] (if (= a b) (println label) (throw (str "SWAP_ASSERT " label))))
(define state (atom 1))
(check (swap! state (fn [n] (+ n 1))) 2 "SWAP_ZERO_EXTRA_RETURN=PASS")
(check (deref state) 2 "SWAP_ZERO_EXTRA_STORED=PASS")
(check (try (swap! state (fn [n] (throw "swap-error"))) (catch [error] true)) true "SWAP_ERROR_PROPAGATES=PASS")
(check (deref state) 2 "SWAP_ERROR_UNCHANGED=PASS")
(check (swap! state (fn [n a b] (+ n a b)) 3 4) 9 "SWAP_EXTRA_ARGUMENTS=PASS")
(check (swap! state (fn [n] nil)) nil "SWAP_NIL_RETURN=PASS")
(check (deref state) nil "SWAP_NIL_STORED=PASS")
