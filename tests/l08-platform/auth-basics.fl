(defn check [a b] (if (= a b) true (throw (str "expected=" b " actual=" a))))
(define root (get (cli-args) 0))
(check (auth_bearer_extract nil) nil)
(check (auth_bearer_extract {"headers" {"authorization" "Bearer sample"}}) "sample")
(check (auth-bearer-extract {"headers" {"Authorization" "Bearer capital"}}) "capital")
(check (auth_bearer_extract {"headers" {"authorization" "Bearer "}}) "")
(check (auth_bearer_extract {"headers" {"authorization" "bearer sample"}}) nil)
(check (auth_bearer_extract {"headers" {"authorization" "Basic sample"}}) nil)
(check (auth_bearer_extract {"headers" {"authorization" "" "Authorization" "Bearer ignored"}}) nil)
(check (auth_bearer_extract {"headers" {"authorization" false "Authorization" "Bearer ignored"}}) nil)
(check (length (auth_random_token)) 64)
(check (auth_random_token 0) "")
(check (length (auth_random_token 1.9)) 2)
(check (auth_random_token 0.9) "")
(doseq [bad [-1 "4" nil false]]
 (check (try (do (auth_random_token bad) false) (catch [e] true)) true))
(define tokens (map (fn [n] (auth_random_token 16)) (range 0 128)))
(check (every? (fn [token] (regex_match token "^[0-9a-f]{32}$")) tokens) true)
(check (length (arr_unique tokens)) 128)
(check (auth_password_needs_rehash "legacy") true)
(check (auth-password-needs-rehash "$scrypt$broken") false)
(define password (file_read (str root "/password.txt")))
(define created (auth_hash_password password))
(check (str_starts created "$scrypt$N=16384,r=8,p=1$") true)
(define parts (str_split created "$"))
(check (length parts) 5)
(check (length (get parts 3)) 24)
(check (length (get parts 4)) 88)
(check (= created (auth_hash_password password)) false)
(check (file_write (str root "/created.phc") created) true)
(println "AUTH_BASICS_PASS")
