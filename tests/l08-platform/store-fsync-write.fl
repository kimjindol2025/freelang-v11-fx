(load "../app/store.fl")
(ensure-table "l08_fsync" [{"name" "id" "type" "TEXT" "nullable" false "primary" true}] "id" [])
(store-fsync-fail-next)
(define rejected (try (do (afj-tcp-commit-ast {"type" "insert" "table" "l08_fsync" "row" {"id" "failed"}}) false) (catch [error] true)))
(define after-failure (count (get (execute-ast {"type" "select" "table" "l08_fsync"}) "rows")))
(println (str "DB_FSYNC_FAILURE_REPORTED=" rejected))
(println (str "DB_FSYNC_LIVE_AFTER_FAILURE=" after-failure))
(afj-tcp-commit-ast {"type" "insert" "table" "l08_fsync" "row" {"id" "good"}})
(define rows (get (execute-ast {"type" "select" "table" "l08_fsync"}) "rows"))
(println (str "DB_FSYNC_LIVE_AFTER_RECOVERY=" (count rows)))
(if (and rejected (= after-failure 0) (= (count rows) 1) (= (get (first rows) "id") "good"))
 (println "DB_FSYNC_WRITE=PASS") (throw "DB_FSYNC_WRITE_MISMATCH"))
