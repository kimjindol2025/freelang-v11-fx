(load "../app/store.fl")
(ensure-table "l08_fsync" [{"name" "id" "type" "TEXT" "nullable" false "primary" true}] "id" [])
(store-fsync-fail-next)
(define uncertain (try (do (afj-tcp-commit-ast {"type" "insert" "table" "l08_fsync" "row" {"id" "failed"}}) false)
 (catch [error] (str-includes (error_message error) "DB_COMMIT_UNCERTAIN_RESTART_REQUIRED"))))
(define read-rejected (try (do (execute-ast {"type" "select" "table" "l08_fsync"}) false)
 (catch [error] (str-includes (error_message error) "DB_RECOVERY_REQUIRED"))))
(define write-rejected (try (do (afj-tcp-commit-ast {"type" "insert" "table" "l08_fsync" "row" {"id" "good"}}) false)
 (catch [error] (str-includes (error_message error) "DB_RECOVERY_REQUIRED"))))
(println (str "DB_FSYNC_UNCERTAIN_REPORTED=" uncertain))
(println (str "DB_FSYNC_READ_REJECTED=" read-rejected))
(println (str "DB_FSYNC_WRITE_REJECTED=" write-rejected))
(if (and uncertain read-rejected write-rejected) (println "DB_FSYNC_WRITE=PASS") (throw "DB_FSYNC_WRITE_MISMATCH"))
