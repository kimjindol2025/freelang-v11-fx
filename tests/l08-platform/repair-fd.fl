(defn check [actual expected label] (if (= actual expected) (println label) (throw (str "REPAIR_FD_ASSERT " label))))
(repair-test-setup)
(define baseline (repair-test-fds))
(define old-mask (repair-test-umask 0))
(define writer (fd-create "exclusive"))
(repair-test-umask old-mask)
(check (repair-test-mode "exclusive") 384 "REPAIR_FD_PRIVATE_MODE=PASS")
(check (- (repair-test-fds) baseline) 2 "REPAIR_FD_OWNS_PARENT=PASS")
(check (fd-write-bytes writer (get (file-read-result "all-bytes") "data")) true "REPAIR_FD_RAW_WRITE=PASS")
(check (fd-fsync writer) true "REPAIR_FD_SYNC_FILE=PASS")
(check (fd-sync-parent writer) true "REPAIR_FD_SYNC_PARENT=PASS")
(check (fd-close writer) true "REPAIR_FD_CLOSE=PASS")
(check (repair-test-fds) baseline "REPAIR_FD_NO_LEAK=PASS")
(check (try (do (fd-create "existing") false) (catch [e] true)) true "REPAIR_FD_REJECT_EXISTING=PASS")
(check (file-read "existing") "keep" "REPAIR_FD_PRESERVE_EXISTING=PASS")
(check (try (do (fd-create "link") false) (catch [e] true)) true "REPAIR_FD_REJECT_LEAF_LINK=PASS")
(check (try (do (fd-create "link-dir/new") false) (catch [e] true)) true "REPAIR_FD_REJECT_PARENT_LINK=PASS")
(check (try (do (fd-create "../escape") false) (catch [e] true)) true "REPAIR_FD_REJECT_TRAVERSAL=PASS")
(check (try (do (fd-create (str (env-get "L08_REPAIR_OUTSIDE") "/new")) false) (catch [e] true)) true "REPAIR_FD_REJECT_OUTSIDE=PASS")
(define reader (fd-open "exclusive" "r"))
(define read (fd-read-bytes reader 256))
(check (sha256 read) (sha256 (get (file-read-result "all-bytes") "data")) "REPAIR_FD_RAW_READ=PASS")
(check (try (do (fd-truncate reader 0) false) (catch [e] true)) true "REPAIR_FD_REJECT_READ_ONLY=PASS")
(check (try (do (fd-sync-parent reader) false) (catch [e] true)) true "REPAIR_FD_REJECT_UNOWNED_PARENT=PASS")
(fd-close reader)
(define shrink (fd-open "exclusive" "a"))
(check (fd-truncate shrink 3) true "REPAIR_FD_TRUNCATE=PASS")
(fd-fsync shrink)
(check (fd-seek shrink) 3 "REPAIR_FD_TRUNCATE_LENGTH=PASS")
(check (fd-truncate shrink 5) true "REPAIR_FD_EXTEND=PASS")
(check (fd-seek shrink) 5 "REPAIR_FD_EXTEND_LENGTH=PASS")
(check (try (do (fd-truncate shrink -1) false) (catch [e] true)) true "REPAIR_FD_REJECT_NEGATIVE=PASS")
(check (try (do (fd-truncate shrink 67108865) false) (catch [e] true)) true "REPAIR_FD_REJECT_LIMIT=PASS")
(check (try (do (fd-truncate shrink 1.5) false) (catch [e] true)) true "REPAIR_FD_REJECT_FRACTION=PASS")
(fd-close shrink)
(define result (get (file-read-result "exclusive") "data"))
(check (bytes-count result) 5 "REPAIR_FD_RESULT_LENGTH=PASS")
(doseq [i (range 0 5)] (if (= (repair-test-byte (bytes-slice result i (+ i 1))) (if (< i 3) i 0)) nil (throw "truncate prefix or zero extension changed")))
(println "REPAIR_FD_PREFIX_AND_ZEROS=PASS")
(check (repair-test-fds) baseline "REPAIR_FD_FINAL_NO_LEAK=PASS")
(check (try (do (fd-truncate writer 0) false) (catch [e] true)) true "REPAIR_FD_REJECT_CLOSED=PASS")
