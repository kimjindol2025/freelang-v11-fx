(define root (get (cli-args) 0))
(defn echo [req]
 (server_json {"method" (server_req_method req) "body" (get req "body")
               "header" (server_req_header req "X-Value") "type" (server_req_header req "Content-Type")}))
(server_get "/health" (fn [req] (server_text "OK")))
(server_get "/redirect" (fn [req] (server_redirect "/health")))
(server_get "/missing" (fn [req] (server_status 404 "missing")))
(server_get "/raw" (fn [req] (server_text (file_read (str root "/raw.bin")))))
(server_get "/slow" (fn [req] (do (sleep 250) (server_text "LATE"))))
(server_post "/echo" "echo")
(server_put "/echo" "echo")
(server_patch "/echo" "echo")
(server_delete "/echo" "echo")
(if (= (get (cli-args) 1) "tls")
 (server_start_tls 0 (get (cli-args) 2) (get (cli-args) 3))
 (server_start 0))
