(defn check [a b] (if (= a b) true (throw (str "expected=" b " actual=" a))))
(define root (get (cli-args) 0))
(define fixtures (json_parse (file_read (str root "/password-fixtures.json"))))
(doseq [fixture fixtures]
 (check (auth_verify_password (get fixture "password") (get fixture "stored")) (get fixture "valid")))
(define created (file_read (str root "/created.phc")))
(check (auth_verify_password (file_read (str root "/password.txt")) created) true)
(check (auth_verify_password "wrong" created) false)
(println "AUTH_PASSWORD_PASS")
