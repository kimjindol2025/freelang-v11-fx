(load "../app/store.fl")
(load "../app/images.fl")
(load "../app/image-admin.fl")
(load "../app/blog-backup.fl")
(define path (image-disk-path "66666666666666666666666666666666" "image/gif"))
(if (= (env-get "L08_BACKUP_CASE") "good")
  (let [result (blog-backup-import 1 "integrity-proof")]
    (if (and (get result "ok") (= (count (blog-rows "posts" 1)) 1) (= (count (blog-rows "images" 1)) 1)
             (= (get (first (blog-rows "posts" 1)) "title") "원본 한🙂")
             (= (sha256 (get (file-read-result path) "data")) (env-get "L08_ORIGINAL_IMAGE_HASH")))
      (println "BACKUP_INTEGRITY_GOOD_RESTORE=PASS") (throw "good archive changed data")))
  (let [before (sha256 (get (file-read-result afj-tcp-wal) "data"))
        copied (file-copy-result afj-tcp-wal "before-import.wal")
        rejected (try (do (blog-backup-import 1 "integrity-proof") false)
                   (catch [error] (str-includes (error_message error) "BLOG_BACKUP_INVALID")))
        unchanged (and (= before (sha256 (get (file-read-result afj-tcp-wal) "data")))
                       (= (count (blog-rows "posts" 1)) 0) (= (count (blog-rows "images" 1)) 0)
                       (not (file_exists path)))]
    (println (str "BACKUP_INTEGRITY_CORRUPT_REJECT=" (if rejected "PASS" "FAIL")))
    (println (str "BACKUP_INTEGRITY_FAILURE_UNCHANGED=" (if unchanged "PASS" "FAIL")))
    (if (and (get copied "ok") rejected unchanged) nil (throw "corrupt archive accepted or changed target"))))
