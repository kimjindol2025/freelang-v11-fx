(defn check [value expected label] (if (= value expected) (println label) (throw (str "TCP_ASSERT " label))))
(defn unused-handler [event id data] nil)
(check (tcp-write "missing" "data") "not-found" "WRITE_UNKNOWN=not-found")
(check (tcp-drop "missing") "not-found" "DROP_UNKNOWN=not-found")
(check (tcp-server-stop 0) "not-running" "STOP_UNKNOWN=not-running")
(check (tcp-server-raw 0 "unused-handler" "127.0.0.1") "ok" "START=ok")
(check (tcp-server-running? 0) true "RUNNING=true")
(check (tcp-server-raw 0 "unused-handler" "127.0.0.1") "already-running" "DUPLICATE=already-running")
(check (tcp-server-stop 0) "ok" "STOP=ok")
(check (tcp-server-running? 0) false "RUNNING_AFTER_STOP=false")
(check (tcp-server-stop 0) "not-running" "STOP_AGAIN=not-running")
(check (tcp-server-raw 0 "unused-handler" "127.0.0.1") "ok" "RESTART=ok")
(check (tcp-server-stop 0) "ok" "RESTART_STOP=ok")
(check (try (do (tcp-server-raw -1 "unused-handler" "127.0.0.1") false) (catch [e] true)) true "BAD_PORT_REJECTED=PASS")
(check (tcp-server-tls 0 "unused-handler" "missing-cert" "missing-key" "127.0.0.1" "" false) "error" "BAD_TLS_CONFIG=error")
(check (get (get (fl-error-drain) 0) 2) "tls" "TLS_ERROR_SOURCE=tls")
(check (fl-error-queue-size) 0 "ERROR_DRAIN_CLEARS=0")
