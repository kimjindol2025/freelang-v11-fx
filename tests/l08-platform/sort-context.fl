(defn check [a b label] (if (= a b) (println label) (throw (str "SORT_CONTEXT_ASSERT " label " expected=" b " actual=" a))))
(define values [4 1 3 2])
(defn nested-key [n] (do (sort-by (fn [x] (- 0 x)) [3 1 2]) n))
(check (sort-by nested-key values) [1 2 3 4] "SORT_NESTED_CONTEXT=PASS")
(check values [4 1 3 2] "SORT_INPUT_UNCHANGED=PASS")
(defn nested-error-key [n] (do (try (sort-by (fn [x] (throw "inner-sort")) [2 1]) (catch [e] nil)) n))
(check (sort-by nested-error-key values) [1 2 3 4] "SORT_NESTED_ERROR_CONTEXT=PASS")
(check (try (sort-by (fn [x] (throw "outer-sort")) values) (catch [e] true)) true "SORT_ERROR_PROPAGATES=PASS")
(check (sort-by (fn [n] n) values) [1 2 3 4] "SORT_AFTER_ERROR=PASS")
(check (sort-by (fn [n] n) []) [] "SORT_EMPTY=PASS")
(define jobs (map (fn [id] (fn [] (do (atom-test-start)
 (doseq [iteration (range 0 20)]
  (if (= (sort-by (fn [n] (do (atom-test-pause) (if (= (mod id 2) 0) n (- 0 n)))) values)
         (if (= (mod id 2) 0) [1 2 3 4] [4 3 2 1]))
   true (throw "parallel sort context crossed"))) true))) (range 0 8)))
(check (run-parallel jobs) [true true true true true true true true] "SORT_CONCURRENT_CONTEXTS=PASS")
(check (atom-test-workers) 8 "SORT_ACTUAL_WORKERS=PASS")
