(load "../app/store.fl")
(load "../app/images.fl")
(load "../app/image-admin.fl")
(load "../app/blog-backup.fl")
(define path (image-disk-path "55555555555555555555555555555555" "image/gif"))
(if (and (= (count (blog-rows "posts" 1)) 1) (= (count (blog-rows "images" 1)) 1)
         (file_exists path)
         (= (sha256 (get (file-read-result path) "data")) (env-get "L08_RESTORE_IMAGE_HASH")))
  (println "BACKUP_RESTORE_AFTER_RESTART=PASS") (throw "committed restore lost image after restart"))
