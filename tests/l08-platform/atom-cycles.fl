(defn check [a b label] (if (= a b) (println label) (throw (str "ATOM_CYCLE_ASSERT " label " expected=" b " actual=" a))))
(define keeper (atom nil))
(atom-meter-start)
(atom-meter-scope (fn [] (let [a (atom nil)] (do (reset! a a) nil))))
(check (atom-meter-live) 0 "ATOM_SELF_CYCLE_RELEASED=PASS")
(atom-meter-scope (fn [] (let [a (atom nil) b (atom nil)] (do (reset! a b) (reset! b a) nil))))
(check (atom-meter-live) 0 "ATOM_TWO_CYCLE_RELEASED=PASS")
(atom-meter-scope (fn [] (do (define local-rec (fn [n] (if (= n 0) 0 (local-rec (- n 1)))))
 (check (local-rec 20) 0 "ATOM_RECURSIVE_CLOSURE_WORKS=PASS") nil)))
(check (atom-meter-live) 0 "ATOM_CLOSURE_CYCLE_RELEASED=PASS")
(atom-meter-scope (fn [] (let [a (atom nil)] (do (reset! a {"alias" a}) (reset! keeper a) nil))))
(check (atom-meter-live) 1 "ATOM_ESCAPED_CYCLE_RETAINED=PASS")
(atom-meter-scope (fn [] (let [a (deref keeper)] (do (reset! a 7) (check (deref a) 7 "ATOM_ESCAPED_CYCLE_USABLE=PASS") (reset! keeper nil)))))
(check (atom-meter-live) 0 "ATOM_ESCAPED_CYCLE_RELEASED=PASS")
(check (try (atom-meter-scope (fn [] (let [a (atom nil)] (do (reset! a a) (throw "cycle-error"))))) (catch [e] true)) true "ATOM_CYCLE_EXCEPTION=PASS")
(check (atom-meter-live) 0 "ATOM_CYCLE_EXCEPTION_RELEASED=PASS")
