(load "../app/store.fl")
(define rows (get (execute-ast {"type" "select" "table" "l08_tail"}) "rows"))
(if (and (= (count rows) 1) (= (get (first rows) "id") "kept") (= (get (first rows) "title") "원본 한🙂")) nil (throw "committed data changed before repair fault"))
(define baseline (repair-test-fds))
(repair-fault-arm (env-get "L08_REPAIR_FAULT"))
(define rejected (try
  (do (afj-tcp-commit-ast {"type" "insert" "table" "l08_tail" "row" {"id" "after-restart" "title" "재개 한🙂"}}) false)
  (catch [error] (str-includes (error_message error) "DB_WRITE_ABORTED_RESTART_REQUIRED"))))
(if (and rejected (= (repair-fault-count) 1)) (println "WAL_REPAIR_FAULT_REJECT=PASS") (throw "repair fault not observed"))
(if (= (repair-test-fds) baseline) (println "WAL_REPAIR_FAULT_NO_LEAK=PASS") (throw "repair descriptors leaked"))
(if (try (do (execute-ast {"type" "select" "table" "l08_tail"}) false) (catch [error] (str-includes (error_message error) "DB_RECOVERY_REQUIRED")))
  (println "WAL_REPAIR_FAULT_READ_BLOCKED=PASS") (throw "reads continued after repair failure"))
(if (try (do (afj-tcp-commit-ast {"type" "insert" "table" "l08_tail" "row" {"id" "forbidden" "title" "금지"}}) false)
       (catch [error] (str-includes (error_message error) "DB_RECOVERY_REQUIRED")))
  (println "WAL_REPAIR_FAULT_WRITE_BLOCKED=PASS") (throw "writes continued after repair failure"))
