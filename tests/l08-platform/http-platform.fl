(define root (get (cli-args) 0))
(define order (atom []))
(defn first-middleware [req]
 (do (if (= (server_req_path req) "/order") (reset! order ["first"]) nil)
     (if (= (server_req_path req) "/false") false nil)))
(defn second-middleware [req] (do (swap! order append "second") nil))
(defn gate [req] (if (= (server_req_header req "X-Allow") "yes") nil (server_status 401 "DENIED")))
(defn image-gate [req] (if (= (server_req_header req "X-Image-Allow") "yes") nil (server_status 403 "NO_IMAGE")))
(server_use "/*" "first-middleware")
(server_use "/order" "second-middleware")
(server_use "/guard/*" "gate")
(server_use "/assets/*" "image-gate")
(server_get "/order" (fn [req] (server_text (str_join (append (deref order) "handler") ","))))
(server_get "/false" (fn [req] (server_status 499 "HANDLER_MUST_NOT_RUN")))
(server_get "/guard/ok" (fn [req] (server_text "GUARDED")))
(server_get "/request/:id" (fn [req] (server_json
 {"id" (server_req_param req "id") "q" (server_req_query req "q") "all" (server_req_query req)
  "header" (server_req_header req "X-Repeat") "host" (server_req_header req "HOST")
  "cookie" (server_req_cookie req "token") "encoded" (server_req_cookie req "encoded")
  "method" (server_req_method req) "path" (server_req_path req)})))
(server_get "/long" (fn [req] (server_json {"length" (count (server_req_query req "pad")) "last" (server_req_query req "last")})))
(server_get "/param/:id" (fn [req] (server_text (str (count (server_req_param req "id"))))))
(server_get "/html" (fn [req] (server_html "<b>HTML</b>" 201)))
(server_get "/created" (fn [req] (server_json 201 {"n" 0.1})))
(server_get "/conflict" (fn [req] (server_status 409 {"error" "conflict"})))
(server_post "/echo" (fn [req] (server_json {"json" (server_req_json req) "body" (get req "body")})))
(define base-response (server_text "BASE"))
(server_get "/base" (fn [req] base-response))
(server_get "/header" (fn [req] (server_header base-response "X-Label" "added")))
(server_get "/bad-header" (fn [req] (server_header (server_text "NO_SPLIT") "X-Unsafe" "safe\r\nInjected: bad")))
(server_get "/cookies" (fn [req]
 (let [one (server_set_cookie "one" "a b" {"secure" false "same_site" "Lax" "max_age" 0})
       two (server_set_cookie "two" "x=y" {})]
  (server_header (server_redirect_cookie "/after" one) "Set-Cookie" [one two]))))
(server_static (str root "/static") "/assets")
(server_get "/*" (fn [req] (server_status 404 "FALLBACK")))
(server_post "/*" (fn [req] (server_status 404 "FALLBACK")))
(server_body_limit 512)
(server_start 0)
