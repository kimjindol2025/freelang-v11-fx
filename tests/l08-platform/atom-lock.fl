(defn check [a b label] (if (= a b) (println label) (throw (str "ATOM_LOCK_ASSERT " label " actual=" a))))
(define guard (atom "guard"))
(define state (atom 0))
(check (with-atom-lock guard (fn [] "한🙂")) "한🙂" "ATOM_LOCK_RETURN=PASS")
(check (deref guard) "guard" "ATOM_LOCK_GUARD_UNCHANGED=PASS")
(define jobs (map (fn [id] (fn [] (do (atom-test-start) (doseq [n (range 0 100)]
 (with-atom-lock guard (fn [] (let [old (deref state)] (do (atom-test-tick) (atom-test-pause) (reset! state (+ old 1))))))) true))) (range 0 8)))
(check (run-parallel jobs) [true true true true true true true true] "ATOM_LOCK_WORKERS_JOINED=PASS")
(check (atom-test-workers) 8 "ATOM_LOCK_ACTUAL_WORKERS=PASS")
(check (deref state) 800 "ATOM_LOCK_COMPOUND_TOTAL=PASS")
(check (atom-test-ticks) 800 "ATOM_LOCK_CALLBACK_ONCE=PASS")
(check (with-atom-lock guard (fn [] (with-atom-lock guard (fn [] (do (reset! guard "changed") 42))))) 42 "ATOM_LOCK_REENTRANT=PASS")
(check (deref guard) "changed" "ATOM_LOCK_CALLBACK_EFFECT=PASS")
(check (try (with-atom-lock guard (fn [] (throw "lock-error"))) (catch [e] (str-includes (error_message e) "lock-error"))) true "ATOM_LOCK_ERROR_PROPAGATES=PASS")
(check (run-parallel [(fn [] (with-atom-lock guard (fn [] 7)))]) [7] "ATOM_LOCK_ERROR_UNLOCKS=PASS")
(define order (atom []))
(check (with-atom-lock (do (swap! order append "guard") guard) (do (swap! order append "callback") (fn [] (do (swap! order append "run") 9)))) 9 "ATOM_LOCK_EVALUATION_RETURN=PASS")
(check (deref order) ["guard" "callback" "run"] "ATOM_LOCK_EVALUATION_ORDER=PASS")
(define pair (atom-test-independent-pair))
(check (run-parallel [(fn [] (with-atom-lock (get pair 0) (fn [] (if (atom-test-wait-peer) 1 (throw "peer blocked")))))
 (fn [] (if (atom-test-wait-owner) (with-atom-lock (get pair 1) (fn [] (do (atom-test-signal-peer) 1))) (throw "owner blocked")))]) [1 1] "ATOM_LOCK_DISTINCT_PROGRESS=PASS")
(check (try (with-atom-lock [1] (fn [] 1)) (catch [e] true)) true "ATOM_LOCK_REJECT_VECTOR=PASS")
(check (try (with-atom-lock nil (fn [] 1)) (catch [e] true)) true "ATOM_LOCK_REJECT_NIL=PASS")
(check (try (with-atom-lock guard 2) (catch [e] true)) true "ATOM_LOCK_REJECT_CALLBACK=PASS")
(check (run-parallel [(fn [] (with-atom-lock guard (fn [] 8)))]) [8] "ATOM_LOCK_VALIDATION_NO_LOCK_LEAK=PASS")
