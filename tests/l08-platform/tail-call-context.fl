(defn check [a b label] (if (= a b) (println label) (throw (str "TAIL_CONTEXT_ASSERT " label " expected=" b " actual=" a))))
(defn leaf [] (throw "boom"))
(defn via-if [] (if true (leaf) nil))
(defn via-let [] (let [value true] (if value (leaf) nil)))
(defn value-if [] (let [value (if true (leaf) nil)] value))
(defn sink [value] value)
(defn argument-if [] (sink (if true (leaf) nil)))
(check (try (via-if) (catch [error] (error_message error))) "boom" "IF_TAIL_CONTEXT=PASS")
(check (try (via-let) (catch [error] (error_message error))) "boom" "LET_BODY_TAIL_CONTEXT=PASS")
(check (try (value-if) (catch [error] (error_message error))) "[leaf] boom" "LET_VALUE_CONTEXT=PASS")
(check (try (argument-if) (catch [error] (error_message error))) "[leaf] boom" "ARGUMENT_VALUE_CONTEXT=PASS")
(defn even-depth [n] (if (= n 0) true (odd-depth (- n 1))))
(defn odd-depth [n] (if (= n 0) false (even-depth (- n 1))))
(check (even-depth 5000) true "MUTUAL_TAIL_DEPTH_5000=PASS")
(defn tail-error [n] (if (= n 0) (leaf) (tail-error (- n 1))))
(check (try (tail-error 5000) (catch [error] (error_message error))) "boom" "DEEP_TAIL_ERROR=PASS")
