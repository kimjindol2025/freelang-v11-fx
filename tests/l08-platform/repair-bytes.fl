(defn check [actual expected label] (if (= actual expected) (println label) (throw (str "REPAIR_BYTES_ASSERT " label))))
(repair-test-setup)
(define data (get (file-read-result "all-bytes") "data"))
(check (bytes-count data) 256 "REPAIR_BYTES_COUNT=PASS")
(check (bytes_count "한🙂") 7 "REPAIR_BYTES_UTF8_COUNT=PASS")
(check (length "한🙂") 3 "REPAIR_BYTES_TEXT_LENGTH_UNCHANGED=PASS")
(doseq [i (range 0 256)] (if (= (repair-test-byte (bytes-slice data i (+ i 1))) i) nil (throw "raw byte changed")))
(println "REPAIR_BYTES_ALL_VALUES=PASS")
(check (bytes-count (bytes-slice data 0 0)) 0 "REPAIR_BYTES_EMPTY=PASS")
(check (bytes-slice "한🙂" 0 3) "한" "REPAIR_BYTES_UTF8_PREFIX=PASS")
(check (bytes-slice "한🙂" 3 7) "🙂" "REPAIR_BYTES_UTF8_SUFFIX=PASS")
(check (get (file-write-result "copied" (bytes-slice data 0 256)) "ok") true "REPAIR_BYTES_WRITE=PASS")
(check (sha256 (get (file-read-result "copied") "data")) (sha256 data) "REPAIR_BYTES_ROUNDTRIP=PASS")
(check (try (do (bytes-count 1) false) (catch [e] true)) true "REPAIR_BYTES_REJECT_TYPE=PASS")
(check (try (do (bytes-slice data -1 1) false) (catch [e] true)) true "REPAIR_BYTES_REJECT_NEGATIVE=PASS")
(check (try (do (bytes-slice data 2 1) false) (catch [e] true)) true "REPAIR_BYTES_REJECT_REVERSED=PASS")
(check (try (do (bytes-slice data 0 257) false) (catch [e] true)) true "REPAIR_BYTES_REJECT_END=PASS")
(check (try (do (bytes-slice data 0.5 1) false) (catch [e] true)) true "REPAIR_BYTES_REJECT_FRACTION=PASS")
(define order (atom []))
(bytes_slice (do (swap! order append 1) data) (do (swap! order append 2) 0) (do (swap! order append 3) 1))
(check (deref order) [1 2 3] "REPAIR_BYTES_ARGUMENT_ORDER=PASS")
