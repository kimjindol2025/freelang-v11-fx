(defn check [a b] (if (= a b) true (throw (str "expected=" b " actual=" a))))
(define ticks (atom []))
(println (check (try 7 (finally (swap! ticks append "success"))) 7))
(println (check (try (throw "body") (catch [e] (swap! ticks append "catch") (error_message e)) (finally (swap! ticks append "finally"))) "body"))
(println (check (try (try (throw "first") (catch [e] (throw "second")) (finally (swap! ticks append "failed-catch"))) (catch [e] (error_message e))) "second"))
(println (check (try (try (throw "uncaught") (finally (swap! ticks append "uncaught-finally"))) (catch [e] (error_message e))) "uncaught"))
(println (check (try (try "result" (finally (throw "override"))) (catch [e] (error_message e))) "override"))
(println (check (deref ticks) ["success" "catch" "finally" "failed-catch" "uncaught-finally"]))
(println (check (try (throw {"message" false "type" "Custom" "extra" 42}) (catch [e] [(get e "message") (get e "type") (get (get e "raw") "extra") (get e "extra")])) [false "Custom" 42 nil]))
(println (check (try (throw 3) (catch [e] [(get e "message") (get e "type") (get e "raw")])) ["3" "RuntimeError" 3]))
(defn make-handler [prefix]
 (fn [x] (try (throw x) (catch [error] (str prefix (error_message error))))))
(println (check ((make-handler "prefix:") "hi") "prefix:hi"))
(define outside "outside")
(println (check (try (throw "inside") (catch [outside] (error_message outside))) "inside"))
(println (check outside "outside"))
