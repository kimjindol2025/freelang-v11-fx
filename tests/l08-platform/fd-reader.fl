(defn check [a b] (if (= a b) true (throw (str "expected=" b " actual=" a))))
(define root (get (cli-args) 0))
(define path (str root "/synthetic.wal"))
(define expected "{\"op\":\"image-add\",\"id\":\"img-한\"}\n{\"op\":\"image-delete\",\"id\":\"img-한\"}\n")
(define handle (fd_open path "r"))
(println (check (>= handle 1000) true))
(println (check (fd_read handle 65536) expected))
(println (check (fd-read handle 1) ""))
;; v11 fd_seek is a size query; it does not reposition the cursor.
(println (check (fd_seek handle 0 0) (file_size path)))
(println (check (fd_read handle 1) ""))
(println (check (fd_close handle) true))
(println (check (try (do (fd_read handle 1) false) (catch [e] (str_starts (error_message e) "fd_read failed"))) true))
(println (check (try (do (fd_close handle) false) (catch [e] (str_starts (error_message e) "fd_close failed"))) true))
(println (check (try (do (fd_close -1) false) (catch [e] (str_starts (error_message e) "fd_close failed"))) true))
(println (check (try (do (fd_open path "invalid") false) (catch [e] (str_starts (error_message e) "fd_open failed"))) true))
(define readonly (fd_open path "r"))
(println (check (try (do (fd_write readonly "bad") false) (catch [e] (str_starts (error_message e) "fd_write failed"))) true))
(println (check (try (do (fd_read readonly -1) false) (catch [e] (str_starts (error_message e) "fd_read failed"))) true))
(println (check (fd_close readonly) true))
