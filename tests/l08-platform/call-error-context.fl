(defn check [a b label] (if (= a b) (println label) (throw (str "CALL_CONTEXT_ASSERT " label " expected=" b " actual=" a))))
(defn leaf [] (throw "boom"))
(defn outer [] (leaf))
(check (try (leaf) (catch [error] (error_message error))) "boom" "DIRECT_CALL=PASS")
(check (try (outer) (catch [error] (error_message error))) "[leaf] boom" "NESTED_CALL=PASS")
(defn prefixed [] (throw "[prefixed] keep"))
(check (try (prefixed) (catch [error] (error_message error))) "keep" "PREFIX_ONCE=PASS")
(defn paren [] (throw "(paren) keep"))
(check (try (paren) (catch [error] (error_message error))) "(paren) keep" "PAREN_PREFIX=PASS")
(defn sink [unused] unused)
(check (try (sink (leaf)) (catch [error] (error_message error))) "boom" "ARGUMENT_CONTEXT=PASS")
(defn handled [] (try (leaf) (catch [error] (error_message error))))
(check (handled) "boom" "LOCAL_CATCH=PASS")
(check (try (outer) (catch [error] (error_message error))) "[leaf] boom" "AFTER_CATCH=PASS")
