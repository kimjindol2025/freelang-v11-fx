(defn check [a b] (if (= a b) true (throw (str "expected=" b " actual=" a))))
(define root (get (cli-args) 0))
(define key (file_read (str root "/csrf.key")))
(define data (json_parse (file_read (str root "/csrf.json"))))
(check (auth_csrf_token key) (get data "now"))
(doseq [name ["now" "boundary" "padded"]] (check (auth_csrf_verify (get data name) key) true))
(doseq [name ["expired" "future" "invalid"]] (check (auth_csrf_verify (get data name) key) false))
(check (auth-csrf-verify (get data "now") "wrong") false)
(check (auth_csrf_verify "one.two.three" key) false)
(check (auth_csrf_verify nil key) false)
(check (auth_csrf_verify "" key) false)
(define parts (str_split (get data "now") "."))
(define signature (get parts 1))
(define changed (str (get parts 0) "." (if (= (get signature 0) "0") "1" "0") (str_slice signature 1)))
(check (auth_csrf_verify changed key) false)
(println "AUTH_CSRF_PASS")
