(defn check [a b] (if (= a b) true (throw (str "expected=" b " actual=" a))))
(define root (get (cli-args) 0))
(define payload (file_read (str root "/payload")))
(define fd (fd_open (str root "/payload") "r"))
(println (check (fd_read fd 0) ""))
(println (check (fd_read fd 1) "�"))
(println (check (fd_read fd 2) "��"))
(println (check (fd_read fd 1) (str_slice payload 1 2)))
(println (check (fd_read fd 3) "끝"))
(println (check (fd_close fd) true))
(doseq [path ["link-file" "link-dir/sentinel" "../outside/sentinel" "." "fifo"]]
 (doseq [mode ["r" "w" "a"]]
  (println (check (try (do (fd_open (str root "/" path) mode) false) (catch [e] (str_starts (error_message e) "fd_open failed"))) true))))
(define limit (fd_open (str root "/limit.wal") "a"))
(println (check (try (do (fd_write limit "x") false) (catch [e] (str_starts (error_message e) "fd_write failed"))) true))
(println (check (file_size (str root "/limit.wal")) 67108864))
(println (check (try (do (fd_read limit 67108865) false) (catch [e] (str_starts (error_message e) "fd_read failed"))) true))
(println (check (fd_close limit) true))
(println (check (try (do (fd_open (str root "/payload") (str_slice payload 1 2)) false) (catch [e] (str_starts (error_message e) "fd_open failed"))) true))
