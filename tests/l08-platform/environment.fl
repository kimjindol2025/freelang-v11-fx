(defn check [a b] (if (= a b) true (throw (str "expected=" b " actual=" a))))
(println (check (env_get "L08_ABSENT_TEST") nil))
(println (check (env-get "L08_EMPTY_TEST") nil))
(println (check (env_or "L08_EMPTY_TEST" 17) 17))
(println (check (env-or "L08_ABSENT_TEST" false) false))
(println (check (env_or "L08_VALUE_TEST" "fallback") "한글"))
(define calls (atom 0))
(println (check (env_or "L08_VALUE_TEST" (do (swap! calls (fn [n] (+ n 1))) "fallback")) "한글"))
(println (check (deref calls) 1))
(println (check (error_message "sample") "sample"))
(println (check (error-message nil) "null"))
(println (check (error_message false) "false"))
(println (check (error_message {"message" 42}) "42"))
(println (check (error_message {"message" false}) "[object Object]"))
(println (check (error_message {}) "[object Object]"))
(println (check (error_message {"message" ["a" nil "b"]}) "a,,b"))
(println (check (try (throw "nested") (catch e (error_message e))) "nested"))
(define ids (map (fn [n] (uuid_short)) (range 0 512)))
(println (check (every? (fn [id] (regex_match id "^[0-9a-f]{8}$")) ids) true))
(println (check (length (arr_unique ids)) 512))
