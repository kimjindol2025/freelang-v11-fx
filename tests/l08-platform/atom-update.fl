(defn check [a b label] (if (= a b) (println label) (throw (str "ATOM_UPDATE_ASSERT " label " expected=" b " actual=" a))))
(define counter (atom 0))
(defn counted-add [old delta] (do (atom-test-tick) (atom-test-pause) (+ old delta)))
(define jobs (map (fn [id] (fn [] (do (atom-test-start) (doseq [n (range 0 100)] (swap! counter counted-add 1)) true))) (range 0 8)))
(check (run-parallel jobs) [true true true true true true true true] "ATOM_WORKERS_JOINED=PASS")
(check (atom-test-workers) 8 "ATOM_ACTUAL_WORKERS=PASS")
(check (deref counter) 800 "ATOM_CONCURRENT_TOTAL=PASS")
(check (atom-test-ticks) 800 "ATOM_CALLBACK_EXACTLY_ONCE=PASS")
(define state (atom {"n" 0 "text" "한🙂"}))
(define map-jobs (map (fn [id] (fn [] (do (atom-test-start) (doseq [n (range 0 100)] (swap! state (fn [old] (do (atom-test-pause) (assoc old "n" (+ (get old "n") 1)))))) true))) (range 0 8)))
(check (run-parallel map-jobs) [true true true true true true true true] "ATOM_MAP_WORKERS_JOINED=PASS")
(check (get (deref state) "n") 800 "ATOM_MAP_TOTAL=PASS")
(check (get (deref state) "text") "한🙂" "ATOM_MAP_TEXT=PASS")
(define nested (atom 1))
(check (swap! nested (fn [old] (do (reset! nested 99) (+ old 1)))) 2 "ATOM_NESTED_RESET_RETURN=PASS")
(check (deref nested) 2 "ATOM_NESTED_RESET_STORED=PASS")
(check (swap! nested (fn [old] (do (swap! nested + 10) (+ old 1)))) 3 "ATOM_NESTED_SWAP_RETURN=PASS")
(check (deref nested) 3 "ATOM_NESTED_SWAP_STORED=PASS")
(check (try (swap! nested (fn [old] (throw "atom-callback-error"))) (catch [e] true)) true "ATOM_ERROR_PROPAGATES=PASS")
(check (deref nested) 3 "ATOM_ERROR_UNCHANGED=PASS")
(check (run-parallel [(fn [] (swap! nested + 1))]) [4] "ATOM_ERROR_UNLOCKS_FOR_PEER=PASS")
(check (try (swap! nested (fn [old] (do (reset! nested 33) (throw "after-reset")))) (catch [e] true)) true "ATOM_NESTED_ERROR_PROPAGATES=PASS")
(check (deref nested) 33 "ATOM_ERROR_PRESERVES_CALLBACK_EFFECT=PASS")
(check (run-parallel [(fn [] (swap! nested + 1))]) [34] "ATOM_NESTED_ERROR_UNLOCKS=PASS")
(define pair (atom-test-independent-pair))
(define left (get pair 0))
(define right (get pair 1))
(check (run-parallel [(fn [] (swap! left (fn [old] (if (atom-test-wait-peer) (+ old 1) (throw "independent peer blocked")))))
                      (fn [] (if (atom-test-wait-owner) (do (swap! right + 1) (atom-test-signal-peer) 1) (throw "independent owner blocked")))])
       [1 1] "ATOM_DISTINCT_PROGRESS=PASS")
(check (deref left) 1 "ATOM_DISTINCT_LEFT=PASS")
(check (deref right) 1 "ATOM_DISTINCT_RIGHT=PASS")
