(load "../app/store.fl")
(ensure-table "l08_fault" [{"name" "id" "type" "TEXT" "nullable" false "primary" true}] "id" [])
(define mode (env-get "L08_WAL_FAULT_MODE"))
(define wanted (if (= mode "commit-sync") "DB_COMMIT_UNCERTAIN_RESTART_REQUIRED"
 (if (= mode "commit-close") "DB_COMMITTED_RESTART_REQUIRED" "DB_WRITE_ABORTED_RESTART_REQUIRED")))
(store-fault-arm mode)
(define diagnosis (try (do (afj-tcp-commit-ast {"type" "insert" "table" "l08_fault" "row" {"id" "first"}}) false)
 (catch [error] (str-includes (error_message error) wanted))))
(define open-count (store-fault-open-count))
(define read-blocked (try (do (execute-ast {"type" "select" "table" "l08_fault"}) false) (catch [error] (str-includes (error_message error) "DB_RECOVERY_REQUIRED"))))
(define write-blocked (try (do (afj-tcp-commit-ast {"type" "insert" "table" "l08_fault" "row" {"id" "second"}}) false) (catch [error] (str-includes (error_message error) "DB_RECOVERY_REQUIRED"))))
(println (str "WAL_FAULT_DIAGNOSIS=" diagnosis))
(println (str "WAL_FAULT_INJECTED=" (store-fault-count)))
(println (str "WAL_FAULT_OPEN_DESCRIPTORS=" open-count))
(println (str "WAL_FAULT_READ_BLOCKED=" read-blocked))
(println (str "WAL_FAULT_WRITE_BLOCKED=" write-blocked))
(if (and diagnosis (= (store-fault-count) 1) (= open-count 0) read-blocked write-blocked)
 (println "WAL_FAULT_WRITE=PASS") (throw "WAL_FAULT_WRITE_MISMATCH"))
