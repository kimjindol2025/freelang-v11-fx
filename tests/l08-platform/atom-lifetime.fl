(defn check [a b label] (if (= a b) (println label) (throw (str "ATOM_LIFETIME_ASSERT " label " expected=" b " actual=" a))))
(define jobs (map (fn [id] (fn [] (do (atom-meter-barrier)
 (doseq [n (range 0 250)] (atom-meter-scope (fn [] (let [a (atom {"n" n "text" "한🙂"})] (do (swap! a assoc "n" (+ n 1)) nil))))) true))) (range 0 8)))
(atom-meter-start)
(atom-meter-scope (fn [] (do (doseq [n (range 0 1000)] (let [a (atom {"n" n "text" "한🙂"})] (reset! a {"n" (+ n 1)}))) nil)))
(check (>= (atom-meter-created) 1000) true "ATOM_METER_OBSERVED_ALLOCATIONS=PASS")
(check (atom-meter-live) 0 "ATOM_TEMPORARY_RELEASED=PASS")
(atom-meter-scope (fn [] (let [a (atom-meter-scope (fn [] (atom 1)))]
 (do (reset! a 7) (check (deref a) 7 "ATOM_RETURNED_IDENTITY=PASS")))))
(check (atom-meter-live) 0 "ATOM_RETURNED_RELEASED=PASS")
(atom-meter-scope (fn [] (let [f (atom-meter-scope (fn [] (let [a (atom 1)] (fn [] (swap! a + 1)))))]
 (do (check (f) 2 "ATOM_CAPTURE_FIRST=PASS") (check (f) 3 "ATOM_CAPTURE_SECOND=PASS")))))
(check (atom-meter-live) 0 "ATOM_CAPTURE_RELEASED=PASS")
(atom-meter-scope (fn [] (let [a (atom 0)]
 (check (run-parallel [(fn [] (swap! a + 1))]) [1] "ATOM_WORKER_CAPTURE=PASS"))))
(check (atom-meter-live) 0 "ATOM_WORKER_CAPTURE_RELEASED=PASS")
(atom-meter-scope (fn [] (let [values (run-parallel [(fn [] (atom 3))]) a (get values 0)]
 (do (reset! a 4) (check (deref a) 4 "ATOM_WORKER_RETURN=PASS")))))
(check (atom-meter-live) 0 "ATOM_WORKER_RETURN_RELEASED=PASS")
(atom-meter-scope (fn [] (let [box (atom-meter-scope (fn [] (let [a (atom 0)] {"items" [a a]})))
                                  a (get (get box "items") 0) b (get (get box "items") 1)]
 (do (reset! a 9) (check (deref b) 9 "ATOM_CONTAINER_ALIAS=PASS")))))
(check (atom-meter-live) 0 "ATOM_CONTAINER_RELEASED=PASS")
(atom-meter-scope (fn [] (let [a (atom 0) box (atom (repeat 1024 a))]
 (do (reset! a 11) (check (deref (get (deref box) 1023)) 11 "ATOM_MANY_STRONG_REFERENCES=PASS")))))
(check (atom-meter-live) 0 "ATOM_MANY_REFERENCES_RELEASED=PASS")
(check (try (atom-meter-scope (fn [] (let [a (atom {"kept" "error"})] (throw "lifetime-error")))) (catch [e] true)) true "ATOM_EXCEPTION_PROPAGATES=PASS")
(check (atom-meter-live) 0 "ATOM_EXCEPTION_RELEASED=PASS")
(check (run-parallel jobs) [true true true true true true true true] "ATOM_LIFETIME_8_THREADS=PASS")
(check (atom-meter-live) 0 "ATOM_CONCURRENT_RELEASED=PASS")
