;; DB95-7 fixed oracle: AFJ spelling is text first, pattern second.
(defn check-regex [label actual expected]
  (if (= actual expected)
    (println (str label "=PASS"))
    (throw (str label "=FAIL"))))
(check-regex "REGEX_I_LOWER_KEYWORD" (regex-match-i "select" "^SELECT$") true)
(check-regex "REGEX_I_MIXED_KEYWORD" (regex-match-i "SeLeCt" "^SELECT$") true)
(check-regex "REGEX_I_ANCHOR_MISS" (regex-match-i "selectors" "^SELECT$") false)
(check-regex "REGEX_I_TEXT_FIRST" (regex-match-i "Abc" "^a") true)
(check-regex "REGEX_I_REVERSED_MISS" (regex-match-i "^a" "Abc") false)
(check-regex "REGEX_I_UNANCHORED" (regex-match-i "bad UNIQUE_violation note" "unique_violation") true)
(check-regex "REGEX_I_ALTERNATION" (regex-match-i "Not Supported select" ".*(unsupported|not supported).*SELECT.*") true)
(check-regex "REGEX_I_CHARACTER_CLASS" (regex-match-i "aBc123" "^[A-Z]+[0-9]+$") true)
(check-regex "REGEX_I_EMPTY_TEXT" (regex-match-i "" "^$") true)
(check-regex "REGEX_I_EMPTY_PATTERN" (regex-match-i "text" "") true)
(check-regex "REGEX_I_EMPTY_MATCH" (regex-match-i "bbb" "a*") true)
(check-regex "REGEX_I_LITERAL_ESCAPE" (regex-match-i "[ABC]" "\\[abc\\]") true)
(check-regex "REGEX_I_NESTED_GROUP" (regex-match-i "abc" "^(A(B|D))C$") true)
(check-regex "REGEX_I_QUANTIFIER" (regex-match-i "aaBBB" "^a{2}b+$") true)
(check-regex "REGEX_I_NO_MATCH" (regex-match-i "where" "^SELECT$") false)
;; Existing native API keeps its pattern-first order and case sensitivity.
(check-regex "REGEX_LEGACY_PATTERN_FIRST" (regex-match "^A+$" "AAA") true)
(check-regex "REGEX_LEGACY_CASE_SENSITIVE" (regex-match "^A+$" "aaa") false)
(check-regex "REGEX_LEGACY_INVALID_FALSE" (regex-match "[" "text") false)
(println "REGEX_MATCH_I_CASES=18 FAIL=0")
