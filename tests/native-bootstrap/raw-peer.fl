(define port (str-to-num (env-get "FX_RAW_TEST_PORT")))

(fl-tcp-server-raw port
  (fn [event conn payload address peer-port]
    (if (= event "connect")
      (fl-tcp-write conn
        (if (and (= address "127.0.0.1") (> peer-port 0))
          "RAW_PEER=PASS\n"
          "RAW_PEER=FAIL\n"))
      nil))
  "127.0.0.1")

(loop [i 0]
  (if (< i 100) (do (fl-tcp-yield 100) (recur (+ i 1))) nil))
