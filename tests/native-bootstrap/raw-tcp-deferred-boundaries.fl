(define mode (env-get "FX_RAW_PROBE_MODE"))
(define port (str-to-num (env-get "FX_RAW_TEST_PORT")))
(define big-response
  (if (= mode "slow")
    (str-repeat "x" 16777216)
    (if (= mode "large-response") (str-repeat "R" 8192) "")))

(defn raw-boundary-handler [event conn payload address peer-port]
  (if (= event "connect")
    (if (= mode "slow")
      (println (str "RAW_SLOW_WRITE_RESULT=" (fl-tcp-write conn big-response)))
      (if (= mode "large-response")
        (println (str "RAW_LARGE_RESPONSE_RESULT=" (fl-tcp-write conn big-response)))
        nil))
    (if (= event "data")
      (if (= mode "nul")
        (do
          (println (str "RAW_DATA_LEN=" (length payload)))
          (println (str "RAW_BINARY_WRITE_RESULT=" (fl-tcp-write conn payload))))
        (println (str "RAW_DATA_LEN=" (length payload))))
      nil)))

(if (= mode "float-yield")
  (loop [i 0]
    (if (< i 100)
      (do (fl-tcp-yield 0.5) (recur (+ i 1)))
      (println "RAW_FLOAT_YIELD_DONE=1")))
  (if (= mode "empty-host")
    (println (str "RAW_EMPTY_HOST_RESULT="
                  (fl-tcp-server-raw port raw-boundary-handler "")))
    (if (= mode "null-host")
      (println (str "RAW_NULL_HOST_RESULT="
                    (fl-tcp-server-raw port raw-boundary-handler nil)))
      (let [started (fl-tcp-server-raw port raw-boundary-handler "127.0.0.1")]
        (println (str "RAW_SERVER_RESULT=" started))
        (if (= started "ok")
          (loop [i 0]
            (if (< i 50)
              (do (fl-tcp-yield 100) (recur (+ i 1)))
              nil))
          nil)
        (fl-tcp-server-stop)))))
