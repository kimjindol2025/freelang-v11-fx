;; Native FreeLang tests. C support supplies independent byte comparisons and
;; test-binary-only fault injection, never replacements for the public calls.
(l07-check (= (sha256 "abc") "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") "sha256-known-answer")
(define initial-fds (l07-fd-count))

(defn roundtrip [name]
  (let [r (file-read-result name)
        data (get r "data")
        n (l07-raw-size name)]
    (do
      (l07-check (get r "ok") (str name ":read-ok"))
      (l07-check (= (get r "bytes") n) (str name ":read-length"))
      (l07-check (= (sha256 data) (sha256 (file-read name))) (str name ":legacy-read-hash"))
      (let [w (file-write-result "output" data)]
        (do
          (l07-check (get w "ok") (str name ":write-ok"))
          (l07-check (= (get w "bytes") n) (str name ":write-length"))
          (l07-check (l07-same name "output") (str name ":write-bytes"))))
      (let [w (file-write "legacy" data)]
        (do
          (l07-check (null? w) (str name ":legacy-write-nil"))
          (l07-check (l07-same name "legacy") (str name ":legacy-write-bytes"))))
      (file-write-result "appended" "P")
      (let [a (file-append-result "appended" data)]
        (do
          (l07-check (get a "ok") (str name ":append-ok"))
          (l07-check (= (get a "bytes") n) (str name ":append-length"))
          (l07-check (l07-append-matches name "appended") (str name ":append-bytes"))))
      (let [c (file-copy-result name "copied")]
        (do
          (l07-check (get c "ok") (str name ":copy-ok"))
          (l07-check (= (get c "bytes") n) (str name ":copy-length"))
          (l07-check (l07-same name "copied") (str name ":copy-bytes")))))))

(map roundtrip ["empty" "text" "nul-first" "nul-middle" "nul-last" "all-bytes"
                "non-utf8" "boundary-8191" "boundary-8192" "boundary-8193" "multi-block"])
(define payload (get (file-read-result "nul-middle") "data"))
(_fl_file_write "alias" payload)
(l07-check (l07-same "nul-middle" "alias") "read-write-underscore-alias")
(l07-check (= (sha256 (_fl_file_read "alias")) "76fe3925c7167317f2df68454339f5ec3650e4062178b4f2be219b105a507907") "read-underscore-binary-hash")
(file-write-result "appended" "P")
(l07-check (_fl_file_append "appended" payload) "append-underscore-return")
(l07-check (l07-append-matches "nul-middle" "appended") "append-underscore-bytes")
(l07-check (_fl_file_copy "all-bytes" "copied") "copy-underscore-return")
(l07-check (l07-same "all-bytes" "copied") "copy-underscore-bytes")
(file-write-result "appended" "P")
(l07-check (file-append "appended" payload) "append-kebab-return")
(l07-check (l07-append-matches "nul-middle" "appended") "append-kebab-bytes")
(file-write "number" 42)
(l07-check (= (file-read "number") "42") "legacy-nonstring-display")
(l07-check (get (file-read-result (l07-bad-value "absolute")) "ok") "sandbox-absolute-inside")
(l07-check (get (file-read-result "./text") "ok") "sandbox-relative-dot")

(l07-error (file-read-result "") "INVALID_PATH" "empty-path")
(l07-error (file-read-result 42) "INVALID_PATH" "wrong-path-type")
(l07-error (file-write-result "sentinel" 42) "INVALID_DATA" "wrong-data-type")
(l07-error (file-write-result (l07-bad-value "nul-path") payload) "INVALID_PATH" "nul-path-before-truncate")
(l07-error (file-read-result (l07-bad-value "long-path")) "INVALID_PATH" "long-path")
(l07-error (file-read-result "missing") "OPEN_FAILED" "missing-input")
(l07-error (file-write-result "missing-parent/out" payload) "OPEN_FAILED" "missing-parent")
(l07-error (file-write-result "readonly" payload) "OPEN_FAILED" "readonly-output")
(l07-error (file-write-result "." payload) "OPEN_FAILED" "directory-output")
(l07-error (file-read-result ".") "UNSUPPORTED_FILE" "directory-input")
(l07-error (file-read-result "fifo") "UNSUPPORTED_FILE" "fifo-does-not-block")
(l07-error (file-read-result "../outside") "PATH_OUTSIDE_BASE" "parent-traversal")
(l07-error (file-write-result (l07-bad-value "outside") payload) "PATH_OUTSIDE_BASE" "absolute-traversal")
(l07-error (file-write-result (l07-bad-value "outside-direct") payload) "PATH_OUTSIDE_BASE" "absolute-outside-root")
(l07-check (not (get (file-write-result "symlink" payload) "ok")) "symlink-leaf-rejected")
(l07-check (not (get (file-write-result "symlink-dir/outside" payload) "ok")) "symlink-parent-rejected")
(l07-error (file-copy-result "text" "text") "SAME_FILE" "copy-same-path-preserves-input")
(l07-error (file-copy-result "text" "hardlink") "SAME_FILE" "copy-same-inode-preserves-input")
(l07-check (= (file-read "sentinel") "abc") "rejections-preserve-sentinel")
(l07-check (= (file-read "text") "abc") "copy-rejections-preserve-source")
(l07-check (null? (file-read "missing")) "legacy-read-failure-nil")
(l07-check (not (file-append "missing-parent/out" payload)) "legacy-append-failure-false")
(l07-check (not (_fl_file_copy "missing" "output")) "legacy-copy-failure-false")

(l07-error (file-read-result "too-large") "SIZE_LIMIT" "read-size-limit")
(l07-error (file-copy-result "too-large" "sentinel") "SIZE_LIMIT" "copy-size-limit-before-truncate")
(l07-error (file-write-result "sentinel" (l07-bad-value "oversize")) "SIZE_LIMIT" "write-size-limit-before-truncate")
(l07-error (file-append-result "limit" "X") "SIZE_LIMIT" "append-total-size-limit")
(l07-check (= (file-read "sentinel") "abc") "size-errors-preserve-sentinel")
(define limit (file-read-result "limit"))
(l07-check (get limit "ok") "read-exact-limit")
(l07-check (= (get limit "bytes") 67108864) "read-exact-limit-bytes")
(l07-check (get (file-write-result "limit-out" (get limit "data")) "ok") "write-exact-limit")
(l07-check (l07-same "limit" "limit-out") "write-exact-limit-bytes")

(l07-arm "read-short")
(define short-read (file-read-result "text"))
(l07-check (get short-read "ok") "short-read-retries")
(l07-check (= (sha256 (get short-read "data")) "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") "short-read-bytes")
(l07-arm "write-short")
(l07-check (get (file-write-result "fault-out" payload) "ok") "short-write-retries")
(l07-check (l07-same "nul-middle" "fault-out") "short-write-bytes")
(l07-arm "read-fail")
(l07-error (file-read-result "text") "READ_FAILED" "read-failure")
(l07-arm "write-fail")
(l07-error (file-write-result "fault-out" payload) "WRITE_FAILED" "write-failure")
(l07-arm "flush-fail")
(l07-error (file-write-result "fault-out" payload) "WRITE_FAILED" "flush-failure")
(l07-arm "close-fail")
(l07-error (file-write-result "fault-out" payload) "CLOSE_FAILED" "write-close-failure")
(l07-arm "close-fail")
(l07-error (file-read-result "text") "CLOSE_FAILED" "read-close-failure")
(l07-arm "allocation-fail")
(l07-error (file-read-result "text") "ALLOCATION_FAILED" "read-allocation-failure")
(l07-arm "stat-fail")
(l07-error (file-read-result "text") "OPEN_FAILED" "stat-failure")
(l07-arm "stream-fail")
(l07-error (file-read-result "text") "OPEN_FAILED" "read-stream-failure")
(l07-arm "stream-fail")
(l07-error (file-write-result "fault-out" payload) "OPEN_FAILED" "write-stream-failure")
(l07-arm "truncate-fail")
(l07-error (file-write-result "sentinel" payload) "WRITE_FAILED" "truncate-failure")
(l07-check (= (file-read "sentinel") "abc") "truncate-error-preserves-file")
(l07-arm "read-fail")
(l07-error (file-copy-result "text" "fault-out") "READ_FAILED" "copy-read-failure")
(l07-arm "write-fail")
(l07-error (file-copy-result "text" "fault-out") "WRITE_FAILED" "copy-write-failure")
(l07-arm "close-fail")
(l07-error (file-copy-result "text" "fault-out") "CLOSE_FAILED" "copy-close-failure")
(l07-arm "write-fail")
(l07-error (file-append-result "fault-out" payload) "WRITE_FAILED" "append-write-failure")
(l07-arm "close-fail")
(l07-error (file-append-result "fault-out" payload) "CLOSE_FAILED" "append-close-failure")
(l07-arm "write-fail")
(l07-check (not (file-append "fault-out" payload)) "legacy-append-io-failure")
(l07-arm "write-fail")
(l07-check (not (_fl_file_copy "text" "fault-out")) "legacy-copy-io-failure")
(l07-check (= (l07-fd-count) initial-fds) "failure-paths-close-descriptors")
(l07-finish)
