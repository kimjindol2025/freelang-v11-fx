(define proof (atom ""))
(defn record [name ok]
  (swap! proof (fn [old] (str old name "=" (if ok "PASS" "FAIL") "\n"))))
(defn rejects [callback] (try (do (callback) false) (catch error true)))
(define root (browser-by-id "literal"))
(define paragraph (browser-create "p"))
(define second (browser-create "p"))
(record "J_DOM_CREATE" (and (= (= paragraph second) false) (= (browser-text paragraph) "")))
(browser-set-attribute! paragraph "id" "paragraph")
(browser-set-text! paragraph "<img src=x>")
(record "J_DOM_TEXT" (= (browser-text paragraph) "<img src=x>"))
(browser-append! root paragraph)
(browser-append! root second)
(record "J_DOM_APPEND" (and (= (length (browser-children root)) 2) (= (get (browser-children root) 0) paragraph)))
(define snapshot (browser-children root))
(browser-append! root paragraph)
(record "J_DOM_MOVE" (and (= (length (browser-children root)) 2) (= (get (browser-children root) 0) second)))
(browser-insert-before! root paragraph second)
(record "J_DOM_INSERT_BEFORE" (= (get (browser-children root) 0) paragraph))
(browser-append! root paragraph)
(record "J_DOM_CHILDREN_SNAPSHOT" (and (= (get snapshot 0) paragraph) (= (get (browser-children root) 0) second)))
(browser-remove! second)
(browser-remove! second)
(record "J_DOM_REMOVE" (= (length (browser-children root)) 1))
(define temporary (browser-create "div"))
(browser-append! temporary second)
(browser-clear! temporary)
(record "J_DOM_CLEAR" (= (length (browser-children temporary)) 0))
(browser-set-attribute! paragraph "title" "한😀<b>")
(record "J_DOM_ATTRIBUTE" (= (browser-attribute paragraph "title") "한😀<b>"))
(record "J_DOM_ATTRIBUTE_MISSING" (nil? (browser-attribute paragraph "class")))
(browser-set-hidden! paragraph true)
(define was-hidden (= (browser-attribute paragraph "hidden") ""))
(browser-set-hidden! paragraph false)
(record "J_DOM_HIDDEN" (and was-hidden (nil? (browser-attribute paragraph "hidden"))))
(define link (browser-create "a"))
(browser-set-attribute! link "href" "https://example.invalid/read")
(record "J_DOM_LINK" (= (browser-attribute link "href") "https://example.invalid/read"))
(define image (browser-create "img"))
(define figure (browser-create "figure"))
(browser-set-attribute! figure "id" "figure")
(browser-set-attribute! image "id" "photo")
(browser-set-attribute! image "alt" "한😀")
(browser-set-attribute! image "src" "/own.png")
(define image-url (browser-attribute image "src"))
(browser-append! figure image)
(browser-insert-before! root figure nil)
(record "J_DOM_IMAGE" (= (substring image-url (- (length image-url) 8)) "/own.png"))
(record "J_DOM_SCRIPT_REJECT" (rejects (fn [] (browser-create "script"))))
(record "J_DOM_IFRAME_REJECT" (rejects (fn [] (browser-create "iframe"))))
(record "J_DOM_UNKNOWN_ATTRIBUTE_REJECT" (rejects (fn [] (browser-set-attribute! paragraph "srcdoc" "blocked"))))
(record "J_DOM_EVENT_ATTRIBUTE_REJECT" (rejects (fn [] (browser-set-attribute! image "onerror" "blocked"))))
(record "J_DOM_STYLE_REJECT" (rejects (fn [] (browser-set-attribute! paragraph "style" "display:none"))))
(record "J_DOM_LINK_PROTOCOL_REJECT" (and (rejects (fn [] (browser-set-attribute! link "href" "javascript:"))) (= (browser-attribute link "href") "https://example.invalid/read")))
(record "J_DOM_IMAGE_DATA_REJECT" (and (rejects (fn [] (browser-set-attribute! image "src" "data:text/plain,blocked"))) (= (browser-attribute image "src") image-url)))
(record "J_DOM_IMAGE_ORIGIN_REJECT" (and (rejects (fn [] (browser-set-attribute! image "src" "https://example.invalid/no.png"))) (= (browser-attribute image "src") image-url)))
(record "J_DOM_CREATE_TYPE_REJECT" (rejects (fn [] (browser-create 1))))
(record "J_DOM_APPEND_TYPE_REJECT" (rejects (fn [] (browser-append! root "text"))))
(record "J_DOM_CYCLE_REJECT" (and (rejects (fn [] (browser-append! paragraph root))) (= (length (browser-children root)) 2)))
(record "J_DOM_BEFORE_PARENT_REJECT" (rejects (fn [] (browser-insert-before! root link second))))
(record "J_DOM_ATTRIBUTE_ARITY_REJECT" (rejects (fn [] (browser-attribute paragraph))))
(record "J_DOM_HIDDEN_TYPE_REJECT" (rejects (fn [] (browser-set-hidden! paragraph "false"))))
(record "J_DOM_IMAGE_TAG_REJECT" (rejects (fn [] (browser-set-attribute! paragraph "src" "/own.png"))))
(record "J_DOM_ATTRIBUTE_TYPE_REJECT" (rejects (fn [] (browser-set-attribute! paragraph "title" 1))))
(browser-set-text! (browser-by-id "proof") (deref proof))
