(define queued (atom 0))
(define one (atom 0))
(define two (atom 0))
(server_get "/" (fn [req] (server_html "<!doctype html><html lang='ko'><meta charset='utf-8'><title>FreeLang cancel 20</title><body><h1>FreeLang 비동기 취소</h1><pre id='proof'>WAIT</pre><script src='/program.js' defer></script></body></html>")))
(server_get "/program.js" (fn [req] (server_header (server_text (get (file-read-result "program.js") "data")) "Content-Type" "application/javascript; charset=utf-8")))
(server_get "/queued" (fn [req] (do (swap! queued (fn [n] (+ n 1))) (server_text "unexpected"))))
(server_get "/active-one" (fn [req] (do (swap! one (fn [n] (+ n 1))) (sleep 200) (server_text "late"))))
(server_get "/active-two" (fn [req] (do (swap! two (fn [n] (+ n 1))) (sleep 200) (server_text "late"))))
(server_get "/counts" (fn [req] (server_json {"queued" (deref queued) "one" (deref one) "two" (deref two)})))
(server_get "/ok" (fn [req] (server_text "hello")))
(server_get "/error" (fn [req] (server_status 500 "broken")))
(server_get "/slow" (fn [req] (do (sleep 200) (server_text "late"))))
(server_start 0)
