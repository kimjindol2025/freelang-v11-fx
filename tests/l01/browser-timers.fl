;; Fixed oracle before implementation. Publish proof only after all timers settle.
(define proof (atom ""))
(defn record [name ok]
  (swap! proof (fn [old] (str old name "=" (if ok "PASS" "FAIL") "\n"))))
(defn rejects [callback] (try (do (callback) false) (catch error true)))
(define calls (atom 0))
(define synchronous (atom true))
(define first (atom nil))
(define cancelled-calls (atom 0))
(define nested-calls (atom 0))
(define first-handle
  (browser-after! 0 (fn []
    (record "J_TIMER_ZERO_ASYNC" (= (deref synchronous) false))
    (swap! calls (fn [old] (+ old 1)))
    (record "J_TIMER_FIRED_CANCEL" (= (browser-cancel! (deref first)) false))
    (browser-after! 0 (fn [] (swap! nested-calls (fn [old] (+ old 1))))))))
(reset! first first-handle)
(define cancelled (browser-after! 0 (fn [] (swap! cancelled-calls (fn [old] (+ old 1))))))
(record "J_TIMER_DISTINCT_HANDLES" (= (= first-handle cancelled) false))
(record "J_TIMER_CANCEL" (= (browser-cancel! cancelled) true))
(record "J_TIMER_CANCEL_TWICE" (= (browser-cancel! cancelled) false))
(record "J_TIMER_DELAY_NEGATIVE" (rejects (fn [] (browser-after! -1 (fn [] nil)))))
(record "J_TIMER_DELAY_FRACTION" (rejects (fn [] (browser-after! 0.5 (fn [] nil)))))
(record "J_TIMER_DELAY_STRING" (rejects (fn [] (browser-after! "0" (fn [] nil)))))
(record "J_TIMER_DELAY_NIL" (rejects (fn [] (browser-after! nil (fn [] nil)))))
(record "J_TIMER_DELAY_OVERFLOW" (rejects (fn [] (browser-after! 2147483648 (fn [] nil)))))
(record "J_TIMER_CALLBACK_TYPE" (rejects (fn [] (browser-after! 0 "callback"))))
(record "J_TIMER_AFTER_ARITY" (and
  (rejects (fn [] (browser-after! 0)))
  (rejects (fn [] (browser-after! 0 (fn [] nil) nil)))))
(record "J_TIMER_CANCEL_ARITY" (and
  (rejects (fn [] (browser-cancel!)))
  (rejects (fn [] (browser-cancel! cancelled nil)))))
(record "J_TIMER_CANCEL_FORGED" (and
  (rejects (fn [] (browser-cancel! {})))
  (rejects (fn [] (browser-cancel! [])))
  (rejects (fn [] (browser-cancel! nil)))
  (rejects (fn [] (browser-cancel! 1)))))
(define upper-bound (browser-after! 2147483647 (fn [] nil)))
(record "J_TIMER_MAX_DELAY_CANCEL" (= (browser-cancel! upper-bound) true))
(define delayed-calls (atom 0))
(browser-after! 20 (fn [] (swap! delayed-calls (fn [old] (+ old 1)))))
(record "J_TIMER_NO_INLINE_CALLBACK" (and (= (deref calls) 0) (= (deref delayed-calls) 0)))
(reset! synchronous false)
(browser-after! 200 (fn []
  (record "J_TIMER_ONCE" (= (deref calls) 1))
  (record "J_TIMER_CANCELLED_NOT_CALLED" (= (deref cancelled-calls) 0))
  (record "J_TIMER_NESTED" (= (deref nested-calls) 1))
  (record "J_TIMER_DELAYED" (= (deref delayed-calls) 1))
  (browser-set-text! (browser-by-id "proof") (deref proof))))
