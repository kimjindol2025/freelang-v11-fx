(define proof (atom ""))
(defn record [name ok]
  (swap! proof (fn [old] (str old name "=" (if ok "PASS" "FAIL") "\n"))))
(defn rejects [callback] (try (do (callback) false) (catch error true)))
(define editor (browser-by-id "editor"))
(define literal (browser-by-id "literal"))
(define button (browser-by-id "commit"))
(define input-count (atom 0))
(define click-count (atom 0))
(record "J_HOST_MISSING" (nil? (browser-by-id "missing")))
(browser-set-value! editor "한😀<b>")
(record "J_HOST_VALUE_UNICODE" (= (browser-value editor) "한😀<b>"))
(browser-set-text! literal "<img src=x>")
(record "J_HOST_TEXT_LITERAL" (= (browser-text literal) "<img src=x>"))
(record "J_HOST_VALUE_TYPE_REJECT" (rejects (fn [] (browser-set-value! editor 1))))
(record "J_HOST_VALUE_ELEMENT_REJECT" (rejects (fn [] (browser-value literal))))
(record "J_HOST_VALUE_ARITY_REJECT" (rejects (fn [] (browser-value editor "extra"))))
(record "J_HOST_LISTENER_ELEMENT_REJECT" (rejects (fn [] (browser-on! nil "input" (fn [event] nil)))))
(record "J_HOST_LISTENER_NAME_REJECT" (rejects (fn [] (browser-on! editor "onclick" (fn [event] nil)))))
(record "J_HOST_LISTENER_CALLBACK_REJECT" (rejects (fn [] (browser-on! editor "input" 0))))
(record "J_HOST_LISTENER_ARITY_REJECT" (rejects (fn [] (browser-on! editor "input"))))
(record "J_HOST_OFF_TOKEN_REJECT" (rejects (fn [] (browser-off! []))))
(record "J_HOST_EVENT_TARGET_REJECT" (rejects (fn [] (browser-event-target {}))))
(record "J_HOST_EVENT_KEY_REJECT" (rejects (fn [] (browser-event-key nil))))
(record "J_HOST_EVENT_PREVENT_REJECT" (rejects (fn [] (browser-prevent-default! editor))))
(browser-on! editor "input" (fn [event]
  (do
    (swap! input-count (fn [count] (+ count 1)))
    (record "J_EVENT_INPUT_VALUE" (and (= (browser-value editor) "가😀<b>") (= (deref input-count) 1)))
    (record "J_EVENT_INPUT_TARGET" (and (= (browser-event-target event) editor) (nil? (browser-event-key event)))))))
(browser-set-value! editor "")
(record "J_HOST_SETTER_NO_INPUT" (= (deref input-count) 0))
(browser-on! editor "keydown" (fn [event]
  (if (= (browser-event-key event) "Enter")
    (do (record "J_EVENT_KEY" (= (browser-event-target event) editor))
        (browser-prevent-default! event)) nil)))
(define click-handler (fn [event] (swap! click-count (fn [count] (+ count 1)))))
(define first-token (browser-on! button "click" click-handler))
(define second-token (browser-on! button "click" click-handler))
(define phase (atom 0))
(browser-on! button "click" (fn [event]
  (if (= (deref phase) 0)
    (do
      (record "J_EVENT_PREVENT_DEFAULT" (= (browser-value editor) "가😀<b>"))
      (record "J_EVENT_DUPLICATE_CALLBACK" (= (deref click-count) 2))
      (browser-off! first-token)
      (browser-off! first-token)
      (browser-off! second-token)
      (reset! phase 1)
      (browser-set-text! (browser-by-id "ready") "CLICK_AGAIN"))
    (do
      (record "J_EVENT_OFF_IDEMPOTENT" (= (deref click-count) 2))
      (browser-set-text! (browser-by-id "proof") (deref proof))))))
(browser-set-text! (browser-by-id "ready") "READY")
