;; Proposed language API: not implemented or used by the product yet.
(define proof (atom ""))
(defn record [name ok]
  (swap! proof (fn [old] (str old name "=" (if ok "PASS" "FAIL") "\n"))))
(defn error-is? [callback expected]
  (try (do (callback) false) (catch error (= error expected))))
(record "STORAGE_MISSING" (nil? (browser-storage-read "b8-storage-key")))
(record "STORAGE_WRITE_RESULT" (nil? (browser-storage-write! "b8-storage-key" "first")))
(record "STORAGE_ROUND_TRIP" (= (browser-storage-read "b8-storage-key") "first"))
(browser-storage-write! "b8-storage-empty" "")
(record "STORAGE_EMPTY_VALUE" (= (browser-storage-read "b8-storage-empty") ""))
(browser-storage-write! "b8-storage-unicode" "한😀<b>")
(record "STORAGE_UNICODE" (= (browser-storage-read "b8-storage-unicode") "한😀<b>"))
(browser-storage-write! "b8-storage-key" "second")
(record "STORAGE_OVERWRITE" (= (browser-storage-read "b8-storage-key") "second"))
(record "STORAGE_REMOVE_RESULT" (nil? (browser-storage-remove! "b8-storage-key")))
(record "STORAGE_REMOVED" (nil? (browser-storage-read "b8-storage-key")))
(record "STORAGE_REMOVE_IDEMPOTENT" (nil? (browser-storage-remove! "b8-storage-key")))
(record "STORAGE_OTHER_KEY" (= (browser-storage-read "b8-storage-unicode") "한😀<b>"))
(record "STORAGE_READ_KEY_TYPE" (error-is? (fn [] (browser-storage-read nil)) "browser-storage: non-empty string key required"))
(record "STORAGE_WRITE_KEY_TYPE" (error-is? (fn [] (browser-storage-write! 1 "value")) "browser-storage: non-empty string key required"))
(record "STORAGE_REMOVE_KEY_TYPE" (error-is? (fn [] (browser-storage-remove! [])) "browser-storage: non-empty string key required"))
(record "STORAGE_EMPTY_KEY" (error-is? (fn [] (browser-storage-read "")) "browser-storage: non-empty string key required"))
(record "STORAGE_VALUE_TYPE" (error-is? (fn [] (browser-storage-write! "b8-storage-key" nil)) "browser-storage: string value required"))
(record "STORAGE_READ_ARITY" (error-is? (fn [] (browser-storage-read)) "browser-storage-read: one key required"))
(record "STORAGE_WRITE_ARITY" (error-is? (fn [] (browser-storage-write! "b8-storage-key")) "browser-storage-write!: key and value required"))
(record "STORAGE_REMOVE_ARITY" (error-is? (fn [] (browser-storage-remove! "b8-storage-key" "extra")) "browser-storage-remove!: one key required"))
(record "STORAGE_ACCESS_DENIED" (error-is? (fn [] (browser-storage-read "b8-storage-denied")) "browser-storage: access denied"))
(record "STORAGE_QUOTA_PRESERVES_OLD"
  (and (error-is? (fn [] (browser-storage-write! "b8-storage-quota" "new")) "browser-storage: quota exceeded")
       (= (browser-storage-read "b8-storage-quota") "old")))
(browser-storage-remove! "b8-storage-empty")
(browser-storage-remove! "b8-storage-unicode")
(browser-storage-remove! "b8-storage-quota")
(browser-set-text! (browser-by-id "proof") (deref proof))
