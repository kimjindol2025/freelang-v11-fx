(server_get "/" (fn [req]
  (server_html "<!doctype html><html lang='ko'><meta charset='utf-8'><title>FreeLang browser target</title><body><pre id='proof'>WAIT</pre><script src='/program.js' defer></script></body></html>")))
(server_get "/program.js" (fn [req]
  (let [result (file-read-result "program.js")]
    (if (get result "ok")
      (server_header (server_text (get result "data")) "Content-Type" "application/javascript; charset=utf-8")
      (server_status 500 "generated output unavailable")))))
(server_start 0)
