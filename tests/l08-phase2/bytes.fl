(define args (cli-args))
(define invalid (get (file-read-result (get args 0)) "data"))
(define surrogate (get (file-read-result (get args 1)) "data"))
(define nul (get (file-read-result (get args 2)) "data"))
(println (count invalid))
(println (= (str_slice invalid 0 1) "�"))
(println (= (get invalid 1) "X"))
(println (count surrogate))
(println (= (str_slice surrogate 0 3) "���"))
(println (count nul))
(println (str_find nul "B"))
(println (= (str_slice nul 1 2) (get nul 1)))
(println (get (file-write-result (get args 3) surrogate) "bytes"))
