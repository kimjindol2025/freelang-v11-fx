(println (append [1] [2 3]))
(println (append [1] 2 3))
(println (arr_flatten [[1] [[2]] 3]))
(println (arr_unique [1 1.0 {"a" 1} {"a" 1} [2] [2]]))
(define rows [{"n" 2 "id" "a"} {"n" 1 "id" "b"} {"n" 2 "id" "c"}])
(println (map (fn [r] (get r "id")) (arr_sort_by rows "n")))
(println (map (fn [r] (get r "id")) (arr_sort_by_desc rows "n")))
(println (map (fn [r] (get r "id")) rows))
(println (conj {"x" 1} ["y" 2]))
(println (obj-merge {"a" 1} {"b" 2} {"c" 3}))
(println (concat [1] [2]))
(println (concat "a" "b" "c"))
(println (take 2 [1 2 3]))
(println (drop 1 [1 2 3]))
