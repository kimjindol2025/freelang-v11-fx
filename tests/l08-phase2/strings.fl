(println (str_join ["가" "나"] ","))
(println (str_join "," ["가" "나"]))
(println (str_slice "한글😀끝" 2))
(println (str_slice "한글😀끝" -1))
(println (str_find "가😀나😀" "나"))
(println (str_find "abab" "b" 2))
(println (str_starts "한글" "한"))
(println (str_ends "한글" "글"))
(println (str_lines "a\r\nb\n"))
(println (str_split "a:b:c" ":" 2))
(println (str_replace "aaaa" "aa" "x"))
(println (str_replace "ab" "" "-"))
(println (str_encode_uri "한 글/😀?&"))
(println (str_decode_uri "%ED%95%9C%20%EA%B8%80%2F%F0%9F%98%80%3F%26"))
(println (try (str_decode_uri "%C0%AF") (catch e "URI_ERROR")))
(println (try (str_decode_uri "%GG") (catch e "URI_ERROR")))
