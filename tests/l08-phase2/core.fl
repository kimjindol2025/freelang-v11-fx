(println (or 0 99))
(println (str "[" (or "" "wrong") "]"))
(println (and 0 (throw "NO")))
(println (if "" "wrong" "empty"))
(define hits (atom 0))
(println (or true (do (swap! hits + 1) false)))
(println (deref hits))
(println (and false (do (swap! hits + 1) true)))
(println (deref hits))
(println (= {"x" [1 nil]} {"x" [1 nil]}))
(println (!= {"x" 1} {"x" 1}))
(define same {"x" 1})
(println (= same same))
(println (!= same same))
(println (< "10" "2"))
(println (< "10" 2))
(println (= 1 1.0))
(println (reduce + 0 [1 2 3]))
(println (loop [n 5000 total 0] (if (= n 0) total (recur (- n 1) (+ total n)))))
