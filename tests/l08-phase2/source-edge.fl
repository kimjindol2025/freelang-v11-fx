(println (type_of true))
(println (try (+ true 1) (catch e (error_message e))))
(println (/ 1 (+ -0)))
(println (str-replace-in "ab" "" "-"))
(println (str-replace-in "aba" "a" "<$&>"))
(println (str-replace-in "ab" "a" "$$:$`:$'"))
(println (str_replace "ab" nil "_"))
(println (str "[" (str_replace "a" "a" nil) "]"))
(println (str_split "a:b:c" ":" "2"))
(println (str_index_of "abc" nil))
(println (= {"a" nil} {"b" nil}))
(println (append "한😀" 1))
(println (substring "abc" 2 1))
(println (substring "abc" 1 0))
(println (substring "abc" -1 2))
(println (str_slice 123 1))
