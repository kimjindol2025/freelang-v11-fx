(println (try (+ "x" 1) (catch e e)))
(println (try (- nil) (catch e e)))
(println (% "5" 2))
(println (char_at "한글" "1"))
(println (str "[" (num_to_str nil) "]"))
(println (filter nil [0 "" 2]))
(println (filter (fn [x] x) [0 "" 2]))
(println (drop -1 [1 2 3]))
(println (range 2 5))
(println (range 5 0 -2))
(println (range 1 2 0.25))
(println (try (take [1] 2) (catch e e)))
