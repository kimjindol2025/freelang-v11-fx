(defn check [actual expected name]
  (if (= actual expected) (println (str name "=PASS")) (throw (str name "=FAIL"))))
(check (date_parse "1970-01-01T00:00:00Z") 0 "UTC_EPOCH_MS")
(check (date_parse "1970-01-01T09:00:00+09:00") 0 "KST_EPOCH_MS")
(check (format_date_utc 0 "YYYY-MM-DDTHH:mm:ss.SSSZ") "1970-01-01T00:00:00.000Z" "UTC_FORMAT")
(check (format_date_utc -1 "YYYY-MM-DDTHH:mm:ss.SSSZ") "1969-12-31T23:59:59.999Z" "NEGATIVE_MS")
(check (format_date_utc (date_parse "2000-02-29T12:34:56.789+09:00") "YYYY-MM-DDTHH:mm:ss.SSSZ")
       "2000-02-29T03:34:56.789Z" "LEAP_MILLISECONDS")
(check (format_date_utc (date_parse "2024-01-01T00:00:00+09:00") "YYYY-MM-DDTHH:mm:ssZ")
       "2023-12-31T15:00:00Z" "KST_DATE_BOUNDARY")
(check (format_date_utc (date_parse "2024-11-03T01:30:00-04:00") "YYYY-MM-DDTHH:mm:ssZ")
       "2024-11-03T05:30:00Z" "FOLD_EXPLICIT_EARLY")
(check (format_date_utc (date_parse "2024-11-03T01:30:00-05:00") "YYYY-MM-DDTHH:mm:ssZ")
       "2024-11-03T06:30:00Z" "FOLD_EXPLICIT_LATE")
(check (try (do (date_parse "2024-13-01T00:00:00Z") false) (catch [e] true)) true "INVALID_DATE")
