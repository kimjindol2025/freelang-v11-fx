(define values (repeat 2097152 "L"))
(if (= (count values) 2097152) nil (throw "repeat count"))
(if (= (get values 2097151) "L") nil (throw "repeat last"))
(define text (str_join values ""))
(if (= (count text) 2097152) nil (throw "repeat join length"))
(println "REPEAT_LARGE_PASS")
(if (= (count (repeat 0 "L")) 0) nil (throw "repeat zero"))
(if (= (count (repeat -1 "L")) 0) nil (throw "repeat negative"))
(if (= (repeat 3 7) [7 7 7]) nil (throw "repeat values"))
(println "REPEAT_BOUNDARIES_PASS")
