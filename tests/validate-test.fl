;; tests/validate-test.fl — L1.5 Validation Pass 검증
;; 실행: node bootstrap.js run tests/validate-test.fl  (cwd=fx 루트)
;; SPEC task-002.check: missing 형식 / cycle 경로형식 / 정상 :ok

(load "../src/validate.fl")

(defn assert-eq [label expected actual]
  (if (= expected actual)
    (do (println "  PASS " label) 1)
    (do (println "  FAIL " label " | EXP=[" expected "] GOT=[" actual "]") 0)))

(defn main []
  (println "=== validate-test (L1.5) ===")
  (let [
        ;; 정상 DAG: user-svc/auth-svc → user-repo(leaf)
        ok-reg (hash-map
                 "user-svc"  {:deps ["user-repo"]}
                 "user-repo" {:deps []}
                 "auth-svc"  {:deps ["user-repo"]})
        ;; 미정의 dep: auth-svc → token-svc (token-svc 미등록)
        miss-reg (hash-map
                   "auth-svc"  {:deps ["user-repo" "token-svc"]}
                   "user-repo" {:deps []})
        ;; 순환 2노드: auth → user → auth
        cyc2-reg (hash-map
                   "auth" {:deps ["user"]}
                   "user" {:deps ["auth"]})
        ;; 순환 3노드 + prefix: x → a → b → a  (prefix x 는 경로에서 제외돼야)
        cyc3-reg (hash-map
                   "x" {:deps ["a"]}
                   "a" {:deps ["b"]}
                   "b" {:deps ["a"]})
        ;; 자기 순환: s → s
        self-reg (hash-map "s" {:deps ["s"]})

        r-ok   (validate-graph ok-reg)
        r-miss (validate-graph miss-reg)
        r-cyc2 (validate-graph cyc2-reg)
        r-cyc3 (validate-graph cyc3-reg)
        r-self (validate-graph self-reg)

        results [
          (assert-eq "정상 DAG → ok=true" true (get r-ok :ok))
          (assert-eq "missing → ok=false" false (get r-miss :ok))
          (assert-eq "missing 형식 일치" "missing dependency: auth-svc -> token-svc" (get r-miss :error))
          (assert-eq "cycle2 → ok=false" false (get r-cyc2 :ok))
          (assert-eq "cycle2 경로 형식" "cycle: auth -> user -> auth" (get r-cyc2 :error))
          (assert-eq "cycle3 prefix 제외" "cycle: a -> b -> a" (get r-cyc3 :error))
          (assert-eq "self-cycle" "cycle: s -> s" (get r-self :error))
        ]
        total (reduce (fn [a x] (+ a x)) 0 results)
        n (count results)]
    (println "=== RESULT " total " / " n " PASS ===")
    (if (= total n) (println "ALL PASS") (println "SOME FAIL"))))

(main)
