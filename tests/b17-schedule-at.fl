(defn check [actual expected name]
  (if (= actual expected) (println (str name "=PASS")) (throw (str name "=FAIL"))))
(define state (atom []))
(define at (+ (now_ms) 80))
(define future (schedule_at at (fn []
  (do (check (>= (now_ms) at) true "AT_NOT_EARLY")
      (swap! state append "future") 42))))
(check (deref state) [] "AT_ASYNC")
(check (try (await_result future) (catch [e] (error_message e)))
       "Promise still pending - use proper async handling" "AT_PENDING")
(define past (schedule_at (- (now_ms) 1000) (fn [] (do (swap! state append "past") 7))))
(define failed (schedule_at (now_ms) (fn [] (throw "b17-scheduled-error"))))
(check (try (schedule_at "bad" (fn [] 0)) (catch [e] (error_message e)))
       "schedule_at: finite integer epoch milliseconds required" "AT_INVALID_TIMESTAMP")
(check (try (schedule_at 1.25 (fn [] 0)) (catch [e] (error_message e)))
       "schedule_at: finite integer epoch milliseconds required" "AT_INVALID_FRACTION")
(check (try (schedule_at (now_ms) 4) (catch [e] (error_message e)))
       "schedule_at: callback must be a function" "AT_INVALID_CALLBACK")
(check (try (schedule_at (now_ms)) (catch [e] (error_message e)))
       "schedule_at: requires timestamp and callback" "AT_INVALID_ARITY")
(set-timeout (fn []
  (do (check (deref state) ["past" "future"] "AT_ORDER_ONCE")
      (check (await_result future) 42 "AT_RESULT")
      (check (await_result past) 7 "AT_PAST_RESULT")
      (check (try (await_result failed) (catch [e] (error_message e)))
             "b17-scheduled-error" "AT_ERROR_VISIBLE"))) 250)
