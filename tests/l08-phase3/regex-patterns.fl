(load "check.fl")
(define cases [
 ["blog-1" "^[a-z0-9]+(-[a-z0-9]+)*$"]
 ["12345" "^[0-9]{1,5}$"]
 ["0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" "^[0-9a-f]{64}$"]
 ["2026-10-29T12:34:56Z" "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"]
 ["b" "^[a-z0-9][a-z0-9-]{0,63}$"]
 ["KO-kr" "^[a-z]{2}(-[a-z]{2})?$"]
 ["99" "^[0-9]{1,2}$"]
 ["a\t b" "\\s+"]
 ["<p>x</p>[[image:x]][[link:y]]" "<[^>]+>|\\[\\[(image|link):.*?\\]\\]"]
 [" \t#한글" "\\s+#"]
 ["#한글_Tag-1" "#[가-힣A-Za-z0-9_-]+"]
 ["<p>[[link:x]]" "<[^>]+>|\\[\\[link:.*?\\]\\]"]
 ["첫줄\n마지막" "(^|\\n)([^<>\\n]+)$"]
 ["끝\t " "\\s+$"]
 ["0123456789abcdef.jpeg" "^[0-9a-f]{16}([.][a-z0-9]{1,20})?$"]
 ["0123456789abcdef0123456789abcdef" "^[0-9a-f]{32}$"]
 ["HTTPS://example.com:443/a?q=1#x" "^https?://[a-z0-9][a-z0-9.-]*(:[0-9]{1,5})?([/?#][^\\s]*)?$"]
 ["123456" "^[1-9][0-9]{0,5}$"]
 ["https://example.com/a?q=1&x=2" "^https?://[a-z0-9][a-z0-9._~:/?#@!$&%()*+,;=+-]*$"]
 ["[[link:a]][[link:b]]" "\\[\\[link:.*?\\]\\]"]
 ["NOT SUPPORTED SELECT x" ".*(unsupported|not supported).*SELECT.*"]
 ["-123" "^-?[0-9]+$"]
 ["a.b" "\\."]
 ["SELECT 'a b' FROM t" "\\s+(?=(?:[^']*'[^']*')*[^']*$)"]
 ["a=b" "="]
 ["id,name" "^[A-Za-z_][A-Za-z0-9_]*(,[A-Za-z_][A-Za-z0-9_]*)*$"]
 ["a,b" ","]
 ["_table1" "^[A-Za-z_][A-Za-z0-9_]*$"]
 ["t(x)" "\\("]
 ["t(x)" "\\)"]
 ["REFERENCES t" "REFERENCES"]
 ["check(x)" "^CHECK"]
 ["unique(x)" "^UNIQUE"]
 ["varchar(255)" "^(VARCHAR\\([1-9][0-9]*\\)|TEXT|INT|INTEGER|BOOLEAN)$"]
])
(doseq [row cases] (println (check (regex_match_i (get row 0) (get row 1)) true)))
(doseq [keyword ["ADD" "ALTER" "AND" "AS" "BY" "COLLATE" "COLUMN" "COMMIT" "CONSTRAINT" "CREATE" "DATABASE" "DELETE" "DESC" "DROP" "EXISTS" "FALSE" "FOREIGN" "FROM" "GROUP" "IF" "INSERT" "INTO" "IS" "ISOLATION" "JOIN" "LEFT" "LEVEL" "LIMIT" "NOT" "NULL" "ON" "OR" "ORDER" "ROLLBACK" "SELECT" "SET" "START" "TABLE" "TRANSACTION" "TRUE" "UPDATE" "USE" "VALUES" "WHERE" ]]
 (println (check (regex_match_i keyword (str "^" keyword "$")) true)))
(doseq [code ["PARAMETER_COUNT_MISMATCH" "NOT_NULL_VIOLATION" "UNIQUE_VIOLATION" "FOREIGN_KEY_VIOLATION" "CHECK_VIOLATION" "TYPE_VIOLATION" "COLUMN_COUNT_MISMATCH" "PRIMARY_KEY_VIOLATION" "DATABASE_NOT_FOUND" "DATABASE_EXISTS" "DATABASE_NAMESPACE_CONFLICT" "TX_ALREADY_ACTIVE" "TX_NOT_ACTIVE" "SAVEPOINT_NOT_FOUND" "LOCK_TIMEOUT" "DEADLOCK_DETECTED" "PERMISSION_DENIED" "WAL_RECORD_TOO_LARGE" "WAL_CORRUPT" "COLLATION_NOT_SUPPORTED" "UNSUPPORTED_SQL" ]]
 (println (check (regex_match_i (str "error " code " details") (str ".*" code ".*")) true)))
