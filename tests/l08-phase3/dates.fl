(load "check.fl")
(println (check (date_parse "1970-01-01T00:00:01Z") 1000))
(println (check (date_parse "1970-01-01T09:00:01+09:00") 1000))
(println (check (date_parse "1969-12-31T19:00:01-0500") 1000))
(println (check (date_parse "1970-01-01T00:00:01.1239Z") 1123))
(println (check (date_parse "1969-12-31T23:59:59.999Z") -1))
(println (check (date_parse "1970-01-01") 0))
(println (check (- (date_parse "2000-03-01") (date_parse "2000-02-29")) 86400000))
(println (check (try (do (date_parse "bad") false) (catch e (error_message e))) "date_parse: invalid date string \"bad\""))
(println (check (try (do (date_parse "2024-13-01") false) (catch e true)) true))
(println (check (format_date 0 "YYYY YYYY") "1970 YYYY"))
(println (check (format_date (/ 0 0) "YYYY-MM-DD") "NaN-NaN-NaN"))
(define start (now_ms))
(define stop (now_ms))
(println (check (and (integer? start) (> start 1700000000000) (< start 5000000000000) (>= stop start) (< (- stop start) 10000)) true))
(define zero (get (file_read (str (get args 0) "/invalid")) 2))
(println (check (str_slice (format_date 0 (str "YYYY" zero "MM")) 5) "01"))
