(load "check.fl")
(define root (get args 0))
(define text-path (str root "/nested/deep/text"))
(println (check (file_write text-path "한😀\n") true))
(println (check (file_append text-path "끝") true))
(println (check (file_read text-path) "한😀\n끝"))
(println (check (file_size text-path) 11))
(println (check (file_is_file text-path) true))
(println (check (dir_create (str root "/made/sub")) true))
(println (check (dir_create (str root "/made/sub")) true))
(println (check (dir_list (str root "/made")) ["sub"]))
(println (check (file_copy text-path (str root "/copied/deep/text")) true))
(println (check (file_read (str root "/copied/deep/text")) "한😀\n끝"))
(println (check (file_delete text-path) true))
(println (check (file_delete text-path) false))
(println (check (file_exists text-path) false))
(println (check (file_is_file text-path) false))
(println (check (try (file_read text-path) (catch e true)) true))
(println (check (try (file_write (str root "/bad-number") 42) (catch e true)) true))
(println (check (count (file_read (str root "/allbytes"))) 256))
(println (check (file_write (str root "/decoded") (file_read (str root "/allbytes"))) true))
(println (check (file_size (str root "/decoded")) 512))
(println (check (count (file_read (str root "/invalid"))) 4))
(println (check (file_write "relative" "cwd-relative") true))
(println (check (file_read "relative") "cwd-relative"))
