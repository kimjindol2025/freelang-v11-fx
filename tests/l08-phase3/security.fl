(load "check.fl")
(define root (get args 0))
(define outside (get args 1))
(doseq [path [(str root "/../outside/sentinel") (str outside "/sentinel") (str root "/link-file") (str root "/link-dir/sentinel")]]
 (println (check (try (file_read path) (catch e true)) true))
 (println (check (try (file_write path "BAD") (catch e true)) true))
 (println (check (try (file_append path "BAD") (catch e true)) true))
 (println (check (try (file_delete path) (catch e true)) true))
 (println (check (try (file_copy path (str root "/unsafe-copy")) (catch e true)) true))
 (println (check (try (file_copy (str root "/allbytes") path) (catch e true)) true))
 (println (check (file_exists path) false))
 (println (check (file_is_file path) false)))
(println (check (try (dir_create (str root "/link-dir/created")) (catch e true)) true))
(println (check (try (dir_list (str root "/link-dir")) (catch e true)) true))
(println (check (try (file_read (str root "/unreadable")) (catch e true)) true))
(println (check (try (file_write (str root "/readonly") "BAD") (catch e true)) true))
(println (check (try (file_read (str root "/" (get (file_read (str root "/invalid")) 2))) (catch e true)) true))
