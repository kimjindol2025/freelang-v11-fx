(load "check.fl")
(define root (get args 0))
(define outside (get args 1))
(doseq [path [(str root "/../outside/sentinel") (str outside "/sentinel") (str root "/link-file") (str root "/link-dir/sentinel")]]
 (println (check (try (do (file_read path) false) (catch e true)) true))
 (println (check (try (do (file_write path "BAD") false) (catch e true)) true))
 (println (check (try (do (file_append path "BAD") false) (catch e true)) true))
 (println (check (try (do (file_delete path) false) (catch e true)) true))
 (println (check (try (do (file_copy path (str root "/unsafe-copy")) false) (catch e true)) true))
 (println (check (try (do (file_copy (str root "/allbytes") path) false) (catch e true)) true))
 (println (check (file_exists path) false))
 (println (check (file_is_file path) false)))
(println (check (try (do (dir_create (str root "/link-dir/created")) false) (catch e true)) true))
(println (check (try (do (dir_list (str root "/link-dir")) false) (catch e true)) true))
(println (check (try (do (file_read (str root "/unreadable")) false) (catch e true)) true))
(println (check (try (do (file_write (str root "/readonly") "BAD") false) (catch e true)) true))
(println (check (try (do (file_read (str root "/" (get (file_read (str root "/invalid")) 2))) false) (catch e true)) true))
