(load "check.fl")
(println (check (regex_find_all "[[link:a]][[link:b]]" "\\[\\[link:.*?\\]\\]") ["[[link:a]]" "[[link:b]]"]))
(println (check (regex_find_all "한 #한글 #abc 😀" "#[가-힣A-Za-z0-9_-]+") ["#한글" "#abc"]))
(println (check (regex_split "SELECT 'a b' FROM t" "\\s+(?=(?:[^']*'[^']*')*[^']*$)") ["SELECT" "'a b'" "FROM" "t"]))
(println (check (regex_split "a==b" "=") ["a" "" "b"]))
(println (check (regex_split "a,b" "(,)") ["a" "," "b"]))
(println (check (regex_replace "첫줄\n마지막" "(^|\\n)([^<>\\n]+)$" "$1<p>$2</p>") "첫줄\n<p>마지막</p>"))
(println (check (regex_replace "<p>x</p>[[image:a]][[link:b]]" "<[^>]+>|\\[\\[(image|link):.*?\\]\\]" " ") " x   "))
(println (check (regex_replace "a  b\t c" "\\s+" " ") "a b c"))
(println (check (regex_replace "ab" "" "-") "-a-b-"))
(println (check (regex_replace_first "aa" "a" "x") "xa"))
(println (check (regex_find_all "ab" "") ["" "" ""]))
(println (check (regex_find "none" "z") nil))
(println (check (regex_match_i "BLOG-1" "^[a-z0-9]+(-[a-z0-9]+)*$") true))
(println (check (regex_match "BLOG-1" "^[a-z0-9]+(-[a-z0-9]+)*$") false))
(println (check (regex_match_i "https://x/a b" "^https?://[a-z0-9][a-z0-9.-]*(:[0-9]{1,5})?([/?#][^\\s]*)?$") false))
(println (check (regex_match "x\n" "x$") true))
(println (check (map count (regex_find_all "😀" ".")) [1 1]))
(println (check (try (regex_match "a" "[") (catch e (str_starts e "regex_match: invalid pattern"))) true))
(println (check (regex_replace "abc" "(b)" "$$:$&:$1:$`:$'") "a$:b:b:a:cc"))
