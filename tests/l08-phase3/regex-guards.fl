(load "check.fl")
(doseq [pattern ["(" "[" "\\" "*" "a{3,1}"]]
 (println (check (try (do (regex_match "x" pattern) false) (catch e (str_starts (error_message e) "regex_match: invalid pattern"))) true)))
(println (check (try (do (regex_match "aa" "(a)\\1") false) (catch e (str_includes (error_message e) "backreference"))) true))
(println (check (try (do (regex_match "a" "(?<=a)") false) (catch e (str_includes (error_message e) "unsupported group"))) true))
;; Explicit native resource contract, not a claimed Date/RegExp host exception.
(println (check (try (do (regex_match "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaab" "(a+)+$") false) (catch e (str_includes (error_message e) "budget"))) true))
(println (check (regex_match_i "ς" "[Σ]") true))
(println (check (regex_match_i "ſ" "[a-z]") false))
(println (check (regex_match "한" "\\S") true))
