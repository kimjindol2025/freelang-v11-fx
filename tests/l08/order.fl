(define events (atom []))
(println (get (do (swap! events conj 1) {})
              (do (swap! events conj 2) "key")
              (do (swap! events conj 3) 9)))
(println (json-stringify (deref events)))
(println (try (get {"x" 1} "x" (throw "DEFAULT_THROW"))
              (catch e (error_message e))))
(define state (atom 4))
(println (try (swap! state (fn [old] (throw "CALLBACK_THROW")))
              (catch e (error_message e))))
(println (deref state))
(define hits (atom 0))
(println ((fn [] (swap! hits + 1) 99)))
(println (deref hits))
