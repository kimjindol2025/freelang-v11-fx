(println (get {} "missing" 7))
(println (get {"n" nil} "n" 7))
(println (get {"f" false} "f" 7))
(println (get {"z" 0} "z" 7))
(println (= (get {"s" ""} "s" 7) ""))
(println (get [nil false 0] 0 8))
(println (get [nil false 0] 1 8))
(println (get [nil false 0] 2 8))
(println (get [1] 2 8))
(println (get [1] "0" 8))
(println (get [1] -1 8))
(println (get "한글" 1 "missing"))
(println (get "a" 9 "missing"))
(println (get nil "x" 9))
(println (get nil "x"))
(println (has-key? {"x" nil} "x"))
(println (contains? {"x" nil} "x"))
(println (has-key? {} "x"))
(define hits (atom 0))
(println (get {"x" 3} "x" (do (swap! hits + 1) 4)))
(println (deref hits))
