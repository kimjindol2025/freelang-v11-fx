(define n (atom 1))
(swap! n + 2 4)
(println (deref n))
(println (get (map + [4 5]) 0))
(println ((fn [x] (let [f (fn [y] (+ x y))] (f 3))) 8))
(define state (atom {"n" 2}))
(println (try (swap! state update "n" (fn [old] (throw "UPDATE_THROW"))) (catch e e)))
(println (get (deref state) "n"))
(define pushed (atom []))
(swap! pushed push 9)
(println (get (deref pushed) 0))
