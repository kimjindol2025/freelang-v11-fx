(define state (atom []))
(swap! state conj 1)
(println (get (deref state) 0))
(define metrics (atom {"errors" 1}))
(swap! metrics update "errors" (fn [x] (+ x 1)))
(println (get (deref metrics) "errors"))
(swap! metrics assoc "ok" 7)
(println (get (deref metrics) "ok"))
(swap! metrics dissoc "ok")
(println (get (deref metrics) "ok" 9))
(define n (atom 1))
(swap! n (fn [old extra] (+ old extra)) 4)
(println (deref n))
(define add +)
(println (add 2 3))
(define lookup get)
(println (lookup {} "x" 17))
(println (reduce + 0 [1 2 3]))
