(defn server-start [name] (str "db:" name))
(define protocol (server-start "x"))
(defn photo-menu [req] (server_text "named-old"))
(define saved photo-menu)
(server_get "/named" "photo-menu")
(defn photo-menu [req] (server_text "named-new"))
(defn photo_menu [req] (server_text "underscore"))
(server_get "/saved" saved)
(server_post "/post" "photo-menu")
(server_get "/underscore" "photo_menu")
(define alias (fn [req] (server_text "defined")))
(server_get "/alias" "alias")
(server_get "/late" "late")
(defn late [req] (server_text "late"))
(server_get "/protocol" (fn [req] (server_text protocol)))
(server_start 0)
