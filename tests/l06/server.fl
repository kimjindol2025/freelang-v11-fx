(defn file-info [f]
  (let [r (file-read-result (get f "path"))
        data (get r "data")]
    {"fieldname" (get f "fieldname") "originalname" (get f "originalname")
     "filename" (get f "filename") "mimetype" (get f "mimetype")
     "safe" (l06_meta f) "size" (get f "size") "bytes" (get r "bytes") "ok" (get r "ok")
     "pattern" (l06_pattern data) "sha256" (sha256 data) "independent" (= (sha256 data) (l06_digest data))}))
(defn upload [req]
  (let [seen (l06_seen)
        files (server_req_files req)
        result (map file-info files)
        path (server_req_path req)]
    (do
      (if (= path "/throw") (throw "L06_TEST_EXCEPTION") nil)
      (if (= path "/hold") (l06_hold) nil)
      (if (= path "/copy")
        (file-copy-result (get (first files) "path") "permanent") nil)
      (if (= path "/delete")
        (_fl_file_delete (get (first files) "path")) nil)
      (if (= path "/forbid") (server_status 403 "DENIED")
        (server_json {"body" (get req "body") "body_api" (server_req_body req)
                      "aliases" (and (= (json-stringify (server-req-body req)) (json-stringify (server_req_body req)))
                                      (= (json-stringify (server-req-fields req)) (json-stringify (server_req_fields req)))
                                      (= (json-stringify (server-req-files req)) (json-stringify (server_req_files req))))
                      "fields" (server_req_fields req)
                      "files" result "seen" seen})))))
(server_post "/upload" upload)
(server_post "/throw" upload)
(server_post "/copy" upload)
(server_post "/delete" upload)
(server_post "/forbid" upload)
(server_post "/hold" upload)
(server_get "/count" (fn [req] (server_text (str (l06_count)))))
(server_get "/health" (fn [req] (server_text "OK")))
(if (= (get (cli-args) 0) "tls")
  (server_start_tls 0 (get (cli-args) 1) (get (cli-args) 2))
  (server_start 0))
