(define sample (buf-to-binary "AP+AQUI="))
(define roundtrip (buf-from-binary sample))
(define nul-buffer "QQBC")
(define empty-buffer (buf-concat []))
(define out-of-range (try (buf-slice (buf-str "A") 0 2) (catch error "RANGE_ERROR")))
(define joined (buf-concat [(buf-u8 65) (buf-u8 0) (buf-u8 66)]))

(if (and (= (buf-len roundtrip) 5)
         (= (buf-read-u8 "AP+AQUI=" 0) 0)
         (= roundtrip "AP+AQUI=")
         (= (buf-len nul-buffer) 3)
         (= (buf-read-u8 nul-buffer 1) 0)
         (= (buf-read-str joined 0 1) "A")
         (= (buf-read-u8 joined 1) 0)
         (= (buf-read-str joined 2 1) "B")
         (= (buf-len empty-buffer) 0)
         (= (buf-from-binary empty-buffer) "")
         (= out-of-range "RANGE_ERROR"))
  (println "BUFFER_RUNTIME_PASS")
  (throw "BUFFER_RUNTIME_FAIL"))
